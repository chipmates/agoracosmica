---
// Night-reskin layout variant: identical to Public.astro except the three
// public stylesheets are replaced by the night reskin (one stylesheet, all
// rules consume the app token layer). Landing pages only while the reskin
// rolls out surface by surface; other pages keep Public.astro.

import BaseHead from '../components/BaseHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PublicScript from '../components/PublicScript.astro';
import AdConsentPrompt from '../islands/AdConsentPrompt';
import { getT } from '../i18n';
import type { Lang } from '../i18n';

import '@client/index.css';
import '../styles/night-reskin.css';

interface Props {
  title: string;
  fullTitle?: string;
  /** og:title + twitter:title only; <title> keeps `fullTitle`. */
  ogTitle?: string;
  description: string;
  canonicalPath: string;
  lang: Lang;
  ogType?: 'website' | 'article' | 'profile';
  ogImage?: string;
  ogImageAlt?: string;
  preloadImage?: string;
  preloadImageSrcset?: string;
  preloadImageSizes?: string;
  preloadImageType?: string;
  schemas?: Array<Record<string, unknown>>;
  noHreflang?: boolean;
  /** Cross-slug hreflang alternates (lang-prefixed paths), for pages whose
   *  EN/DE slugs differ (the category hubs). Forwarded to BaseHead. */
  altEn?: string;
  altDe?: string;
  /** Internal lab/preview pages: emit robots noindex. */
  noindex?: boolean;
  /** Set false on pages that render their own dedicated CTA (figure + theme detail). */
  stickyCta?: boolean;
  /** Pages with a full hero (like the homepage): the mobile sticky CTA starts
   *  hidden and slides in on first scroll, instead of showing from first paint. */
  heroReveal?: boolean;
}

const props = Astro.props;
const currentPath = Astro.url.pathname;
const t = getT(props.lang);
const isHome = currentPath === '/' || currentPath === '/de/' || currentPath === '/de';
const revealSticky = isHome || props.heroReveal === true;
---
<!doctype html>
<html lang={props.lang}>
  <head>
    <BaseHead {...props} />
  </head>
  <body class={revealSticky ? 'pub-home-page' : undefined}>
    <a href="#main-content" class="pub-skip-link">
      {props.lang === 'de' ? 'Zum Inhalt springen' : 'Skip to content'}
    </a>
    <div class="public-page">
      <Navbar lang={props.lang} currentPath={currentPath} />
      <main class="pub-main" id="main-content">
        <slot />
      </main>
      <Footer lang={props.lang} />
    </div>
    <!-- Mobile-only sticky CTA, same contract as Public.astro. -->
    {props.stickyCta !== false && (
      <div class="pub-cta pub-cta--sticky">
        <div class="pub-cta__inner">
          <a href="/app" class="pub-cta__button" data-agc-cta="start-exploring">{t('nav.startExploring')}</a>
        </div>
      </div>
    )}
    <PublicScript />
    <AdConsentPrompt client:idle lang={props.lang} />
  </body>
</html>

<style is:global>
  /* Keyboard skip link: visually hidden until it receives keyboard focus,
     then slides in above the sticky navbar (navbar z-index is 100). */
  .pub-skip-link {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 200;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.75rem 1.25rem;
    background: var(--bg-card);
    color: var(--gold-primary);
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
    text-decoration: underline;
    transform: translateY(-150%);
  }
  .pub-skip-link:focus-visible {
    transform: translateY(0);
  }
</style>
