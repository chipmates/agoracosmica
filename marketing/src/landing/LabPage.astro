---
// The lab's page shell: the site's chrome in the figure page's system, the player's router and dock (so a story
// keeps playing across a soft page change), noindex. A concept's layout goes in the default slot.
import Public from '../layouts/Public.astro';
import PlayerHead from '../components/player/PlayerHead.astro';
import PlayerDock from '../components/player/PlayerDock.astro';
import { landingWords } from './words';
import type { LandingLang } from './thirty';

interface Props {
  lang: LandingLang;
  /** The page's path without the language prefix, e.g. /landing-lab/c1 */
  path: string;
  title?: string;
  /** The redesign's chrome: the landing's tagline in the bar and the footer, no Echoes link. */
  newChrome?: boolean;
}

const { lang, path, title, newChrome = false } = Astro.props;
const W = landingWords(lang);
const name = title ? `${title} · ${W.lab.title}` : W.lab.title;
// The landing's head and the note behind its "i" (the stage's and the bar's) come from its own words.
const words = { en: landingWords('en'), de: landingWords('de') };
const dockLabel = newChrome ? { en: { expanded: words.en.note }, de: { expanded: words.de.note } } : undefined;
---
<Public
  title={newChrome ? W.pageTitle : name}
  fullTitle={newChrome ? W.pageTitle : `${name} · Agora Cosmica`}
  description={newChrome ? W.description : W.lab.note}
  canonicalPath={path}
  lang={lang}
  noindex
  stickyCta={false}
  storyPage
  tagline={newChrome ? W.tagline : undefined}
  echoesLink={!newChrome}
>
  <PlayerHead slot="head" figurePage />
  <div class="story-page landing-lab">
    <slot />
  </div>
  <PlayerDock slot="dock" lang={lang} label={dockLabel} />
</Public>
