---
// The stage: one figure's painted portrait in a card with its name block and one line, the label (the writing, the
// pictures and the voice; the portrait's own alt names it an AI image, no chip on the painting), and the figure page's
// own plate on that figure's queue (the introduction, then story 1). Complete in markup; stage.ts swaps any of the
// thirty in place. One stage per page: the plate reads the first queue script.
import { VOICE_DESC_ID, labelHalves, playerStrings } from '../player/strings';
import { landingWords } from './words';
import { DEFAULT_FIGURE, LONG_NAME, MAIN_SIZES, scriptJson, stageFigure, stagePayload } from './thirty';
import type { LandingLang } from './thirty';
import './landing.css';

interface Props {
  lang: LandingLang;
  /** The figure the markup ships with (the one a page without script shows). */
  figure?: string;
  /** 'overlay': name block on the picture's foot; 'below': under it. */
  variant?: 'overlay' | 'below';
  /** The name's heading level; the page's h1 is usually the tagline. */
  level?: 2 | 3;
  /** The picture's rendered width, for the browser's pick from the srcset. */
  sizes?: string;
  /** The moment on arrival (stage.ts); off leaves the painting as it loads. */
  moment?: boolean;
  /** A swap writes `?figure=<slug>` on this page ('query') or the figure page's address ('path'). */
  address?: 'query' | 'path';
  /** After a swap, focus stays where it was ('keep') or moves to the new name ('name'). */
  focus?: 'keep' | 'name';
  /** The quiet links under the plate: read instead, all the figure's stories. */
  links?: boolean;
  class?: string;
}

const {
  lang,
  figure: firstId = DEFAULT_FIGURE,
  variant = 'overlay',
  level = 2,
  sizes = '(min-width: 1024px) 460px, calc(100vw - 32px)',
  moment = true,
  address = 'query',
  focus = 'keep',
  links = true,
  class: cls,
} = Astro.props;

const W = landingWords(lang);
const P = playerStrings(lang);
const halves = labelHalves(W.label);
const f = stageFigure(firstId, lang);
const intro = f.queue.entries.find(e => e.n === 0);
const first = f.queue.entries[0];
const storyCount = f.queue.entries.filter(e => e.n > 0).length;
const whatText = intro?.minutes ? P.beginSub(intro.minutes) : [first?.title, first?.minutes ? P.minutes(first.minutes) : ''].filter(Boolean).join(' · ');
const payload = stagePayload(lang, firstId);
const Name = level === 3 ? 'h3' : 'h2';
// Templates the script fills per figure; the words stay in words/<lang>.ts.
const templates = {
  now: W.nowShowing('{name}'),
  title: W.stageTitle('{name}'),
  all: W.allStories(0).replace('0', '{n}'),
};
---
<section
  class:list={['ls-stage', `ls-stage--${variant}`, cls]}
  aria-labelledby="ls-name"
  data-landing-stage
  data-figure={f.id}
  data-address={address}
  data-focus={focus}
  data-moment={moment ? 'arrival' : 'off'}
  data-templates={JSON.stringify(templates)}
>
  <script is:inline type="application/json" data-story-queue set:html={scriptJson(f.queue)} />
  <script is:inline type="application/json" data-landing-thirty set:html={scriptJson(payload)} />
  <figure class="ls-card">
    <div class="ls-card__mat">
      <img
        class="ls-card__img"
        data-stage-img
        data-moment-hold={moment ? '' : undefined}
        src={f.main.src}
        srcset={f.main.srcset}
        sizes={sizes}
        alt={f.alt}
        width={MAIN_SIZES[1]}
        height="1089"
        crossorigin="anonymous"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    {/* the label is the next thing after the painting in the page's order: the note stands against the picture it
        explains, never on it */}
    <details class="story-label sp-label ls-label">
      <summary>
        <span class="sp-label__i" aria-hidden="true">i</span>
        {/* each half's dot stands before it and is clipped where the half starts a line (landing.css), so a dot never
            ends a line; the dots are for the eye, a hidden comma parts the items for a screen reader */}
        <span class="sp-label__brief ls-label__brief">{halves.map((half, i) => (
          <span class="sp-label__half ls-label__half"><span class="ls-label__dot" aria-hidden="true">·</span>{half.replace(/\u00a0·$/, '')}{i < halves.length - 1 && <span class="sp-sr">,</span>}</span>
        ))}</span>
      </summary>
      <p>{W.note}</p>
    </details>
    <figcaption class="ls-card__names">
      <Name class="ls-name" id="ls-name" tabindex="-1" data-stage-name data-long={f.name.length > LONG_NAME ? '' : undefined}>{f.name}</Name>
      <p class="ls-meta" data-stage-meta>{f.meta}</p>
      <p class="ls-line" data-stage-line>{f.line}</p>
    </figcaption>
  </figure>

  <div class="sp-plate-wrap ls-plate-wrap">
    <button
      type="button"
      class="sp-plate story-play story-play--hero ls-plate"
      data-story-play
      data-story-n={first?.n ?? 0}
      data-story-hero-plate
      data-door="home_plate"
      data-state="idle"
      aria-pressed="false"
      aria-describedby={VOICE_DESC_ID}
    >
      <span class="sp-disc" aria-hidden="true" data-stage-disc>
        <svg class="sp-ring" viewBox="0 0 64 64" focusable="false">
          <circle class="sp-ring__track" cx="32" cy="32" r="30.5" />
          <circle class="sp-ring__run" cx="32" cy="32" r="30.5" pathLength="100" data-story-ring />
          <circle class="sp-ring__wait" cx="32" cy="32" r="30.5" pathLength="100" />
        </svg>
        <span class="sp-disc__core">
          <svg class="story-play__icon story-play__icon--play" viewBox="0 0 24 24" focusable="false"><path d="M8.2 5.3v13.4c0 .5.5.8.9.5l10.3-6.7a.6.6 0 0 0 0-1L9.1 4.8c-.4-.3-.9 0-.9.5z" /></svg>
          <svg class="story-play__icon story-play__icon--pause" viewBox="0 0 24 24" focusable="false"><rect x="6.6" y="5" width="3.8" height="14" rx="1" /><rect x="13.6" y="5" width="3.8" height="14" rx="1" /></svg>
        </span>
      </span>
      <span class="sp-plate__text">
        <span class="sp-plate__do" data-wait={P.loading}><span class="sp-plate__now" data-story-hero-do>{P.begin}</span></span>{' '}
        <span class="sp-plate__what" data-story-hero-what>{whatText}</span>
      </span>
    </button>
    <p class="sp-startover" data-story-startover hidden>
      <button type="button" class="sp-textlink" data-story-play data-story-n={first?.n ?? 0} data-story-from="0" data-door="home_start_over" aria-describedby={VOICE_DESC_ID}>{P.startOver}</button>
    </p>
  </div>

  {links && (
    <p class="sp-hero__links ls-links">
      <button type="button" class="sp-textlink" data-story-read={first?.n ?? 0} data-door="home_read">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 6.6C9.7 5 6.6 4.7 3.5 5.6v12.8c3.1-.9 6.2-.6 8.5 1M12 6.6c2.3-1.6 5.4-1.9 8.5-1v12.8c-3.1-.9-6.2-.6-8.5 1M12 6.6v12.8" /></svg>
        <span>{P.readInstead}</span>
      </button>
      <a class="sp-textlink" href={f.href} data-stage-all data-door="home_all">{W.allStories(storyCount)}</a>
    </p>
  )}
  <p class="sp-sr" aria-live="polite" data-stage-live></p>
</section>

<script>
  import { installStage } from './stage';
  installStage();
</script>
