---
// Concept 2, the full face: on a phone the painting fills the first screen, the tagline, the name block, the label and
// the plate sit on its dark foot, the thirty run under it; on a desktop the painting stands whole in a framed plate
// beside the words. The stage is the base's (moment off: c2.ts runs it, so the tagline over the painting stays as clear
// as the name). Below: the words, then the era descent with the thirty's portraits.
import Stage from '../../Stage.astro';
import FigureDescent from '../../../components/FigureDescent.astro';
import { landingWords } from '../../words';
import { portraitAlt } from '../../../lib/portraitCredit';
import { figureListUrl } from '../../../lib/urls';
import { getT } from '../../../i18n';
import { getFiguresCatalog } from '@client/data/public/figuresCatalog';
import { byEra, DEFAULT_FIGURE, figure, THIRTY, thumbSrcset, thumbUrl } from '../../thirty';
import type { LandingLang } from '../../thirty';
import './c2.css';

interface Props {
  lang: LandingLang;
}

const { lang } = Astro.props;
const W = landingWords(lang);
const eras = byEra();
// The rail's label: a one-word name as it is (the catalog's short German "Plato" is "Platon"), else the catalog's
// short name, cut to its first word where it is still long ("Hildegard").
const railName = (f: (typeof eras)[number]['figures'][number]): string => {
  const full = f.name[lang];
  const short = f.short[lang];
  if (!full.includes(' ')) return full;
  return short.length > 12 ? short.split(' ')[0] ?? short : short;
};
// The sentence under the tagline breaks only after a comma, never inside a phrase ("in / der").
const leadParts = W.lead.split(/(?<=,)\s+/);
// The arrows' names for the figure the markup ships with; c2's script renames them after each turn.
const at = THIRTY.findIndex(f => f.id === DEFAULT_FIGURE);
const nextName = THIRTY[(at + 1) % THIRTY.length]?.name[lang] ?? '';
const prevName = THIRTY[(at - 1 + THIRTY.length) % THIRTY.length]?.name[lang] ?? '';
// The descent's anchor: the old figure list's addresses forward here (_redirects).
const listId = lang === 'de' ? 'alle' : 'all';
// A desktop's single row of faces, as the earlier front drew it: its nineteen per language, ranked by search demand;
// the row drops the lowest ranks where the width runs out (c2.css) and keeps the catalog's order on screen.
const ROW_RANK: Record<LandingLang, string[]> = {
  en: ['aurelius', 'jung', 'kahlo', 'nietzsche', 'gautama', 'dickinson', 'rumi', 'laozi', 'einstein', 'lovelace',
    'shakespeare', 'vinci', 'angelou', 'tubman', 'king', 'campbell', 'schopenhauer', 'woolf', 'plato'],
  de: ['aurelius', 'jung', 'nietzsche', 'goethe', 'eckhart', 'bingen', 'schopenhauer', 'kahlo', 'einstein', 'gautama',
    'laozi', 'rumi', 'dickinson', 'mozart', 'beauvoir', 'shakespeare', 'vinci', 'campbell', 'king'],
};
const row = getFiguresCatalog(lang)
  .map(c => c.id)
  .filter(id => ROW_RANK[lang].includes(id))
  .map(id => ({ f: figure(id), rank: ROW_RANK[lang].indexOf(id) }));
const t = getT(lang);
---
<div class="c2">
  <section class="c2-hero" data-c2-hero aria-labelledby="c2-h1">
    <div class="c2-hero__in">
      <h1 class="c2-h1" id="c2-h1" data-c2-keep>{W.tagline}</h1>
      <p class="c2-lead" data-c2-keep>{leadParts.map((part, i) => (
        <Fragment>{i > 0 ? ' ' : ''}<span class="c2-lead__part">{part}</span></Fragment>
      ))}</p>
      <p class="c2-intro">{W.intro}</p>
      {/* a 3x phone takes the 900 px painting, as a 2x one does: sharp at full bleed, about 100 KB less */}
      <Stage
        lang={lang}
        variant="below"
        moment={false}
        sizes="(min-width: 1024px) 440px, (min-resolution: 2.5dppx) 300px, 100vw"
        class="c2-stage"
      />
      <div class="c2-turn" data-c2-turn data-next={W.turnNext('{name}')} data-prev={W.turnPrevious('{name}')} hidden>
        <button type="button" class="c2-turn__btn c2-turn__btn--prev" data-c2-dir="prev" aria-label={W.turnPrevious(prevName)}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14.5 5.5 8 12l6.5 6.5" /></svg>
        </button>
        <button type="button" class="c2-turn__btn c2-turn__btn--next" data-c2-dir="next" aria-label={W.turnNext(nextName)}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9.5 5.5 16 12l-6.5 6.5" /></svg>
        </button>
      </div>
      <nav class="c2-rail" aria-label={W.rowLabel}>
        <p class="c2-rail__lead" aria-hidden="true">{W.choose}</p>
        <div class="c2-rail__scroll" data-c2-rail>
          <ol class="c2-rail__eras">
            {eras.map(({ era, figures }) => (
              <li class="c2-rail__era">
                <span class="c2-rail__eraname" aria-hidden="true">{era.short[lang]}</span>
                <ol class="c2-rail__list" aria-label={era.name[lang]}>
                  {figures.map(f => (
                    <li>
                      <a
                        class="c2-pick"
                        href={f.href[lang]}
                        data-landing-pick={f.id}
                        data-c2-from="rail"
                        aria-current={f.id === DEFAULT_FIGURE ? 'true' : undefined}
                      >
                        {/* the link's name is the portrait's alt ("Name, KI-Bild"); the short name under it is seen */}
                        <img
                          src={thumbUrl(f.id, 160)}
                          srcset={thumbSrcset(f.id)}
                          sizes="64px"
                          alt={portraitAlt(f.name[lang], lang)}
                          width="64"
                          height="64"
                          loading="lazy"
                          decoding="async"
                        />
                        <span class="c2-pick__name" aria-hidden="true">{railName(f)}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </li>
            ))}
          </ol>
          {/* a desktop: one row of faces and the way to all thirty at its end (the era row above is the phone's) */}
          <div class="c2-row">
            <ol class="c2-row__faces">
              {row.map(({ f, rank }) => (
                <li data-rank={rank}>
                  <a
                    class="c2-pick"
                    href={f.href[lang]}
                    title={f.name[lang]}
                    data-landing-pick={f.id}
                    data-c2-from="row"
                    aria-current={f.id === DEFAULT_FIGURE ? 'true' : undefined}
                  >
                    <img
                      src={thumbUrl(f.id, 160)}
                      srcset={thumbSrcset(f.id)}
                      sizes="48px"
                      alt={portraitAlt(f.name[lang], lang)}
                      width="48"
                      height="48"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                </li>
              ))}
            </ol>
            <a class="c2-row__all" href={figureListUrl(lang)}>{t('nav.allFigures')}</a>
          </div>
        </div>
      </nav>
    </div>
  </section>

  <FigureDescent lang={lang} anchor={listId} />
</div>

<script>
  import { installC2 } from './c2';
  import { installDescent } from '../../../components/figureDescent';
  installC2();
  installDescent();
</script>
