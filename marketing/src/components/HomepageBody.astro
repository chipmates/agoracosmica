---
// Below-the-hero homepage content for the production homepages (/ and /de/).
// The cinematic hero owns the single <h1>; this is the crawlable, SEO-bearing
// body it hands off to: What is, Six ways + volume band, figures grid + theme
// question-wall, Cosmic Council, the honest band, FAQ, and the education +
// footer-links section.
//
// It renders NO <h1> (the page that imports it owns the single hero <h1>) and
// NO hero block. Every heading here is h2/h3, matching the original pages.
//
// The page passes in the data it already computes for its JSON-LD (figures,
// faq, heroCouncil) so nothing is recomputed and the two renderers cannot
// drift. The only interactive island below the hero is the CouncilHero's
// audio button (client:visible), unchanged from the original pages.

import FigureCard from './FigureCard.astro';
import CouncilHero from './CouncilHero.astro';
import LibraryShowcase from './LibraryShowcase.astro';
import LabQuestionTile from './landing-lab/LabQuestionTile.astro';
import LabTrustCard from './landing-lab/LabTrustCard.astro';
import { getT } from '../i18n';
import type { Lang } from '../i18n';
import { publicUrl } from '../lib/urls';
import type { PublicFigure } from '@client/data/public/figuresCatalog';
import type { CatalogCouncil } from '@client/data/councilCatalog';

interface Props {
  lang: Lang;
  figures: PublicFigure[];
  faq: {
    q: string;
    a: string;
    // Optional nested unfold (Tier 2 of the Echo disclosure): a second
    // details element inside the answer, ending in a link to the full
    // essay. The JSON-LD faqSchema only reads q + a, so the unfold stays
    // out of the structured data by design.
    more?: { toggle: string; paras: string[]; cta: { label: string; href: string } };
  }[];
  heroCouncil: CatalogCouncil;
}

const { lang, figures, faq, heroCouncil } = Astro.props;
const t = getT(lang);
const isDe = lang === 'de';

// Wayfinding links that used to sit in their own orphan "Ways in" row. They now
// ride in the closing link row, where the reader already is when they are done.
const philoHubHref = isDe ? '/de/philosophie-lernen/' : '/ai-philosophy-tutor/';
const wisdomHubHref = isDe ? '/de/figures/' : '/figures/';
const ossHref = publicUrl(lang, '/open-source-philosophy-app');
const waysInPhilo = isDe ? 'Philosophie lernen' : 'Learn philosophy';
const waysInWisdom = isDe ? 'Weisheit aus der Geschichte lernen' : 'Learn wisdom from history';
const waysInOss = isDe ? 'Die Open-Source-Geschichte' : 'The open-source story';

const repoHref = 'https://github.com/chipmates/agoracosmica';
const privacyHref = isDe ? '/datenschutz/' : '/privacy/';
const echoesHref = publicUrl(lang, '/echoes');

// The featured debate's real runtime, read off its produced audio manifest
// (level 1: 12:56 in English, 14:23 in German). Stated next to the 50-second
// preview so the preview never reads as the whole thing.
const councilRuntime = isDe
  ? 'Hör 50 Sekunden · die ganze Debatte läuft 14 Minuten'
  : 'Hear 50 seconds · the whole debate runs 13 minutes';
const councilPlayLabel = isDe ? 'Diese Debatte anhören' : 'Play this debate';

// ── EN body card data ───────────────────────────────────────────────────
// The eight question tiles (each links to its theme page). The theme name
// rides along as the tile's small-caps label, so the link carries the theme
// wording without stuffing it into the question sentence.
const enQuestions = [
  { themeId: 'who-am-i', question: 'Who Am I?' },
  { themeId: 'love-connection', question: 'What binds us to each other?' },
  { themeId: 'meaning-purpose', question: 'What makes a life worth living?' },
  { themeId: 'mind-creativity', question: 'Where do ideas come from?' },
  { themeId: 'moral-life', question: 'How should we live?' },
  { themeId: 'freedom-justice', question: 'What does it mean to be free?' },
  { themeId: 'faith-death-mystery', question: 'What lies beyond what we know?' },
  { themeId: 'loss-grief', question: "How do we carry what we've lost?" },
];

// ── DE body card data (same verbatim discipline as EN) ──────────────────
// The German tiles used to carry the theme name inside the question, which
// wrapped to two lines on every tile. The theme name is now the label.
const deQuestions = [
  { themeId: 'who-am-i', question: 'Wer bin ich? Die Frage unter jeder Frage.' },
  { themeId: 'love-connection', question: 'Was verbindet uns miteinander?' },
  { themeId: 'meaning-purpose', question: 'Was macht das Leben lebenswert?' },
  { themeId: 'mind-creativity', question: 'Woher kommen Ideen?' },
  { themeId: 'moral-life', question: 'Wie sollen wir leben?' },
  { themeId: 'freedom-justice', question: 'Was bedeutet es, frei zu sein?' },
  { themeId: 'faith-death-mystery', question: 'Was liegt jenseits dessen, was wir wissen?' },
  { themeId: 'loss-grief', question: 'Wie tragen wir, was wir verloren haben?' },
];

const questions = isDe ? deQuestions : enQuestions;
---
<div class="ll2-cosmic">
  <!-- continuous deep-space field flowing down from the hero, static + CSS only.
       Far back, low opacity, behind content so body text keeps full contrast. -->
  <div class="ll2-sky" aria-hidden="true">
    <div class="ll2-stars ll2-stars--far"></div>
    <div class="ll2-stars ll2-stars--near"></div>
  </div>
  <div class="ll2-cosmic__inner">
{isDe ? (
  <>
    <!-- Was ist Agora Cosmica? Antwort zuerst: derselbe Text, den FAQ #1 und
         llms.txt tragen, damit alle drei Flächen dieselbe Definition sagen. -->
    <section class="pub-section">
      <h2 class="pub-section__title">Was ist Agora Cosmica?</h2>
      <p class="pub-section__text">
        Agora Cosmica ist eine Bildungsplattform, auf der 30 Menschen aus der Geschichte dir
        beibringen, was sie ein Leben lang durchdacht haben. Du hörst erzählte Szenen aus ihrem
        Leben, vertiefst ihre Kerngedanken, sitzt in vierstimmigen Debatten und besprichst jede
        Idee mit ihnen in deinen eigenen Worten. Von Mark Aurel bis Frida Kahlo, auf Deutsch und
        Englisch. Gebaut von einer kleinen gemeinnützigen Organisation in Deutschland, Open Source
        und zum Nachprüfen gemacht.
      </p>
      <p class="pub-section__text">
        Das meiste, was du hier lernst, ist im Voraus entstanden und geschrieben, um dir etwas
        beizubringen. Zu jedem Menschen gehören zwölf Kapitel, und die vier, die du der Reihe nach
        gehst, sind ein Lernweg. Das lebendige Gespräch ist einer der Wege hinein, nicht das Ganze.
      </p>

      <!-- Volumen-Band direkt nach der Einleitung -->
      <div class="pub-volume ll2-volume">
        <span class="pub-volume__item">360 erzählte Geschichten</span>
        <span class="pub-volume__sep">·</span>
        <span class="pub-volume__item">360 Kernlehren</span>
        <span class="pub-volume__sep">·</span>
        <span class="pub-volume__item">360 Prisma-Dialoge</span>
        <span class="pub-volume__sep">·</span>
        <span class="pub-volume__item">110 Council-Debatten</span>
      </div>

      <p class="pub-section__text">
        <a class="pub-textlink" href={publicUrl(lang, '/figures')}>Menschen ansehen</a>
        {' · '}
        <a class="pub-textlink" href={publicUrl(lang, '/about')}>Über das Projekt</a>
      </p>
    </section>

    <!-- Sechs Wege: die interaktive Ein-Menschen-Bibliothek (Carl Gustav Jung,
         alle sechs Wege). Direkt nach "Was ist Agora Cosmica?", damit man erst
         sieht, wie es funktioniert, bevor die Menschen-Liste kommt. Alle sechs
         Panels serverseitig gerendert = crawlbar. -->
    <LibraryShowcase lang={lang} />

    <!-- Das Menschen-Raster: nach der Bibliothek, damit man weiss, was eine
         Menschen-Seite bietet, bevor man Namen durchstöbert. -->
    <section class="pub-section">
      <h2 class="pub-section__title pub-home-subhead ll2-grid-head">Die 30 Menschen aus der Geschichte, mit denen du sprechen kannst</h2>
      <p class="pub-section__text ll2-caption">Öffne einen Namen und entdecke dieses Leben und seine Ideen.</p>
      <div class="pub-grid pub-grid--3 ll2-grid-compact">
        {figures.map(figure => <FigureCard figure={figure} lang={lang} headingLevel="h3" />)}
      </div>
    </section>

    <!-- Dreißig Lehrende, die großen Fragen des Lebens: Fragen als Kachelraster -->
    <section class="pub-section">
      <h2 class="pub-section__title">Die großen Fragen des Lebens</h2>
      <p class="pub-section__text">
        Ihre Lehren versammeln sich rund um acht Fragen, die Menschen sich schon immer gestellt
        haben. Folge einem Namen, oder folge einer Frage. So oder so kommst du weiter.
      </p>

      <h3 class="pub-section__title pub-home-subhead">Acht Fragen</h3>
      <div class="ll2-question-grid">
        {questions.map(item => (
          <LabQuestionTile
            themeId={item.themeId}
            question={item.question}
            themeName={t(`themes.${item.themeId}.name`)}
            lang={lang}
          />
        ))}
      </div>
    </section>

    <!-- Der Cosmic Council: erst die Definition, dann die echte Debatte -->
    <section class="pub-section">
      <h2 class="pub-section__title">Der Cosmic Council</h2>
      <p class="pub-section__text">
        Ein Council sind vier Echos, die eine Frage ausstreiten, während du zuhörst. Eines
        moderiert, die anderen drei widersprechen einander, und niemand spielt hier Einigkeit vor.
        Es gibt 110 fertig produzierte Debatten, 55 Fragen, jede in zwei Tiefen gebaut, alle mit
        vollständigem erzähltem Audio. Oder du stellst deine eigene aus vier beliebigen Stimmen
        zusammen.
      </p>
      <CouncilHero council={heroCouncil} lang={lang} headingLevel="h3" />
      <p class="ll2-runtime">{councilRuntime}</p>
      <div class="pub-home-hero__actions">
        <a
          href={`/app?council=${heroCouncil.id}&lang=${lang}`}
          class="pub-cta__button"
          data-agc-cta="start-exploring"
          data-agc-council={heroCouncil.id}
          data-agc-door="council_play"
        >
          {councilPlayLabel}
        </a>
      </div>
    </section>

    <!-- Ehrlich, mit Absicht: drei Aussagen, jede mit einem Beleg -->
    <section class="pub-section">
      <h2 class="pub-section__title">Ehrlich, mit Absicht</h2>
      <div class="ll2-trust-grid">
        <LabTrustCard label="Ehrlich" proofHref={echoesHref} proofLabel="Warum wir sie Echos nennen">
          Jede Persönlichkeit ist ein KI-Echo, eine Deutung, verwurzelt in ihren eigenen Schriften.
          Nie eine Aufnahme, nie der echte Mensch. Zu jeder gehört ein Faktencheck, der benennt, was
          belegt und was nachgebildet ist.
        </LabTrustCard>
        <LabTrustCard label="Bei dir" proofHref={privacyHref} proofLabel="Zur Datenschutzseite">
          Deine Gespräche bleiben in deinem Browser und erreichen unsere Server nie. Keine
          Tracking-Cookies, keine Analyse durch Dritte, kein Profil darüber, wer du bist.
        </LabTrustCard>
        <LabTrustCard label="Offen" proofHref={repoHref} proofLabel="Zum Code auf GitHub" proofExternal>
          Jede Zeile Code liegt offen unter der AGPL-3.0, jede und jeder kann die Versprechen von
          oben also nachprüfen. Du kannst die ganze Plattform auch auf deinem eigenen Rechner
          betreiben.
        </LabTrustCard>
      </div>
    </section>

    <!-- FAQ -->
    <section class="pub-section pub-home-faq">
      <h2 class="pub-section__title">Fragen, die Menschen uns stellen</h2>
      <div class="pub-home-faq__list">
        {faq.map(item => (
          <details class="pub-collapsible pub-home-faq__item">
            <summary class="pub-collapsible__header">
              <span class="pub-collapsible__title">{item.q}</span>
              <span class="pub-collapsible__arrow" aria-hidden="true">▼</span>
            </summary>
            <div class="pub-collapsible__body pub-home-faq__answer">
              {item.more ? (
                <>
                  <p class="pub-home-faq__p">{item.a}</p>
                  <details class="pub-collapsible pub-home-faq__more">
                    <summary class="pub-collapsible__header">
                      <span class="pub-collapsible__title">{item.more.toggle}</span>
                      <span class="pub-collapsible__arrow" aria-hidden="true">▼</span>
                    </summary>
                    <div class="pub-collapsible__body">
                      {item.more.paras.map(p => <p class="pub-home-faq__p">{p}</p>)}
                      <p class="pub-home-faq__p">
                        <a class="pub-textlink" href={item.more.cta.href}>{item.more.cta.label}</a>
                      </p>
                    </div>
                  </details>
                </>
              ) : (
                item.a
              )}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Zum Lernen gebaut, offen für alle. Nimmt die Wegweiser-Links und die
         GitHub-Bitte auf, die vorher als eigene Blöcke am Seitenende standen. -->
    <section class="pub-section">
      <h2 class="pub-section__title">Zum Lernen gebaut, offen für alle</h2>
      <p class="pub-section__text">
        Agora Cosmica ist ein Projekt der ChipMates gemeinnützigen GmbH, einer kleinen
        gemeinnützigen Organisation in Freiburg. Gemeinnützig heißt, wir sind einer Mission
        verpflichtet, nicht Investoren. Kein Gewinn, keine Anteilseigner, nur die Arbeit. Der Weg,
        auf dem du von jedem Menschen lernst, folgt einem vierstufigen Bogen.
        Eine Idee aufnehmen, sie erkunden, sie verknüpfen und dann zeigen,
        dass du sie verstanden hast. Keine Voraussetzungen, keine Bezahlschranken. Schulen und
        Hochschulen sind eingeladen, es ihren Lernenden zugänglich zu machen, und Entwicklerinnen können
        jede Zeile lesen oder die ganze Plattform mit einem einzigen Befehl selbst hosten. Für uns
        ist es ein Erfolg an dem Tag, an dem du über uns hinauswächst, von unseren Einführungen zu
        den Primärtexten, von KI-Gesprächen zu menschlichen Lehrern, von Neugier zu vertieftem
        Studium. Wir stehen am Anfang, und wir werden Fehler machen. Wenn das passiert, schreib uns
        an agoracosmica@chipmates.ai. Wir bauen das nicht für dich. Wir bauen es mit dir.
      </p>
      <p class="pub-quote">„Verkaufe deine Klugheit und kaufe Verwunderung.“ — Rumi</p>
      <p class="pub-section__text ll2-linkrow">
        <a class="pub-textlink" href={publicUrl(lang, '/about')}>Über uns</a>
        {' · '}
        <a class="pub-textlink" href="/de/about/#kontakt">Kontakt</a>
        {' · '}
        <a class="pub-textlink" href={publicUrl(lang, '/figures')}>Menschen</a>
        {' · '}
        <a class="pub-textlink" href={publicUrl(lang, '/themes')}>Themen</a>
        {' · '}
        <a class="pub-textlink" href={philoHubHref}>{waysInPhilo}</a>
        {' · '}
        <a class="pub-textlink" href={wisdomHubHref}>{waysInWisdom}</a>
        {' · '}
        <a class="pub-textlink" href={ossHref}>{waysInOss}</a>
      </p>

      <!-- GitHub-Bitte als letzte Zeile dieses Abschnitts. Reiner Repo-Link,
           kein Stern-Widget von Dritten, damit das Tracking-Versprechen hält. -->
      <a
        class="ll2-star__card"
        href={repoHref}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="ll2-star__icon" aria-hidden="true">⭐</span>
        <span class="ll2-star__text">
          Gefällt dir das Projekt? Ein Stern auf GitHub ist der einfachste Weg, uns zu helfen, mehr
          Menschen zu erreichen.
        </span>
        <span class="ll2-star__cta">Auf GitHub einen Stern geben →</span>
      </a>
    </section>
  </>
) : (
  <>
    <!-- What is Agora Cosmica? Answer first: the same definition FAQ #1 and
         llms.txt carry, so all three surfaces say one thing. -->
    <section class="pub-section">
      <h2 class="pub-section__title">What is Agora Cosmica?</h2>
      <p class="pub-section__text">
        Agora Cosmica is an education platform where 30 people from history teach you what they
        spent a lifetime working out. You hear narrated scenes from their lives, study their core
        ideas, sit in on four-voice debates, and talk any idea through with them in your own words.
        Marcus Aurelius to Frida Kahlo, in English and German. Made by a small German nonprofit,
        open source, and built to be checked.
      </p>
      <p class="pub-section__text">
        Most of what you learn here was made ahead of time and written to teach. Every person
        carries twelve chapters, and the four you walk in order are a learning arc. Live
        conversation is one of the ways in, not the whole thing.
      </p>

      <!-- volume stat band, right after the What-is intro as a visual band -->
      <div class="pub-volume ll2-volume">
        <span class="pub-volume__item">360 narrated stories</span>
        <span class="pub-volume__sep">·</span>
        <span class="pub-volume__item">360 core teachings</span>
        <span class="pub-volume__sep">·</span>
        <span class="pub-volume__item">360 prism dialogues</span>
        <span class="pub-volume__sep">·</span>
        <span class="pub-volume__item">110 council debates</span>
      </div>

      <p class="pub-section__text">
        <a class="pub-textlink" href={publicUrl(lang, '/figures')}>Browse the figures</a>
        {' · '}
        <a class="pub-textlink" href={publicUrl(lang, '/about')}>About the project</a>
      </p>
    </section>

    <!-- Six ways: the interactive one-figure library (Carl Gustav Jung, all six
         ways). Placed right after "What is Agora Cosmica?" so the visitor sees
         how it works before the figure list. All six panels server-rendered =
         crawlable. -->
    <LibraryShowcase lang={lang} />

    <!-- The figure grid: after the library, so the visitor knows what a figure
         page offers before browsing names. -->
    <section class="pub-section">
      <h2 class="pub-section__title pub-home-subhead ll2-grid-head">The 30 people from history you can talk to</h2>
      <p class="pub-section__text ll2-caption">Open any name to explore their life and ideas.</p>
      <div class="pub-grid pub-grid--3 ll2-grid-compact">
        {figures.map(figure => <FigureCard figure={figure} lang={lang} headingLevel="h3" />)}
      </div>
    </section>

    <!-- Thirty teachers, life's biggest questions: questions as a tile grid -->
    <section class="pub-section">
      <h2 class="pub-section__title">Life's biggest questions</h2>
      <p class="pub-section__text">
        Their teachings gather around eight questions people have always asked. Follow a name,
        or follow a question. Either way, you go further.
      </p>

      <h3 class="pub-section__title pub-home-subhead">Eight questions</h3>
      <div class="ll2-question-grid">
        {questions.map(item => (
          <LabQuestionTile
            themeId={item.themeId}
            question={item.question}
            themeName={t(`themes.${item.themeId}.name`)}
            lang={lang}
          />
        ))}
      </div>
    </section>

    <!-- The Cosmic Council: definition first, then the real debate -->
    <section class="pub-section">
      <h2 class="pub-section__title">The Cosmic Council</h2>
      <p class="pub-section__text">
        A council is four Echoes arguing one question while you listen. One of them moderates, the
        other three disagree with each other, and nobody is performing agreement. There are 110
        produced debates, 55 questions each made at two depths, every one with full narrated audio.
        Or you build your own from any four voices.
      </p>
      <CouncilHero council={heroCouncil} lang={lang} headingLevel="h3" />
      <p class="ll2-runtime">{councilRuntime}</p>
      <div class="pub-home-hero__actions">
        <a
          href={`/app?council=${heroCouncil.id}&lang=${lang}`}
          class="pub-cta__button"
          data-agc-cta="start-exploring"
          data-agc-council={heroCouncil.id}
          data-agc-door="council_play"
        >
          {councilPlayLabel}
        </a>
      </div>
    </section>

    <!-- Honest, by design: three claims, each with a way to check it -->
    <section class="pub-section">
      <h2 class="pub-section__title">Honest, by design</h2>
      <div class="ll2-trust-grid">
        <LabTrustCard label="Honest" proofHref={echoesHref} proofLabel="Why we call them Echoes">
          Every figure is an AI Echo, an interpretation grounded in their own writing. Never a
          recording, never the real person speaking. Each one ships with a factcheck naming what is
          verified and what is recreated.
        </LabTrustCard>
        <LabTrustCard label="Yours" proofHref={privacyHref} proofLabel="Read the privacy page">
          Your conversations stay in your browser and never reach our servers. No tracking cookies,
          no third-party analytics, no profile of who you are.
        </LabTrustCard>
        <LabTrustCard label="Open" proofHref={repoHref} proofLabel="See the code on GitHub" proofExternal>
          Every line of code is public under AGPL-3.0, so anyone can audit the promises above. You
          can also run the whole platform on your own machine.
        </LabTrustCard>
      </div>
    </section>

    <!-- FAQ -->
    <section class="pub-section pub-home-faq">
      <h2 class="pub-section__title">Questions people ask</h2>
      <div class="pub-home-faq__list">
        {faq.map(item => (
          <details class="pub-collapsible pub-home-faq__item">
            <summary class="pub-collapsible__header">
              <span class="pub-collapsible__title">{item.q}</span>
              <span class="pub-collapsible__arrow" aria-hidden="true">▼</span>
            </summary>
            <div class="pub-collapsible__body pub-home-faq__answer">
              {item.more ? (
                <>
                  <p class="pub-home-faq__p">{item.a}</p>
                  <details class="pub-collapsible pub-home-faq__more">
                    <summary class="pub-collapsible__header">
                      <span class="pub-collapsible__title">{item.more.toggle}</span>
                      <span class="pub-collapsible__arrow" aria-hidden="true">▼</span>
                    </summary>
                    <div class="pub-collapsible__body">
                      {item.more.paras.map(p => <p class="pub-home-faq__p">{p}</p>)}
                      <p class="pub-home-faq__p">
                        <a class="pub-textlink" href={item.more.cta.href}>{item.more.cta.label}</a>
                      </p>
                    </div>
                  </details>
                </>
              ) : (
                item.a
              )}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Built for learning, open to everyone. Absorbs the wayfinding links and
         the GitHub ask that used to sit as separate blocks at the page end. -->
    <section class="pub-section">
      <h2 class="pub-section__title">Built for learning, open to everyone</h2>
      <p class="pub-section__text">
        Agora Cosmica is a project of ChipMates gemeinnützige GmbH, a small German nonprofit in
        Freiburg. Charitable status means we answer to a mission, not to investors. No profits, no
        shareholders, just the work. The way you learn from each figure follows a four-step arc.
        Receive an idea, explore it, connect it, then prove you have
        it. No prerequisites, no paywalls. Schools and universities are welcome to bring it to
        their students, and developers can read every line or self-host the whole platform with one
        command. We count it a success the day you outgrow us, moving from our introductions to the
        primary texts, from AI conversations to human teachers, from curiosity to committed study.
        We are early, and we will get things wrong. When we do, tell us at
        agoracosmica@chipmates.ai. We are not building this for you. We are building it with you.
      </p>
      <p class="pub-quote">“Sell your cleverness and buy bewilderment.” — Rumi</p>
      <p class="pub-section__text ll2-linkrow">
        <a class="pub-textlink" href={publicUrl(lang, '/about')}>About</a>
        {' · '}
        <a class="pub-textlink" href="/about/#contact">Contact</a>
        {' · '}
        <a class="pub-textlink" href={publicUrl(lang, '/figures')}>Figures</a>
        {' · '}
        <a class="pub-textlink" href={publicUrl(lang, '/themes')}>Themes</a>
        {' · '}
        <a class="pub-textlink" href={philoHubHref}>{waysInPhilo}</a>
        {' · '}
        <a class="pub-textlink" href={wisdomHubHref}>{waysInWisdom}</a>
        {' · '}
        <a class="pub-textlink" href={ossHref}>{waysInOss}</a>
      </p>

      <!-- GitHub star ask, now the last line of this section. Plain repo link,
           no third-party star widget, so the no-tracking claim stays true. -->
      <a
        class="ll2-star__card"
        href={repoHref}
        target="_blank"
        rel="noopener noreferrer"
      >
