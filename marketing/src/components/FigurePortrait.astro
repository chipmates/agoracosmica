---
// Art-directed hero portrait for the figure detail page. Desktop (>= 820px)
// serves the profile "main" image (~1200x1452); mobile serves the square
// "thumbnail" crop (640x640). Each source is shown at its own native ratio
// (CSS frames per breakpoint), so neither is cropped. WebP first, PNG
// fallback for older browsers. AVIF sources removed 2026-06: the CDN's avif
// encodes measure 50-75% larger than webp (DECISIONS item 21).

import {
  getPublicImageUrl,
  getPublicImageSrcSet,
} from '@client/utils/public/publicMediaUrl';
import { getT } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  figureId: string;
  /** Display name of the figure (localized), used for the AI-portrait alt. */
  name: string;
  lang: Lang;
}

const { figureId, name, lang } = Astro.props;
const t = getT(lang);
// Every figure portrait is an AI-generated image of a real person: the alt
// names that, and a small always-visible badge marks the image itself.
const alt = t('aiDisclosure.imageAlt').replace('{name}', name);
---
<picture>
  <source
    media="(min-width: 820px)"
    type="image/webp"
    srcset={getPublicImageSrcSet(figureId, 'main', 'webp')}
    sizes="384px"
    width="1200"
    height="1452"
  />
  <source
    type="image/webp"
    srcset={getPublicImageSrcSet(figureId, 'thumbnail', 'webp')}
    sizes="(max-width: 480px) 62vw, 248px"
  />
  <img
    src={getPublicImageUrl(figureId, 'thumbnail', 320, 'png')}
    alt={alt}
    width="320"
    height="320"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
</picture>
<!-- Anchors to the caller's portrait frame (.pub-fig-hero__portrait is
     position: relative), so the badge sits on the image at every breakpoint. -->
<span class="pub-ai-badge" title={t('aiDisclosure.imageBadgeLong')}>
  {t('aiDisclosure.imageBadge')}
</span>

<style>
  /* AI-image disclosure badge: static, always visible, dark scrim for
     contrast over any portrait pixel, never intercepts the pointer */
  .pub-ai-badge {
    position: absolute;
    bottom: var(--space-xs);
    right: var(--space-xs);
    padding: var(--space-xs) var(--space-sm);
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    line-height: var(--leading-tight);
    color: var(--text-secondary);
    background: color-mix(in srgb, var(--bg-deep-space-darker) 70%, transparent);
    border: 1px solid var(--utility-border);
    border-radius: var(--radius-sm);
    pointer-events: none;
    white-space: nowrap;
  }
</style>
