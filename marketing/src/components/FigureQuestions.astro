---
// The questions block: one tap into the app, carrying the question with it.
//
// Two doors ship today and both are live end to end:
//   Q1  the figure's own entry question   ?ask=f:{figureId}:1
//   Q3  the real question of the debate the figure leads   ?q={councilId}
//
// Q2, the idea question, is written per figure in figurePageContent.ts and is
// deliberately NOT rendered yet. Its door would be ?ask=f:{figureId}:2, and the
// app's ask table resolves slot 2 back to slot 1 today
// (client/src/utils/public/entryIntent.ts, resolveAskPrefill), so the card would
// promise one question and deliver another. Click-promise coherence beats
// completeness.
// TODO: render Q2 the day resolveAskPrefill returns a real slot-2 question.

import type { Lang } from '../i18n';
import StaticImage from './StaticImage.astro';
import { getLocalizedTitle, getLocalizedQuestion } from '@client/data/councilCatalog';
import type { CatalogCouncil } from '@client/data/councilCatalog';
import { getHeroEntryQuestion } from '@client/data/public/heroEntry';
import { cleanDisplayText } from '../lib/figureWorld';

interface Props {
  figureId: string;
  slug: string;
  figureName: string;
  /** The debate this figure leads. Omitted when they are in none. */
  council?: CatalogCouncil;
  lang: Lang;
  /** Funnel position: the block appears twice per page. */
  door: string;
  /** The foot instance repeats the block, so it gets the quieter heading. */
  variant?: 'lead' | 'foot';
  /** The lead instance sits a few hundred pixels under the hero, which already
   *  shows the entry question as its own card. Repeating it there reads as a
   *  bug, so the lead instance leaves it out and the foot instance carries it. */
  skipEntryQuestion?: boolean;
}

const {
  figureId, slug, figureName, council, lang, door,
  variant = 'lead', skipEntryQuestion = false,
} = Astro.props;
const de = lang === 'de';

const S = de
  ? {
      headLead: `Frag ${figureName} selbst`,
      headFoot: 'Bereit für die erste Frage?',
      caption: 'Ein Tipp, kein Tippen. Die Frage steht schon im Feld, du schickst sie nur ab.',
      whoAsk: 'Diese Frage stellen',
      whoDebate: 'Aus der Debatte',
      free: '30 kostenlose Nachrichten pro Tag. Ohne Anmeldung.',
    }
  : {
      headLead: `Ask ${figureName} yourself`,
      headFoot: 'Ready for the first question?',
      caption: 'One tap, no typing. The question is already in the box, you just send it.',
      whoAsk: 'Ask this question',
      whoDebate: 'From the debate',
      free: '30 free messages a day. No signup needed.',
    };

const heroQuestion = getHeroEntryQuestion(figureId, lang);

interface Door {
  question: string;
  href: string;
  who: string;
}

// Every door lands on THIS figure with the question already staged, so every
// card wears this figure's portrait. A council supplies the question, it does
// not answer it.
const doors: Door[] = [];
if (heroQuestion && !skipEntryQuestion) {
  doors.push({
    question: heroQuestion,
    href: `/app?figure=${slug}&lang=${lang}&ask=f:${figureId}:1`,
    who: S.whoAsk,
  });
}
if (council) {
  doors.push({
    question: cleanDisplayText(getLocalizedQuestion(council, lang)),
    href: `/app?figure=${slug}&lang=${lang}&q=${council.id}`,
    who: `${S.whoDebate}: ${getLocalizedTitle(council, lang)}`,
  });
}
const heading = variant === 'foot' ? S.headFoot : S.headLead;
---
{doors.length > 0 && (
  <section class="pub-section fig-ask-block">
    <h2 class="pub-section__title">{heading}</h2>
    <p class="pub-section__text">{S.caption}</p>
    <ul class="fig-ask-block__list">
      {doors.map(d => (
        <li>
          <a
            class="fig-qdoor"
            href={d.href}
            data-agc-cta="start-exploring"
            data-agc-figure={figureId}
            data-agc-door={door}
          >
            <span class="fig-qdoor__thumb">
              <StaticImage
                figureId={figureId}
                type="thumbnail"
                alt=""
                loading="lazy"
                width={48}
                height={48}
                sizes="48px"
              />
            </span>
            <span class="fig-qdoor__body">
              <span class="fig-qdoor__q">{d.question}</span>
              <span class="fig-qdoor__who">{d.who}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p class="fig-ask-block__free">{S.free}</p>
  </section>
)}

<style is:global>
  .fig-ask-block__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .fig-qdoor {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 56px;
    padding: 0.7rem 0.95rem;
    border: 1px solid color-mix(in srgb, var(--gold-subtle) var(--a-20, 20%), transparent);
    border-radius: var(--plate-radius, 4px);
    background: color-mix(in srgb, var(--bg-card) var(--a-60, 60%), transparent);
    text-decoration: none;
    transition: border-color var(--transition-fast), background var(--transition-fast);
  }
  .fig-qdoor:hover,
  .fig-qdoor:focus-visible {
    border-color: color-mix(in srgb, var(--gold-primary) var(--a-45, 45%), transparent);
    background: color-mix(in srgb, var(--bg-highlight) var(--a-60, 60%), transparent);
  }
  .fig-qdoor__thumb { flex: 0 0 auto; display: block; }
  .fig-qdoor__thumb img {
    display: block;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--bg-card);
    border: 1px solid color-mix(in srgb, var(--gold-primary) var(--a-25, 25%), transparent);
  }
  .fig-qdoor__body { display: flex; flex-direction: column; gap: 0.25rem; min-width: 0; }
  .fig-qdoor__q {
    font-family: var(--font-content, 'Libre Caslon Text', serif);
    font-size: 1.02rem;
    line-height: 1.5;
    color: var(--text-primary);
  }
  .fig-qdoor__who {
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-deep);
  }
  .fig-qdoor:hover .fig-qdoor__who,
  .fig-qdoor:focus-visible .fig-qdoor__who { color: var(--gold-primary); }
  .fig-ask-block__free {
    margin: 0.2rem 0 0;
    font-size: 0.82rem;
    color: var(--text-tertiary);
  }
</style>
