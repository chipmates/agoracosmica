---
// The figure's deep pages, under the lead answer. The lead-in is a label, not
// a heading, so the outline does not jump from the H1 to an H3.

interface Props {
  links: { href: string; label: string }[];
  lead: string;
}

const { links, lead } = Astro.props;
---
{links.length > 0 && (
  <section class="pub-section pub-fig-deeper">
    <p class="fig-related__title">{lead}</p>
    {links.map(link => (
      <p class="pub-section__text pub-figure__poems-link">
        <a class="pub-textlink" href={link.href}>{link.label}</a>
      </p>
    ))}
  </section>
)}
