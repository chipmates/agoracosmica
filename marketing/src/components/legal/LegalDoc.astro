---
import '../../styles/legal.css';
import BackLink from '../BackLink.astro';
import { getT } from '../../i18n';
import { publicUrl } from '../../lib/urls';

interface Props {
  title: string;
  lastUpdated: string;
  lang?: 'de' | 'en';
}

const { title, lastUpdated, lang = 'de' } = Astro.props;
const isEn = lang === 'en';
const t = getT(lang);
const home = publicUrl(lang, '/');
---
<article class="legal-doc">
  <BackLink at="top" href={home} label={t('breadcrumbs.home')} />
  <header class="legal-doc__header">
    <h1 class="legal-doc__title">{title}</h1>
    <p class="legal-doc__date">{lastUpdated}</p>
  </header>

  <slot />

  <div class="legal-doc__footer">
    <nav class="legal-doc__footer-links" aria-label={isEn ? 'Legal' : 'Rechtliches'}>
      <a href="/impressum/">{isEn ? 'Imprint' : 'Impressum'}</a>
      <span class="legal-doc__footer-sep">•</span>
      <a href={isEn ? '/privacy/' : '/datenschutz/'}>{isEn ? 'Privacy Policy' : 'Datenschutzerklärung'}</a>
      <span class="legal-doc__footer-sep">•</span>
      <a href="/cookie-policy/">{isEn ? 'Cookie Policy' : 'Cookie-Richtlinie'}</a>
      <span class="legal-doc__footer-sep">•</span>
      <a href={isEn ? '/terms/' : '/nutzungsbedingungen/'}>{isEn ? 'Terms' : 'Nutzungsbedingungen'}</a>
    </nav>
  </div>
  <BackLink at="end" href={home} label={t('breadcrumbs.home')} />
</article>

<style>
  /* The links at the end are 44px targets; the rows' gap lives inside them now. */
  .legal-doc__footer-links {
    row-gap: 0;
    margin: -0.7rem 0;
  }
  .legal-doc__footer-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    min-width: 44px;
  }
</style>
