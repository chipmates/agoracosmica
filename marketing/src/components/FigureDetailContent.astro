---
// The figure detail page, top to bottom.
//
// The order is the point. A searcher lands here with a question, so the answer
// comes first, the door comes second, and the substance that used to sit inside
// collapsed boxes is open and headed with the questions people actually type.
// Everything down to the councils is server-rendered and uncollapsed. <details>
// survives only for the council tail.
//
//   hero            who this is, the voice, the promise, the first question
//   answer          40 to 80 words, the first paragraph after the H1
//   questions       one tap into the app, at peak intent
//   six ways        the interactive library, the only "try it" on the page:
//                   the playable overture before the long read, so the taste
//                   comes before the two scroll-walls instead of after them
//   concepts        headings that are real queries, each answer self-contained
//   twelve chapters the life, with the documented/recreated ledger per scene
//   councils        where the figure argues, with the produced previews
//   lattice         the 36 typed edges, the densest internal linking we own
//   themes, hub     the rest of the lattice
//   shadow          built, wired, renders nothing (owner-gated)
//   works, sources  the paper trail, then the Echo disclosure as the last word
//   questions       the same door again, for the long reader
//
// All data resolves at build time from client/ via the @client alias.

import Breadcrumbs from './Breadcrumbs.astro';
import FigureHero from './FigureHero.astro';
import FigureQuestions from './FigureQuestions.astro';
import FigureConcepts from './FigureConcepts.astro';
import FigureChapters from './FigureChapters.astro';
import FigureSixWays from './FigureSixWays.astro';
import FigureCouncils from './FigureCouncils.astro';
import FigureLattice from './FigureLattice.astro';
import FigureShadow from './FigureShadow.astro';
import FigureQA from './FigureQA.astro';
import EchoNote from './EchoNote.astro';
import StaticImage from './StaticImage.astro';
import PublicCTA from './PublicCTA.astro';
import SourcesBlock from './SourcesBlock.astro';

import { getT } from '../i18n';
import type { Lang } from '../i18n';
import { publicUrl } from '../lib/urls';
import { getSeedsFor } from '../lib/seeds';
import { cleanDisplayText, rankedCouncilsFor } from '../lib/figureWorld';
import { getFigureById } from '@client/data/public/figuresCatalog';
import { figureIdToSlug } from '@client/data/public/slugMap';
import { getShortDisplayName } from '@client/data/councilCatalog';
import { figureThemes } from '@client/data/public/figureSeo';
import { getFigureQA } from '@client/data/public/figureQA';
import { dickinsonPoemsFaqEn, dickinsonPoemsFaqDe } from '../lib/dickinsonPoemsFaq';

interface Props {
  figureId: string;
  slug: string;
  lang: Lang;
}

const { figureId, slug, lang } = Astro.props;
const t = getT(lang);
const de = lang === 'de';
const figure = getFigureById(figureId, lang);

if (!figure) {
  throw new Error(`Unknown figure: ${figureId}`);
}

const seeds = getSeedsFor(figureId, lang);
const shortName = getShortDisplayName(figureId);
const qa = getFigureQA(figureId, lang);
const leadAnswer = qa?.pairs[0]?.a ?? '';
const aboutParas = figure.about.split('\n').map(p => p.trim()).filter(Boolean);

// The debate this figure leads, for the questions block. Same ranking the
// council section uses, so the question card and the first council card are
// always the same debate.
const leadCouncil = rankedCouncilsFor(figureId)[0];

// Related figures drawn from seed connections, ranked by how often this figure
// references them across seeds, then the top 8. The typed rails above carry the
// why; this row is the visual coda that puts faces to the names.
const connectionCounts = new Map<string, number>();
for (const seed of seeds) {
  for (const conn of seed.connections ?? []) {
    if (conn.figure !== figureId && figureIdToSlug[conn.figure]) {
      connectionCounts.set(conn.figure, (connectionCounts.get(conn.figure) ?? 0) + 1);
    }
  }
}
const relatedFigureIds = [...connectionCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([id]) => id)
  .slice(0, 8);
const themesForFigure = figureThemes[figureId] ?? [];

// Governing-hub up-link (the "up" half of the hub<->figure symbiosis): the 13
// philosophy-cluster figures point to the philosophy hub, every other figure to
// the wisdom hub. The DE hubs use localized slugs (philosophie-lernen, not a
// /de/ prefix of the EN slug), so the href is built literally per language.
const PHILO_FIGURES = new Set([
  'laozi', 'aurelius', 'plato', 'nietzsche', 'schopenhauer', 'beauvoir',
  'gautama', 'zenji', 'eckhart', 'bingen', 'rumi', 'jung', 'campbell',
]);
const isPhiloFigure = PHILO_FIGURES.has(figureId);
const hubHref = de
  ? (isPhiloFigure ? '/de/philosophie-lernen/' : '/de/figures/')
  : (isPhiloFigure ? '/ai-philosophy-tutor/' : '/figures/');
const hubLinkLabel = isPhiloFigure
  ? (de ? 'Philosophie lernen mit einem KI-Tutor' : 'Learn philosophy with an AI tutor')
  : (de ? 'Von historischen Persönlichkeiten lernen' : 'Learn from historical figures');

// Dickinson-only interpretive capsule: "what are her poems about" (the winnable
// query) as a visible, snippet-eligible answer that funnels into her poems page.
// Same array drives the FAQPage JSON-LD in the route, so DOM and schema match.
const poemsFaq = figureId === 'dickinson' ? (de ? dickinsonPoemsFaqDe : dickinsonPoemsFaqEn) : null;

const S = de
  ? {
      hubLead: 'Weiter erkunden: ',
      related: 'Menschen, die hier immer wieder auftauchen',
      themes: 'Große Fragen, an denen er arbeitet',
      voice: 'Wie dieses Echo klingt',
      method: 'Wie wir diese Echos bauen und prüfen',
      poemsLink: 'Lies ihre Gedichte nach Thema, in ihrer eigenen Handschrift →',
    }
  : {
      hubLead: 'Keep exploring: ',
      related: 'People who keep coming up here',
      themes: 'The big questions this work touches',
      voice: 'How this Echo sounds',
      method: 'How we build and fact-check these Echoes',
      poemsLink: 'Read her poems grouped by theme, in her own hand →',
    };

// German needs a pronoun where English does not, and thirty figures are of
// mixed gender, so the themes heading drops the possessive in German too.
const themesHeading = de ? 'Große Fragen, die dieses Werk berührt' : S.themes;

// The voice-profile essence is one long block written for a model to read, so
// it breaks into paragraphs at sentence boundaries before it goes on a page.
// A display split only: not a word changes.
const essenceParas: string[] = [];
if (figure.essence) {
  const sentences = cleanDisplayText(figure.essence).match(/[^.!?]+[.!?]+(\s|$)/g) ?? [];
  for (let i = 0; i < sentences.length; i += 2) {
    essenceParas.push(sentences.slice(i, i + 2).join('').trim());
  }
}
---
<div class="pub-content pub-figure">
  <Breadcrumbs
    lang={lang}
    items={[
      { label: t('breadcrumbs.figures'), path: '/figures' },
      { label: figure.name },
    ]}
  />

  <FigureHero figure={figure} slug={slug} lang={lang} />

  {leadAnswer && (
    <p class="pub-section__text pub-fig-answer">{leadAnswer}</p>
  )}

  <FigureQuestions
    figureId={figureId}
    slug={slug}
    figureName={figure.name}
    council={leadCouncil}
    lang={lang}
    door="fig_q_lead"
    skipEntryQuestion
  />

  <FigureSixWays figureId={figureId} figureName={figure.name} lang={lang} />

  <FigureConcepts figureId={figureId} slug={slug} lang={lang} />

  {poemsFaq && (
    <section class="pub-section pub-figure__poems">
      <h2 class="pub-section__title">{poemsFaq[0].q}</h2>
      <p class="pub-section__text">{poemsFaq[0].a}</p>
      <p class="pub-section__text pub-figure__poems-link">
        <a class="pub-textlink" href="/figures/emily-dickinson/poems/">{S.poemsLink}</a>
      </p>
      {poemsFaq.slice(1).map(item => (
        <div class="pub-figure__qa">
          <h3 class="pub-figure__qa-q">{item.q}</h3>
          <p class="pub-section__text">{item.a}</p>
        </div>
      ))}
    </section>
  )}

  <FigureChapters
    figureId={figureId}
    slug={slug}
    figureName={figure.name}
    intro={aboutParas}
    lang={lang}
  />

  <FigureCouncils figureId={figureId} slug={slug} figureName={figure.name} lang={lang} />

  <FigureLattice figureId={figureId} figureName={figure.name} lang={lang}>
    {relatedFigureIds.length > 0 && (
      <div class="fig-related" slot="coda">
        <h3 class="fig-related__title">{S.related}</h3>
        <div class="pub-grid pub-grid--2">
          {relatedFigureIds.map(relId => {
            const relFigure = getFigureById(relId, lang);
            const relSlug = figureIdToSlug[relId];
            if (!relFigure || !relSlug) return null;
            return (
              <a
                href={publicUrl(lang, `/figures/${relSlug}`)}
                class="pub-figure-card pub-figure-card--row"
              >
                <StaticImage
                  figureId={relId}
                  type="thumbnail"
                  alt=""
                  loading="lazy"
                  width={64}
                  height={64}
                  sizes="64px"
                />
                <div>
                  <div class="pub-figure-card__name">{relFigure.name}</div>
                  <div class="pub-figure-card__tradition">{relFigure.tradition}</div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    )}
  </FigureLattice>

  {themesForFigure.length > 0 && (
    <section class="pub-section fig-themes">
      <h2 class="pub-section__title">{themesHeading}</h2>
      <div class="pub-grid pub-grid--3">
        {themesForFigure.map(themeId => (
          <a href={publicUrl(lang, `/themes/${themeId}`)} class="pub-theme-card">
            <h3 class="pub-theme-card__name">{t(`themes.${themeId}.name`)}</h3>
            <p class="pub-theme-card__tagline">{t(`themes.${themeId}.tagline`)}</p>
          </a>
        ))}
      </div>
      <p class="pub-section__text pub-figure__hublink">
        {S.hubLead}<a class="pub-textlink" href={hubHref}>{hubLinkLabel}</a>
      </p>
    </section>
  )}

  <FigureShadow figureId={figureId} lang={lang} />

  <SourcesBlock figureId={figureId} lang={lang} />

  {essenceParas.length > 0 && (
    <section class="pub-section fig-voice">
      <h2 class="pub-section__title">{S.voice}</h2>
      {essenceParas.map(p => <p class="pub-section__text">{p}</p>)}
    </section>
  )}

  <FigureQA figureId={figureId} lang={lang} />

  <EchoNote variant="figure" name={figure.name} lang={lang} />

  <p class="pub-section__text pub-figure__methodlink">
    <a class="pub-textlink" href={de ? '/de/methodik/' : '/methodology/'}>{S.method}</a>
  </p>

  <FigureQuestions
    figureId={figureId}
    slug={slug}
    figureName={figure.name}
    council={leadCouncil}
    lang={lang}
    door="fig_q_foot"
    variant="foot"
  />

  <PublicCTA
    variant="sticky"
    figureId={figureId}
    figureName={shortName}
    lang={lang}
  />
</div>

<style is:global>
  /* The answer. First body element, 40 to 80 words, the paragraph a snippet
     and an answer engine lift. Sized up so the eye lands on it. */
  .pub-figure .pub-fig-answer {
    margin: 0 0 0.4rem;
    font-size: 1.12rem;
    line-height: 1.78;
    color: var(--text-primary);
    max-width: 64ch;
  }
  .pub-figure__poems { margin: 0; }
  .pub-figure__poems-link { margin-top: 0.5rem; font-size: 1.05rem; }
  .pub-figure__qa { margin-top: 1.5rem; }
  .pub-figure__qa-q {
    font-family: var(--font-content, 'Libre Caslon Text', serif);
    font-size: 1.1rem;
    color: var(--gold-primary);
    margin: 0 0 0.4rem;
  }
  /* The portrait rows are the lattice's coda, so they live inside its section
     and keep the tighter in-section rhythm. */
  .fig-related { margin-top: 0.6rem; }
  .fig-related__title {
    margin: 0 0 0.8rem;
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
    font-size: 0.72rem;
    font-weight: var(--weight-medium, 500);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-deep);
  }
  .pub-figure__hublink { margin: 0.5rem 0 0; }
  .pub-figure__methodlink { margin: 0; font-size: 0.95rem; }
  /* Related-figures rows: horizontal card variant (a class, not an inline
     style, so the strict CSP style-src needs no 'unsafe-inline'). */
  .pub-figure-card.pub-figure-card--row {
    flex-direction: row;
    gap: 0.75rem;
    align-items: center;
    padding: 0.75rem;
  }
</style>
