---
// The trust page (/about + /de/about). Seven blocks, in the order a stranger
// asks the questions: who built this, what kind of organization is it, why does
// it exist, what can I do here, who is in it, can I check any of this, how do I
// reach you. The old twelve-heading version answered the trust question in
// paragraph nine.
//
// Two blocks carry a named job:
//   - the lead answers "who is behind this" in about sixty words, above the
//     fold and server-rendered, because that is the snippet a search engine and
//     an AI assistant both quote.
//   - the trust block's heading IS the query people type, and its first
//     paragraph answers it before the checkable details follow.
// /contact was merged in as block seven; the anchor is #contact in English and
// #kontakt in German, and both ids resolve in both languages so an old or a
// cross-language link still lands. /impressum keeps the legal duty.
import Breadcrumbs from './Breadcrumbs.astro';
import ContentVolume from './ContentVolume.astro';
import PublicCTA from './PublicCTA.astro';
import { getT } from '../i18n';
import type { Lang } from '../i18n';
import { publicUrl } from '../lib/urls';
import { getFiguresCatalog } from '@client/data/public/figuresCatalog';
import { figureIdToSlug } from '@client/data/public/slugMap';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getT(lang);
const isDe = lang === 'de';

const TRADITION_GROUPS = [
  { key: 'western', ids: ['aurelius', 'plato', 'nietzsche', 'schopenhauer', 'beauvoir', 'eckhart'] },
  { key: 'eastern', ids: ['laozi', 'gautama', 'rumi', 'zenji'] },
  { key: 'literature', ids: ['woolf', 'dickinson', 'shakespeare', 'austen', 'goethe', 'blake'] },
  { key: 'art', ids: ['kahlo', 'mozart', 'vinci'] },
  { key: 'science', ids: ['einstein', 'galilei', 'lovelace'] },
  { key: 'justice', ids: ['king', 'gandhi', 'mandela', 'tubman', 'angelou'] },
  { key: 'psychology', ids: ['jung', 'campbell'] },
  { key: 'mysticism', ids: ['bingen'] },
];

const TRADITION_LABELS: Record<string, Record<Lang, string>> = {
  western: { en: 'Western Philosophy', de: 'Westliche Philosophie' },
  eastern: { en: 'Eastern Wisdom', de: 'Östliche Weisheit' },
  literature: { en: 'Literature & Poetry', de: 'Literatur & Poesie' },
  art: { en: 'Art & Expression', de: 'Kunst & Ausdruck' },
  science: { en: 'Science & Innovation', de: 'Wissenschaft & Innovation' },
  justice: { en: 'Justice & Liberation', de: 'Gerechtigkeit & Befreiung' },
  psychology: { en: 'Psychology & Myth', de: 'Psychologie & Mythos' },
  mysticism: { en: 'Mysticism', de: 'Mystik' },
};

const MODE_CARDS = [
  { key: 'story', nameKey: 'journey.modeStory', badge: 'listen' },
  { key: 'wisdom', nameKey: 'journey.modeWisdom', badge: 'talk' },
  { key: 'prism', nameKey: 'journey.modePrism', badge: 'listen' },
  { key: 'quest', nameKey: 'journey.modeQuest', badge: 'talk' },
  { key: 'freetalk', nameKey: 'journey.freetalk', badge: 'talk' },
  { key: 'council', nameKey: 'journey.modeCouncil', badge: 'listen' },
];

function splitLabel(value: string): { label: string; text: string } {
  const idx = value.indexOf(': ');
  if (idx === -1) return { label: '', text: value };
  return { label: value.slice(0, idx), text: value.slice(idx + 2) };
}

const values = (['valueGratitude', 'valueCuriosity', 'valueOpenness', 'valueTransformation'] as const)
  .map(k => splitLabel(t(`about.${k}`)));
const barriers = (['barrierGeographic', 'barrierAcademic', 'barrierAge', 'barrierEconomic'] as const)
  .map(k => splitLabel(t(`about.${k}`)));

const figures = getFiguresCatalog(lang);
const figureMap = new Map(figures.map(f => [f.id, f]));

const methodologyHref = isDe ? '/de/methodik/' : '/methodology/';
const contactAnchor = isDe ? 'kontakt' : 'contact';
const contactAnchorAlt = isDe ? 'contact' : 'kontakt';
const country = isDe ? 'Deutschland' : 'Germany';
---
<div class="pub-content pub-about">
  <Breadcrumbs lang={lang} items={[{ label: t('breadcrumbs.about') }]} />

  <h1 class="pub-hero__title">{t('about.h1')}</h1>
  <p class="pub-about-lead">{t('about.mission')}</p>
  <p class="pub-about-answer">{t('about.lead')}</p>

  <section class="pub-section">
    <h2 class="pub-section__title">{t('about.orgTitle')}</h2>
    <div class="pub-section__text">
      <p>{t('about.orgP1')}</p>
      <p>{t('about.orgP2')}</p>
    </div>
    <h3 class="pub-about-sub">{t('about.valuesTitle')}</h3>
    <dl class="pub-about-dl">
      {values.map(v => (
        <div class="pub-about-dl__row">
          <dt>{v.label}</dt>
          <dd>{v.text}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="pub-section">
    <h2 class="pub-section__title">{t('about.whyTitle')}</h2>
    <div class="pub-section__text">
      <p>{t('about.whyP1')}</p>
      <p>{t('about.whyP2')}</p>
    </div>
    <h3 class="pub-about-sub">{t('about.barriersTitle')}</h3>
    <p class="pub-section__text">{t('about.barriersIntro')}</p>
    <dl class="pub-about-dl">
      {barriers.map(b => (
        <div class="pub-about-dl__row">
          <dt>{b.label}</dt>
          <dd>{b.text}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="pub-section">
    <h2 class="pub-section__title">{t('about.doTitle')}</h2>
    <div class="pub-section__text">
      <p>{t('about.doP1')}</p>
      <p>{t('about.doP2')}</p>
      <p>{t('about.doP3')}</p>
    </div>
    <ContentVolume lang={lang} />
    <p class="pub-section__text pub-about-modes-lead">{t('about.howItWorks.subtitle')}</p>
    <div class="pub-concepts">
      {MODE_CARDS.map(mode => (
        <div class="pub-concept">
          <div class="pub-concept__head">
            <span class="pub-concept__term">{t(mode.nameKey)}</span>
            <span class={`pub-journey__badge pub-journey__badge--${mode.badge}`}>
              {t(`journey.${mode.badge}`)}
            </span>
          </div>
          <div class="pub-concept__def">{t(`about.howItWorks.${mode.key}`)}</div>
        </div>
      ))}
      <div class="pub-concept">
        <div class="pub-concept__term">{t('journey.audioLibrary')}</div>
        <div class="pub-concept__def">{t('about.howItWorks.audioLibrary')}</div>
      </div>
    </div>
  </section>

  <section class="pub-section">
    <h2 class="pub-section__title">{t('about.figures.title')}</h2>
    <div class="pub-section__text">
      <p>{t('about.figures.description')}</p>
    </div>
    {TRADITION_GROUPS.map(group => (
      <div class="pub-about-group">
        <h3 class="pub-about-group__label">
          {TRADITION_LABELS[group.key]?.[lang] || group.key}
        </h3>
        <div class="pub-about-group__figures">
          {group.ids.map(id => {
            const fig = figureMap.get(id);
            if (!fig) return null;
            return (
              <a
                href={publicUrl(lang, `/figures/${figureIdToSlug[id]}`)}
                class="pub-hero__badge"
              >
                {fig.name}
              </a>
            );
          })}
        </div>
      </div>
    ))}
  </section>

  <section class="pub-section pub-about-target" id="trust">
    <h2 class="pub-section__title">{t('about.trustTitle')}</h2>
    <p class="pub-about-answer">{t('about.trustAnswer')}</p>
    <h3 class="pub-about-sub">{t('about.checkTitle')}</h3>
    <div class="pub-about-points">
      {(['nonprofit', 'factChecked', 'noTracking', 'openSource', 'freeTurns'] as const).map(key => (
        <p>{t(`about.builtDifferent.${key}`)}</p>
      ))}
      <p>
        {t('about.builtDifferent.github')}{' '}
        <a
          href="https://github.com/chipmates/agoracosmica"
          target="_blank"
          rel="noopener noreferrer"
          class="pub-textlink"
        >
          chipmates/agoracosmica
        </a>
      </p>
    </div>
    <p class="pub-section__text pub-about-trustlinks">
      {t('about.trustLinksLead')}{' '}
      <a class="pub-textlink" href={methodologyHref}>{t('about.methodologyLink')}</a>
      {' · '}
      <a class="pub-textlink" href={publicUrl(lang, '/echoes')}>{t('about.echoesLink')}</a>
    </p>
    <h3 class="pub-about-sub">{t('about.voiceCredits.title')}</h3>
    <p class="pub-section__text">{t('about.voiceCredits.body')}</p>
  </section>

  <section class="pub-section pub-about-target" id={contactAnchor}>
    <span id={contactAnchorAlt} class="pub-about-alt-anchor"></span>
    <h2 class="pub-section__title">{t('about.contactTitle')}</h2>
    <p class="pub-section__text">{t('about.contactP1')}</p>
    <dl class="pub-about-dl">
      <div class="pub-about-dl__row">
        <dt>{t('about.contactEmailLabel')}</dt>
        <dd>
          <a href="mailto:agoracosmica@chipmates.ai" class="pub-textlink">agoracosmica@chipmates.ai</a>
        </dd>
      </div>
      <div class="pub-about-dl__row">
        <dt>{t('about.contactAddressLabel')}</dt>
        <dd>
          <address class="pub-contact-address">
            ChipMates gemeinnützige GmbH<br />
            Schusterstr. 50<br />
            79098 Freiburg im Breisgau<br />
            {country}
          </address>
        </dd>
      </div>
      <div class="pub-about-dl__row">
        <dt>{t('about.contactSocialLabel')}</dt>
        <dd>
          <a href="https://github.com/chipmates/agoracosmica" target="_blank" rel="noopener noreferrer" class="pub-textlink">
            GitHub - chipmates/agoracosmica
          </a>
        </dd>
      </div>
    </dl>
    <p class="pub-section__text pub-about-legalnote">
      {t('about.contactLegalPre')}<a class="pub-textlink" href="/impressum/">{t('about.contactLegalLink')}</a>{t('about.contactLegalPost')}
    </p>
  </section>

  <div class="pub-about-quote">
    <div class="pub-about-quote__rule" aria-hidden="true" />
    <blockquote>{t('about.closingQuote')}</blockquote>
    <cite class="pub-about-quote__cite">— {t('about.closingAttribution')}</cite>
  </div>

  <PublicCTA variant="inline" lang={lang} />
</div>

<style>
  /* The answer-first paragraphs (page lead + the trust answer). Set a step
     above body copy so the eye starts there, brand tokens only. */
  .pub-about-answer {
    font-family: var(--font-content, 'Libre Caslon Text', serif);
    font-size: 1.12rem;
    line-height: 1.72;
    color: var(--text-primary);
    margin: 0 0 2.25rem;
    max-width: 40rem;
  }
  .pub-section .pub-about-answer {
    margin-bottom: 1.75rem;
  }

  /* Sub-headings inside a block, so a long section still reads as movements
     without adding another h2 to the page outline. */
  .pub-about-sub {
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-subtle);
    margin: 2rem 0 0.85rem;
  }

  .pub-about-modes-lead {
    margin-top: 1.75rem;
  }

  .pub-about-trustlinks,
  .pub-about-legalnote {
    margin-top: 1.4rem;
  }

  /* Anchored blocks clear the sticky navbar when jumped to. */
  .pub-about-target {
    scroll-margin-top: 5.5rem;
  }
  .pub-about-alt-anchor {
    display: block;
    height: 0;
    scroll-margin-top: 5.5rem;
  }
</style>
