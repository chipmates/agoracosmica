---
// The figure page hero: the per-figure spine.
//
// Portrait (the LCP image) with the Echo disclosure as its caption, who this
// is, the answer a searcher came for, one gold Begin, then the trailer that
// ends by handing you the story, the promise line, the first chapter as a
// quiet door, and one line naming how big this figure's world is. The answer
// sits under the name so a phone shows it on the first screen.
//
// The disclosure sits under the portrait because that is what it describes:
// the image and the voice. Its wording is fixed by the transparency program,
// so it is rendered from its translation key and never restated here.

import FigurePortrait from './FigurePortrait.astro';
import FigureTrailer from '../islands/FigureTrailer';
import { getT } from '../i18n';
import type { Lang } from '../i18n';
import { getPublicTrailerUrl } from '@client/utils/public/publicMediaUrl';
import { getSeedsFor } from '../lib/seeds';
import { getStoryChapter } from '../lib/stories';
import { chapterDisplayMinutes } from '../lib/storyRuntime';
import { isFrozenFigurePage } from '../lib/frozenPages';
import { getFigureWorld, numberWord, capitalize, cleanDisplayText } from '../lib/figureWorld';

interface Figure {
  id: string;
  name: string;
  period?: string;
  tradition?: string;
  about: string;
  learn?: string;
}

interface Props {
  figure: Figure;
  slug: string;
  lang: Lang;
  /** The lead answer. Pages in the running search test render it below the hero instead. */
  answer?: string;
}

const { figure, slug, lang, answer } = Astro.props;
const t = getT(lang);
const de = lang === 'de';
// Pages in the running search test keep the hero they launched with.
const frozen = isFrozenFigurePage(lang, slug);
const heroAnswer = frozen ? '' : (answer ?? '');
// The promise is our line about the figure, never a quotation of them.
const learnLine = figure.learn
  ? (frozen ? (de ? `„${figure.learn}“` : `“${figure.learn}”`) : figure.learn)
  : '';

const S = de
  ? {
      begin: `Mit ${figure.name} beginnen`,
      chapterWord: 'Kapitel',
      min: 'Min.',
      worldChapters: 'Kapitel',
      worldCouncils: 'Debatten',
      worldEdges: 'Ideen, die mit den Ideen anderer sprechen',
      noscript: 'Intro anhören (MP3)',
    }
  : {
      begin: `Begin with ${figure.name}`,
      chapterWord: 'Chapter',
      min: 'min',
      worldChapters: 'chapters',
      worldCouncils: 'debates',
      worldEdges: "ideas that talk to other people's ideas",
      noscript: 'Listen to the intro (MP3)',
    };

const metaLine = [figure.tradition, figure.period].filter(Boolean).join('  ·  ');
// No-JS fallback: a plain link to the raw trailer mp3, the same URL the island
// builds, so the SSR'd play button is never a dead end.
const trailerMp3 = getPublicTrailerUrl(figure.id, lang, 'mp3');
const chapterHref = `/app?figure=${slug}&lang=${lang}&mode=story&chapter=1`;

// The one gold door. It carries the figure, nothing else: the choosing place
// on the other side is where the visitor picks the path or their own question.
const beginHref = `/app?figure=${slug}&lang=${lang}`;

// Chapter one, from the produced catalogs: the title the twelve-chapter rail
// below uses for chapter 1 and the runtime the story file reports. Nothing is
// written by hand, and a figure missing either half drops that half.
const chapterTitle = cleanDisplayText(getSeedsFor(figure.id, lang)[0]?.title);
// Pages in the running search test keep the text estimate they launched with.
const chapterMinutes = frozen
  ? getStoryChapter(figure.id, lang, 1)?.minutes
  : chapterDisplayMinutes(figure.id, lang, 1);
let chapterBeat = `${S.chapterWord} 1`;
if (chapterTitle) chapterBeat += `: ${chapterTitle}`;
if (chapterMinutes) chapterBeat += ` · ${chapterMinutes} ${S.min}`;

// The size of this figure's world, counted from the data every build.
const world = getFigureWorld(figure.id, lang);
const worldLine = [
  `${capitalize(numberWord(world.chapters, lang))} ${S.worldChapters}.`,
  world.councils > 0 ? `${capitalize(numberWord(world.councils, lang))} ${S.worldCouncils}.` : '',
  world.connections > 0 ? `${capitalize(numberWord(world.connections, lang))} ${S.worldEdges}.` : '',
].filter(Boolean).join(' ');
---
<section class={frozen ? 'pub-fig-hero' : 'pub-fig-hero pub-fig-hero--answer'}>
  <figure class="pub-fig-hero__figure">
    <div class="pub-fig-hero__portrait">
      <FigurePortrait figureId={figure.id} name={figure.name} lang={lang} />
    </div>
    <figcaption class="pub-fig-hero__caption">{t('figures.echoGloss')}</figcaption>
  </figure>
  <div class="pub-fig-hero__text">
    <p class="pub-fig-hero__eyebrow">{t('figures.echoOf')}</p>
    <h1 class="pub-fig-hero__name">{figure.name}</h1>
    {metaLine && <p class="pub-fig-hero__meta">{metaLine}</p>}

    {heroAnswer && <p class="pub-fig-answer pub-fig-hero__answer">{heroAnswer}</p>}

    {!frozen && (
      <p class="fig-begin">
        <a
          class="fig-begin__button pub-cta__button"
          href={beginHref}
          data-agc-cta="start-exploring"
          data-agc-figure={figure.id}
          data-agc-door="fig_begin"
        >{S.begin}</a>
      </p>
    )}

    <FigureTrailer client:visible figureId={figure.id} lang={lang} chapterHref={chapterHref} />
    <noscript>
      <a class="pub-textlink" href={trailerMp3}>{S.noscript}</a>
    </noscript>

    {learnLine && <p class="pub-fig-hero__learn">{learnLine}</p>}

    <p class="fig-hero-chapter">
      <a
        class="fig-hero-chapter__link"
        href={chapterHref}
        data-agc-cta="start-exploring"
        data-agc-figure={figure.id}
        data-agc-door="fig_hero_chapter"
      >{chapterBeat}<span class="fig-hero-chapter__go" aria-hidden="true"> →</span></a>
    </p>

    {frozen && (
      <p class="fig-begin">
        <a
          class="fig-begin__button pub-cta__button"
          href={beginHref}
          data-agc-cta="start-exploring"
          data-agc-figure={figure.id}
          data-agc-door="fig_begin"
        >{S.begin}</a>
      </p>
    )}

    <p class="pub-fig-hero__world">{worldLine}</p>
    <p class="pub-fig-hero__caption pub-fig-hero__caption--end">{t('figures.echoGloss')}</p>
  </div>
</section>

<style is:global>
  /* The portrait and its caption travel together, so the disclosure reads as
     what it is: the note under the picture. */
  .pub-fig-hero__figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
    flex-shrink: 0;
  }
  .pub-fig-hero__caption {
    margin: 0.85rem 0 0;
    max-width: 30ch;
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
    font-size: 0.7rem;
    line-height: 1.6;
    letter-spacing: 0.02em;
    color: var(--text-dim);
  }
  /* Chapter one as a quiet door under the promise: it names the chapter and
     the runtime, and the click plays that chapter. */
  .fig-hero-chapter { margin: 1.2rem 0 0; }
  .fig-hero-chapter__link {
    display: inline-block;
    min-height: 44px;
    padding: 0.6rem 0;
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
    font-size: 0.82rem;
    line-height: 1.5;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color var(--transition-base);
  }
  .fig-hero-chapter__link:hover,
  .fig-hero-chapter__link:focus-visible { color: var(--gold-primary); }
  .fig-hero-chapter__go { color: var(--gold-deep); }
  /* The one gold door, the site's primary /app button fitted to the hero
     column. German names run long, so the label wraps instead of ragging. */
  .fig-begin { margin: 0.9rem 0 0; }
  .fig-begin__button {
    width: fit-content;
    max-width: 100%;
    padding: 0.85rem 1.7rem;
    border-radius: var(--plate-radius, 4px);
    white-space: normal;
    line-height: 1.3;
    text-wrap: balance;
  }
  /* The answer under the name: body text, so it reads left-aligned even where
     the phone hero centres everything else. */
  .pub-figure .pub-fig-hero .pub-fig-hero__answer {
    margin: 0.35rem 0 0;
    max-width: 62ch;
    font-family: var(--font-content, 'Libre Caslon Text', serif);
    font-size: 1.06rem;
    line-height: 1.72;
    color: var(--text-primary);
    text-align: left;
  }
  .pub-fig-hero--answer .fig-begin { margin-top: 1.3rem; }
  .pub-fig-hero--answer .pub-trailer { margin-top: 1.1rem; }
  .pub-fig-hero__world {
    margin: 1.1rem 0 0;
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
    font-size: 0.82rem;
    line-height: 1.6;
    letter-spacing: 0.04em;
    color: var(--text-tertiary);
  }
  /* The trailer's ending state is a link, not a button, so it needs the
     button's own box back. */
  a.pub-trailer--after {
    text-decoration: none;
    color: var(--gold-primary);
    border-color: color-mix(in srgb, var(--gold-primary) var(--a-45, 45%), transparent);
  }
  /* One caption, two homes: desktop keeps it under the portrait, phones show
     it at the hero's end instead. Exactly one is displayed per viewport, so
     assistive tech hears the disclosure once. */
  .pub-fig-hero__caption--end { display: none; }
  @media (max-width: 819.98px) {
    .pub-fig-hero__figure .pub-fig-hero__caption { display: none; }
    .pub-fig-hero__caption--end {
      display: block;
      margin: 1.1rem auto 0;
      text-align: center;
    }
  }
  @media (min-width: 820px) {
    /* the caption belongs to the portrait column, so it keeps its width */
    .pub-fig-hero__figure { align-items: flex-start; }
    .pub-fig-hero__caption { max-width: 340px; }
    /* with the answer the text column outgrows the portrait: both start at the top */
    .pub-fig-hero--answer { align-items: flex-start; }
  }
</style>
