---
// The merged landing hero: plate portrait, four-beat spine, one gold door,
// thirty-link shelf. Ships complete in markup (the ignition choreography in
// the client script only replays what is already here).
// The shelf anchors are real figure-page links; script intercepts clicks
// to re-key the hero in place.
import { getFiguresCatalog } from '@client/data/public/figuresCatalog';
import { figureIdToSlug } from '@client/data/public/slugMap';
import manifest from '@client/data/image-manifest.json';
import { figureImage, figureSrcset } from '../lib/figureImages';
import { getSeedsFor } from '../lib/seeds';
import { getStoryChapter } from '../lib/stories';
import { cleanDisplayText } from '../lib/figureWorld';
import type { Lang } from '../i18n';
import { PORTRAIT_CREDIT, portraitAlt } from '../lib/portraitCredit';
import PortraitCredit from './PortraitCredit.astro';
import '../styles/night-hero.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const de = lang === 'de';
const figuresRev = (manifest as { figuresRev?: string }).figuresRev ?? '';

// DE display names where the product uses the exonym. Everything else keeps
// the catalog name in both languages.
const DE_NAMES: Record<string, string> = { aurelius: 'Mark Aurel', plato: 'Platon' };

// Desktop shows ONE exact row (19 fill the shell) of the priority figures;
// the full thirty stay in the markup and on the phone's swipe rail, and
// "Meet all thirty" carries the rest. Rows are per language: the German
// shelf leads with the German-language thinkers German search demand
// actually names. Edit these lists to recast a row.
const PRIORITY_EN = [
  'aurelius', 'jung', 'kahlo', 'nietzsche', 'gautama', 'dickinson', 'rumi',
  'laozi', 'einstein', 'lovelace', 'shakespeare', 'vinci', 'angelou',
  'tubman', 'king', 'campbell', 'schopenhauer', 'woolf', 'plato',
];
const PRIORITY_DE = [
  'aurelius', 'jung', 'nietzsche', 'goethe', 'eckhart', 'bingen',
  'schopenhauer', 'kahlo', 'einstein', 'gautama', 'laozi', 'rumi',
  'dickinson', 'mozart', 'beauvoir', 'shakespeare', 'vinci', 'campbell',
  'king',
];
const PRIORITY = de ? PRIORITY_DE : PRIORITY_EN;

const figures = getFiguresCatalog().map((f) => ({
  id: f.id,
  slug: figureIdToSlug[f.id],
  name: de ? (DE_NAMES[f.id] ?? f.name) : f.name,
  priority: PRIORITY.includes(f.id),
}));

const figuresBase = de ? '/de/figures/' : '/figures/';

// Chapter one, per figure, straight out of the produced catalogs: the title
// the twelve-chapter ledger already uses for chapter n (seed n) and the
// runtime the story file reports. Nothing here is written by hand, and a
// figure missing either half simply drops that half of the line.
const chapterWord = de ? 'Kapitel' : 'Chapter';
const minWord = de ? 'Min.' : 'min';
function chapterOneBeat(id: string): string {
  const title = cleanDisplayText(getSeedsFor(id, lang)[0]?.title);
  const minutes = getStoryChapter(id, lang, 1)?.minutes;
  let line = `${chapterWord} 1`;
  if (title) line += `: ${title}`;
  if (minutes) line += ` · ${minutes} ${minWord}`;
  return line;
}
// Handed to the client script so a shelf pick re-keys the beat from the same
// build-time data instead of a second, hand-kept table.
const chapterBeats = Object.fromEntries(figures.map(f => [f.id, chapterOneBeat(f.id)]));

// The default figure the page ships with. Strings match the client script's
// table for aurelius, so the first re-key swaps nothing.
const S = de
  ? {
      eyebrow: 'Stimmen aus der ganzen Geschichte',
      h1a: 'Kurze Geschichten',
      h1b: 'übers Leben',
      sub: 'Lerne von 30 bemerkenswerten Menschen, von Mark Aurel bis Frida Kahlo.',
      name: 'Mark Aurel',
      trad: 'Stoizismus',
      play: 'Das Echo hören',
      qkick: 'Wohin sein Weg führt',
      promise: 'Du lernst, deine erste Reaktion zu hinterfragen.',
      chapKick: 'Sein erstes Kapitel',
      chap: chapterOneBeat('aurelius'),
      begin: 'Mit Mark Aurel beginnen',
      free: '30 kostenlose Nachrichten pro Tag. Ohne Anmeldung.',
      disc: 'Ein Echo, keine Aufnahme. Gemalt, nicht fotografiert.',
      trust: 'Gemeinnützig · Open Source · Keine Tracking-Cookies, kein Profiling',
      shelf: 'Dreißig Leben. Wähle ein Gesicht.',
      entryA: 'Alle dreißig ansehen',
      entryAshort: 'Alle 30',
    }
  : {
      eyebrow: 'Voices from across history',
      h1a: 'Short stories',
      h1b: 'about life',
      sub: "Learn from 30 of history's remarkable people, Marcus Aurelius to Frida Kahlo.",
      name: 'Marcus Aurelius',
      trad: 'Stoicism',
      play: 'Hear the Echo',
      qkick: 'Where his path leads',
      promise: 'You will learn to question your first reaction.',
      chapKick: 'His first chapter',
      chap: chapterOneBeat('aurelius'),
      begin: 'Begin with Marcus Aurelius',
      free: '30 free messages a day. No signup needed.',
      disc: 'An Echo, not a recording. Painted, not photographed.',
      trust: 'Nonprofit · Open Source · No tracking cookies, no profiling',
      shelf: 'Thirty lives. Pick a face.',
      entryA: 'Meet all thirty',
      entryAshort: 'All 30',
    };

---
<script is:inline>
  /* Returning-visitor forward: a browser that already holds the app's local
     consent record skips the marketing homepage (progress is origin-scoped,
     only the entry URL differs between a restored and a fresh window). Once
     per tab, so a deliberate revisit stays. ?stay=1 keeps the homepage and
     pins the tab. No script, blocked storage or no record: the page renders
     as for any first visit. It adds nothing to the address and counts
     nothing. */
  (function () {
    try {
      var q = new URLSearchParams(location.search);
      if (q.has('stay') || sessionStorage.getItem('agc_home') === '1') {
        sessionStorage.setItem('agc_home', '1');
        return;
      }
      if (!localStorage.getItem('agb_consent')) return;
      sessionStorage.setItem('agc_home', '1');
      var qs = q.toString();
      location.replace('/app/' + (qs ? '?' + qs : ''));
    } catch (e) {
      /* fall through to the homepage */
    }
  })();
</script>

<script is:inline>
  /* Pre-paint marker: hands the painting to the motion layer. No script and
     reduced motion both keep the finished hero, nothing is ever hidden. */
  (function () {
    if (/motion=still/.test(location.search)) return;
    if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.documentElement.classList.add('settling');
  })();
</script>

<div class="mh" data-figrev={figuresRev} data-chapters={JSON.stringify(chapterBeats)} data-credit-en={PORTRAIT_CREDIT.en} data-credit-de={PORTRAIT_CREDIT.de}>
  <section class="hero" aria-labelledby="h1">
    <canvas class="dustlayer" id="dust" aria-hidden="true"></canvas>
    <div class="wrap">
      <div class="headcol">
        <p class="caps eyebrow" id="eyebrow">{S.eyebrow}</p>
        <h1 id="h1">{S.h1a} <i>{S.h1b}</i></h1>
        <p class="sub" id="sub">{S.sub}</p>
      </div>

      <div class="artcol">
        <figure class="pplate" data-credit-group>
          <div class="mat">
            <img
              class="shot"
              id="shot"
              alt={portraitAlt(S.name, lang)}
              crossorigin="anonymous"
              fetchpriority="high"
              decoding="async"
              src={figureImage('aurelius', 'main', 900)}
              srcset={figureSrcset('aurelius', 'main', [600, 900, 1200])}
              sizes="(max-width: 899px) 100vw, 46vw"
            />
            <span class="mat__scrim" aria-hidden="true"></span>
            <span class="mat__lamp" aria-hidden="true"></span>
            <span class="mat__veil" aria-hidden="true"></span>
          </div>
          <figcaption class="pcap">
            <span class="pcap__nm"><span class="pcap__echo">{de ? 'Echo von' : 'Echo of'}</span> <span id="nm">{S.name}</span></span>
            <span class="pcap__tr caps" id="tr">{S.trad}</span>
            <PortraitCredit lang={lang} class="pcap__credit" />
          </figcaption>
        </figure>
      </div>

      <div class="beatscol">
        <ol class="beats">
          <li>
            <button class="play" id="play" type="button" aria-pressed="false">
              <span class="play__disc">
                <svg id="icoPlay" viewBox="0 0 12 14" aria-hidden="true"><path d="M0 0l12 7-12 7z"/></svg>
                <svg id="icoPause" viewBox="0 0 12 14" hidden aria-hidden="true"><path d="M0 0h4v14H0zM8 0h4v14H8z"/></svg>
              </span>
              <span id="playLbl">{S.play}</span>
              <span class="play__t" id="playT"></span>
            </button>
          </li>
          <li class="labelled">
            <p class="caps blabel" id="qkick">{S.qkick}</p>
            <p class="promise" id="promise"><em>{S.promise}</em></p>
          </li>
          <li class="labelled">
            <p class="caps blabel" id="chapKick">{S.chapKick}</p>
            <a
              class="chapter"
              id="chapDoor"
              href={`/app?figure=${figureIdToSlug['aurelius']}&lang=${lang}&mode=story&chapter=1`}
              data-agc-cta="start-exploring"
              data-agc-figure="aurelius"
              data-agc-door="hero_chapter"
            >
              <span id="chapTxt">{S.chap}</span><span class="chapter__go">&rarr;</span>
            </a>
          </li>
          <li class="beat--door">
            <a
              class="begin pub-cta__button"
              id="begin"
              href={`/app?figure=${figureIdToSlug['aurelius']}&lang=${lang}`}
              data-agc-cta="start-exploring"
              data-agc-figure="aurelius"
              data-agc-door="home_begin"
            >
              <span id="beginLbl">{S.begin}</span>
            </a>
          </li>
        </ol>

        <div class="fine">
          <div class="fine__col">
            <p class="free" id="free">{S.free}</p>
            <p class="disc" id="discl">{S.disc}</p>
            <p class="trust" id="trust">{S.trust}</p>
          </div>
        </div>
      </div>

      <div class="shelf shelfcol" data-credit-group>
        <p class="caps shelfcap">
          <span class="shelfcap__t" id="shelfLbl">{S.shelf}</span>
          <a class="entryA" id="entryA" href={figuresBase}>
            <span id="entryAlong">{S.entryA}</span><span id="entryAshort" hidden>{S.entryAshort}</span> &rarr;
          </a>
        </p>
        <div class="rail" id="rail">
          {figures.map((f) => (
            <a
              href={`${figuresBase}${f.slug}/`}
              class={f.priority ? undefined : 'rail__more'}
              data-id={f.id}
              aria-label={f.name}
              title={f.name}
              aria-current={f.id === 'aurelius' ? 'true' : undefined}
            >
              <img src={figureImage(f.id, 'thumbnail', 160)} alt={portraitAlt(f.name, lang)} loading="lazy" decoding="async" />
            </a>
          ))}
        </div>
        <PortraitCredit lang={lang} class="shelf__credit" heard />
      </div>
    </div>

    <audio id="au" crossorigin="anonymous" preload="none"></audio>
  </section>
</div>

<script src="../scripts/agora-hero.js"></script>

<style is:global>
  /* The plate's credit under its caption's right end, the shelf's one line under the faces. */
  .pcap { flex-wrap: wrap; row-gap: 0; }
  .pcap .pcap__credit { flex-basis: 100%; margin-top: 0; text-align: right; }
  .shelf .shelf__credit { margin-top: 0.4rem; text-align: left; }
  /* The one gold door. It is the site's primary /app button (.pub-cta__button),
     re-fitted to the hero's spine: the plate radius of the surrounding skin, a
     width that follows its own label, and the ignition's cool state. */
  .mh .begin {
    width: fit-content;
    /* the shortest name is four letters, and a gold chip that narrow stops
       reading as the page's one door */
    min-width: 15rem;
    max-width: 100%;
    padding: 0.85rem 1.7rem;
    border-radius: var(--plate-radius);
    line-height: 1.3;
    text-wrap: balance;
  }
  /* the last beat lands, so it gets a breath the others do not */
  .mh .beats > li.beat--door { margin-top: 0.3rem; }
  /* the node belongs on the plate, not above it */
  .mh .beats > li.beat--door::before { top: 21px; }

  /* Ignition beat two: the stream off the portrait used to write a question.
     It writes this label now, so the plate stays quiet until the gold lands. */
  .settling .mh .begin {
    transition: background 0.5s ease, color 0.5s ease, box-shadow 0.5s ease,
      transform 0.25s ease;
  }
  .settling .mh .begin.cool {
    background: var(--bg-card);
    color: var(--text-secondary);
    box-shadow: inset 0 0 0 1px var(--keyline);
  }
  .settling .mh .begin w {
    opacity: 0.13;
    filter: blur(1.6px);
    transition: opacity 0.34s ease, filter 0.34s ease;
  }
  .settling .mh .begin w.in { opacity: 1; filter: none; }

  @media (max-width: 899px) {
    /* full width on a phone: the reading column is narrow and German names run
       long, so the door takes the column instead of ragging inside it */
    .mh .begin {
      width: 100%;
      min-width: 0;
      padding: 0.8rem 1rem;
      font-size: 0.9rem;
    }
    .mh .beats > li.beat--door { margin-top: 0.2rem; }
    .mh .beats > li.beat--door::before { top: 19px; }
  }
</style>
