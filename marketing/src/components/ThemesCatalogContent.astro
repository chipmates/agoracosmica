---
// The themes index routes, the theme pages sell. Eight life questions as
// type, then the question of the day, then the 55 council questions grouped
// under the question they belong to: the first three of each group open, the
// rest one tap away, and the whole pool served in the markup either way. The
// cards stay type and hairline ink; the page's one plate is the opening
// council's own, and it sits directly over the door that opens it.

import Breadcrumbs from './Breadcrumbs.astro';
import ThemeCard from './ThemeCard.astro';
import ThemeCTA from './ThemeCTA.astro';
import ThemePlate from './ThemePlate.astro';
import PlateLightbox from './PlateLightbox.astro';
import QuestionDoors from './QuestionDoors.astro';
import type { DoorItem } from './QuestionDoors.astro';
import QuestionOfTheDay from '../islands/QuestionOfTheDay';
import ThemeStyles from './ThemeStyles.astro';
import { getT } from '../i18n';
import type { Lang } from '../i18n';
import { publicUrl } from '../lib/urls';
import {
  THEMES,
  councilCatalog,
  councilsByTheme,
  getThemeCouncilsRanked,
  getLocalizedQuestion,
  COUNCIL_SEQUENCE,
} from '@client/data/councilCatalog';
import { getThemeVoices } from '@client/data/public/themeVoices';
import { figureIdToSlug } from '@client/data/public/slugMap';
import { localizedShortName } from './figureNames';
import { runtimeMinutes } from '../lib/councilRuntime';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getT(lang);

// The answer-first paragraph names all eight questions by reading them
// straight out of the theme strings, so both languages stay in step.
const eightQuestions = THEMES.map(theme => t(`themes.${theme.id}.question`));
const indexAnswer = [
  t('themes.indexAnswerLead'),
  ...eightQuestions,
  t('themes.indexAnswerClose'),
].join(' ');

// Three per group stay open. The rest sit one tap behind a panel, in the
// markup the whole time, and the group's own theme page carries them all as
// working doors with the answers around them.
const OPEN_PER_GROUP = 3;
const groups = THEMES.map(theme => {
  const items = getThemeCouncilsRanked(theme.id).map<DoorItem>(c => ({
    councilId: c.id,
    question: getLocalizedQuestion(c, lang),
    figureId: c.moderator.id,
  }));
  return {
    theme,
    question: t(`themes.${theme.id}.question`),
    items,
    head: items.slice(0, OPEN_PER_GROUP),
    tail: items.slice(OPEN_PER_GROUP),
  };
});
const totalQuestions = groups.reduce((n, g) => n + g.items.length, 0);

const moreQuestionsLabel = (n: number): string =>
  lang === 'de' ? `Die anderen ${n} Fragen` : `The other ${n} questions`;

// Build-day pick, so the panel is a real question before JS runs. The island
// re-picks against the visitor's own day once it hydrates.
const flat = groups.flatMap(g => g.items);
const buildDay = Math.floor(Date.now() / 86_400_000);
const seed = flat[buildDay % flat.length];
const seedSlug = figureIdToSlug[seed.figureId] || seed.figureId;
const qotdInitial = {
  question: seed.question,
  who: t('themes.askDoor', 'Ask {name}').replace('{name}', localizedShortName(seed.figureId, lang)),
  href: `/app?figure=${seedSlug}&q=${seed.councilId}&lang=${lang}`,
  figureId: seed.figureId,
};

// The programme's own opening station carries the page CTA.
const opener = councilCatalog.find(c => c.id === COUNCIL_SEQUENCE[0]) ?? councilCatalog[0];

// The page opens on Jerome in the wilderness, from the council named for what
// this catalog is: the question behind every question. It is not the opener's
// plate on purpose: the closing band is, and the two would say the same thing
// twice.
const OPENING_PLATE = 'the-question-behind-every-question';

// The deep pages a big question can land on: one idea worked out at length,
// or a poet's own text. Language-specific, because these exist per language
// rather than as translated twins.
const deeperHeading = lang === 'de' ? 'Eine Frage, ganz ausgearbeitet' : 'One idea, worked out in full';
const deeper = lang === 'de'
  ? [
      { label: 'Die Heldenreise', href: '/de/heldenreise/' },
      { label: 'Stoizismus', href: '/de/stoizismus/' },
      { label: 'Platons Höhlengleichnis', href: '/de/figures/plato/hoehlengleichnis/' },
      { label: 'Platons Ideenlehre', href: '/de/figures/plato/ideenlehre/' },
    ]
  : [
      { label: "The hero's journey", href: '/the-heros-journey/' },
      { label: 'Stoicism', href: '/stoicism/' },
      { label: 'Talk to historical figures', href: '/talk-to-historical-figures/' },
      { label: "Emily Dickinson's poems", href: '/figures/emily-dickinson/poems/' },
      { label: "William Blake's poems", href: '/figures/william-blake/poems/' },
      { label: "Shakespeare's sonnets", href: '/figures/william-shakespeare/sonnets/' },
      { label: "Rumi's poems", href: '/figures/rumi/poems/' },
    ];
---
<ThemeStyles />
<div class="pub-content tq-index">
  <Breadcrumbs lang={lang} items={[{ label: t('breadcrumbs.themes') }]} />

  <header class="tq-index__head">
    <h1 class="tq-index__title">{t('themes.indexTitle')}</h1>
    <p class="tq-answer">{indexAnswer}</p>
    <p class="tq-index__ai">
      {lang === 'de'
        ? 'Jede Stimme in diesen Debatten ist ein KI-Echo. Deutungen, keine Aufnahmen.'
        : 'Every voice in these councils is an AI Echo. Interpretations, not recordings.'}
    </p>
  </header>

  <ThemePlate councilId={OPENING_PLATE} ink="house" lang={lang} />

  <section class="tq-section tq-cards-section">
    <p class="tq-note">{t('themes.indexOpenLine')}</p>
    <div class="tq-cards">
      {THEMES.map(theme => (
        <ThemeCard
          themeId={theme.id}
          councilCount={councilsByTheme[theme.id]?.length || 0}
          voiceCount={getThemeVoices(theme.id, lang).length}
          lang={lang}
        />
      ))}
    </div>
  </section>

  <section class="tq-section">
    <h2 class="tq-h2">
      {t('themes.questionsLabel').replace('55', String(totalQuestions))}
    </h2>
    <p class="tq-note">{t('themes.questionsCaption')}</p>

    <QuestionOfTheDay
      client:idle
      initial={qotdInitial}
      label={t('themes.qotdLabel')}
      caption={t('themes.qotdCaption')}
      poolSelector=".tq-pool .tq-door"
    />

    <div class="tq-pool">
      {groups.map(group => (
        <div class="tq-pool__group">
          <h3 class="tq-pool__head">
            <a class="tq-pool__link" href={publicUrl(lang, `/themes/${group.theme.id}`)}>
              {group.question}
            </a>
          </h3>
          <QuestionDoors items={group.head} lang={lang} door="themes_question" />
          {group.tail.length > 0 && (
            <details class="tq-pool__more">
              <summary class="tq-pool__summary">
                <span>{moreQuestionsLabel(group.tail.length)}</span>
                <span class="tq-pool__arrow" aria-hidden="true">▼</span>
              </summary>
              <QuestionDoors items={group.tail} lang={lang} door="themes_question" />
            </details>
          )}
        </div>
      ))}
    </div>
  </section>

  <section class="tq-section">
    <h2 class="tq-h2">{deeperHeading}</h2>
    <ul class="tq-readon">
      {deeper.map(link => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
  </section>

  <section class="tq-section">
    <p class="tq-note">
      <a class="pub-textlink" href={publicUrl(lang, '/figures')}>{t('themes.allFigures')}</a>
    </p>
  </section>

  <ThemePlate councilId={opener.id} ink="house" lang={lang} />

  <!-- The index closes on the one thing it can hand over whole. The daily
       question above stays the page's only featured ask door. -->
  <ThemeCTA
    lang={lang}
    councilId={opener.id}
    question={getLocalizedQuestion(opener, lang)}
    figureId={opener.moderator.id}
    minutes={runtimeMinutes(opener.id, lang)}
    showAsk={false}
  />
</div>

<PlateLightbox lang={lang} />

<style is:global>
  .tq-index { padding-bottom: 2.5rem; }
  .tq-index__head { max-width: 42rem; margin: 0 auto 2.5rem; }
  .tq-index__title {
    margin: 0 0 1.25rem;
    font-family: var(--font-content, 'Libre Caslon Text', serif);
    font-weight: var(--weight-bold);
    font-size: clamp(1.9rem, 1.4rem + 2.2vw, 2.6rem);
    line-height: 1.15;
    color: var(--gold-subtle);
    text-wrap: balance;
  }
  .tq-index__ai {
    margin: 1rem 0 0;
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
    font-size: var(--text-sm);
    color: var(--text-tertiary);
  }
  .tq-index .tq-section { max-width: 42rem; margin: 0 auto 2.75rem; }
  /* The catalog block breathes wider than the reading column. */
  .tq-index .tq-section.tq-cards-section { max-width: 54rem; }

  .tq-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 0.75rem;
  }

  /* Deep-page rail. Same shape as the figures index closer list. */
  .tq-readon {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0.8rem 0 0;
    padding: 0;
    list-style: none;
  }
  .tq-readon a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
    font-size: var(--text-sm);
    color: var(--gold-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .tq-readon a:hover { color: var(--gold-hover); }

  .tq-pool { display: flex; flex-direction: column; gap: 1.75rem; }
  .tq-pool__group { display: flex; flex-direction: column; gap: 0.4rem; }
  .tq-pool__head { margin: 0 0 0.2rem; }

  /* The rest of a group's questions: one tap away, always in the markup. */
  .tq-pool__more > summary { list-style: none; cursor: pointer; }
  .tq-pool__more > summary::-webkit-details-marker { display: none; }
  .tq-pool__summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    color: var(--gold-primary);
  }
  .tq-pool__summary:hover { color: var(--gold-hover); }
  .tq-pool__arrow {
    font-size: 0.7rem;
    color: var(--gold-deep);
    transition: transform var(--transition-fast);
  }
  .tq-pool__more[open] .tq-pool__arrow { transform: rotate(180deg); }
  .tq-pool__more[open] .tq-doors { margin-top: 0.4rem; }
  .tq-pool__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-content, 'Libre Caslon Text', serif);
    font-weight: var(--weight-bold);
    font-size: var(--text-md);
    color: var(--gold-subtle);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--gold-subtle) var(--a-30), transparent);
  }
  .tq-pool__link:hover { color: var(--gold-hover); }

  /* Question of the day */
  .tq-qotd {
    margin: 0 0 2rem;
    padding: 1.25rem 1.4rem;
    border: 1px solid color-mix(in srgb, var(--gold-subtle) var(--a-20), transparent);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--bg-card) var(--a-60), transparent);
  }
  .tq-qotd__label {
    margin: 0 0 0.55rem;
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
    font-size: 0.6875rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold-deep);
  }
  .tq-qotd__q {
    margin: 0;
    font-family: var(--font-content, 'Libre Caslon Text', serif);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: var(--text-primary);
  }
  .tq-qotd__door {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 0.6rem;
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold-primary);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--gold-primary) var(--a-35), transparent);
    align-self: flex-start;
  }
  .tq-qotd__door:hover { color: var(--gold-hover); }
  .tq-qotd__caption {
    margin: 0.75rem 0 0;
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }
</style>
