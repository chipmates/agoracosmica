---
// Breadcrumb navigation (visible markup only). The BreadcrumbList JSON-LD is
// emitted by each page template via the `schemas` prop, so this component must
// NOT emit its own: doing so produced a second, conflicting BreadcrumbList on
// every figure/theme/catalog page (the template's was correct and complete;
// this one dropped the leaf and pointed Home at /figures).

import { getT } from '../i18n';
import type { Lang } from '../i18n';
import { figureListUrl, publicUrl } from '../lib/urls';

export interface BreadcrumbItem {
  label: string;
  /** Omit for the current page (last item). */
  path?: string;
}

interface Props {
  items: BreadcrumbItem[];
  lang: Lang;
}

const { items, lang } = Astro.props;
const t = getT(lang);

const allItems: BreadcrumbItem[] = [
  { label: t('breadcrumbs.home'), path: '/' },
  ...items,
];
// The figure list went into the landing (its address forwards there), so its crumb links the landing's list.
const hrefFor = (path: string): string =>
  path.replace(/\/$/, '') === '/figures' ? figureListUrl(lang) : publicUrl(lang, path);
---
<nav aria-label="Breadcrumb" class="pub-breadcrumbs">
  <ol>
    {allItems.map((item, i) => (
      <li>
        {i > 0 && <span class="pub-breadcrumbs__sep" aria-hidden="true">/</span>}
        {item.path ? (
          <a href={hrefFor(item.path)}>{item.label}</a>
        ) : (
          <span aria-current="page">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  /* 44px targets; zero specificity, so the figure pages' own rule wins there. Each
     padding is taken back by an equal negative margin, so no line moves, even when
     the path wraps. The box reaches mostly up into the free space above, and
     sideways half the space between two names; the first link also grows left and
     the last one right over its separator, so short words reach 44px without
     covering another target. */
  :global(:where(nav.pub-breadcrumbs) a) {
    display: inline-flex;
    align-items: flex-start;
    min-height: 44px;
    padding: 20px 0.375rem 7px;
    margin: -20px -0.375rem -7px;
  }
  :global(:where(nav.pub-breadcrumbs li:first-child) > a) {
    padding-left: 1rem;
    margin-left: -1rem;
  }
  :global(:where(nav.pub-breadcrumbs li:has(+ li > [aria-current])) > a) {
    padding-right: 0.75rem;
    margin-right: -0.75rem;
  }
</style>
