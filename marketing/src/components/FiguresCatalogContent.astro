---
import Breadcrumbs from './Breadcrumbs.astro';
import FigureCard from './FigureCard.astro';
import ContentVolume from './ContentVolume.astro';
import PublicCTA from './PublicCTA.astro';
import { getStrataUi } from './figureStrata';
import { getT } from '../i18n';
import type { Lang } from '../i18n';
import { getFiguresCatalog } from '@client/data/public/figuresCatalog';
import './figures-index.css';

interface Props {
  lang: Lang;
  /** Skip the header block (breadcrumb, h1, stats, description, lead) when the
   *  page renders those itself, e.g. the figures orbit hero. */
  gridOnly?: boolean;
}

const { lang, gridOnly = false } = Astro.props;
const t = getT(lang);
const ui = getStrataUi(lang);

// Sort by surname (last meaningful name part), with a handful of overrides
// for figures whose name doesn't map cleanly to a Western surname pattern.
const surnameOverrides: Record<string, string> = {
  laozi: 'Laozi',
  beauvoir: 'Beauvoir',
  bingen: 'Bingen',
  vinci: 'Vinci',
  zenji: 'Dogen',
  goethe: 'Goethe',
  king: 'King',
  gautama: 'Gautama',
  rumi: 'Rumi',
  plato: 'Plato',
};

function getSurname(f: { id: string; name: string }): string {
  if (surnameOverrides[f.id]) return surnameOverrides[f.id];
  const parts = f.name.split(' ');
  return parts[parts.length - 1];
}

const figures = [...getFiguresCatalog(lang)].sort((a, b) =>
  getSurname(a).localeCompare(getSurname(b), lang),
);
---
<div class={gridOnly ? 'fx-block fx-az' : 'pub-content'} id="a-z">
  {!gridOnly && (
    <Fragment>
      <Breadcrumbs lang={lang} items={[{ label: t('breadcrumbs.figures') }]} />

      <h1 class="pub-hero__title">{t('figures.pageTitle')}</h1>
      <ContentVolume lang={lang} />
      <p class="pub-section__text">
        {t('figures.pageDescription')}
      </p>
    </Fragment>
  )}

  <!-- The alphabet is the page's crawlable spine: thirty links, one tap from
       the era bar, present whichever way a visitor is browsing. -->
  <h2 class="pub-section__title">{ui.azHeading}</h2>
  <p class="pub-section__text pub-catalog-lead">{ui.azLead}</p>

  <div class="pub-grid pub-grid--3">
    {figures.map(figure => (
      <FigureCard figure={figure} lang={lang} headingLevel={gridOnly ? 'h3' : 'h2'} />
    ))}
  </div>
  {!gridOnly && <PublicCTA variant="inline" lang={lang} />}
</div>

<style>
  .pub-catalog-lead { margin-bottom: 2rem; }
</style>
