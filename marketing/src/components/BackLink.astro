---
// The one way back to a page's parent, shown at the top under the breadcrumb and
// again at the end. The label is the parent's own heading, never a new word; the
// look is the figure page's end button (48px tall), its chevron turned back.

interface Props {
  href: string;
  /** The parent's own heading (or the front's word for it). */
  label: string;
  at: 'top' | 'end';
}

const { href, label, at } = Astro.props;
---
<div class:list={['pub-back', `pub-back--${at}`]}>
  <a class="pub-back__link" href={href} data-back-link={at}>{label}</a>
</div>

<style>
  .pub-back {
    display: flex;
  }
  .pub-back--top {
    margin: 0 0 1.5rem;
  }
  /* Under a breadcrumb, pulled up; the margins collapse, so a heading with its
     own top margin keeps it and one without gets this gap. */
  :global(.pub-breadcrumbs) + .pub-back--top {
    margin: -0.625rem 0 1.25rem;
  }
  .pub-back--end {
    margin: 2.5rem 0 0;
  }
  .pub-back__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;
    max-width: 100%;
    padding: 0.375rem 1.125rem;
    box-sizing: border-box;
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0;
    text-align: left;
    color: var(--gold-primary);
    text-decoration: none;
    background: color-mix(in srgb, var(--gold-primary) 4%, var(--bg-primary));
    border: 1px solid color-mix(in srgb, var(--gold-primary) 42%, transparent);
    border-radius: 6px;
    transition: border-color var(--transition-fast, 150ms ease), background-color var(--transition-fast, 150ms ease);
  }
  .pub-back__link::before {
    content: '';
    flex: none;
    width: 7px;
    height: 7px;
    border-top: 2px solid currentColor;
    border-right: 2px solid currentColor;
    transform: rotate(-135deg);
  }
  /* At the end, as wide as the figure page's own end button. */
  .pub-back--end .pub-back__link {
    flex: 1 1 auto;
    max-width: 460px;
    justify-content: center;
  }
  .pub-back__link:hover {
    color: var(--gold-primary);
    border-color: var(--gold-primary);
    background: color-mix(in srgb, var(--gold-primary) 9%, var(--bg-primary));
    text-decoration: none;
  }
  .pub-back__link:focus-visible {
    outline: 2px solid var(--gold-hover);
    outline-offset: 2px;
  }
</style>
