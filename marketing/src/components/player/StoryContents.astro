---
// The twelve stories as a contents list keyed by year: each row is one button
// that plays its story, rendered here so search and a slow phone see the list
// before any script. The controller marks the playing row (a band, a ring,
// minutes left) and the finished ones (a quiet check).
import { getChapterFactcheck } from '../../lib/factchecks';
import { cleanFactText, numberWord } from '../../lib/figureWorld';
import { figureMinutes } from '../../lib/storyRuntime';
import { playerStrings } from '../../player/strings';
import type { PlayerLang } from '../../player/strings';
import type { StoryQueue } from '../../player/types';

interface Props {
  figureId: string;
  slug: string;
  lang: PlayerLang;
  queue: StoryQueue;
}

const { figureId, slug, lang, queue } = Astro.props;
const P = playerStrings(lang);


const rows = queue.entries.map(entry => {
  const fc = getChapterFactcheck(figureId, lang, entry.n);
  return { ...entry, age: cleanFactText(fc?.age) };
});

// One era for the whole life drops out of the year column; the hero's dates
// and each row's spoken name carry it.
const ERAS = [' AD', ' n. Chr.'];
const era = ERAS.find(e => rows.length > 0 && rows.every(r => (r.year ?? '').endsWith(e)));
const yearShown = (year: string | undefined) => (year ? (era ? year.slice(0, -era.length) : year) : '');

const total = figureMinutes(figureId, lang);
const lead = P.tocLead(rows[0]?.age ?? '', rows[rows.length - 1]?.age ?? '', total ? P.totalTime(total) : '');
---
<section class="sp-toc" id="stories" aria-labelledby="sp-toc-title">
  <h2 class="sp-toc__title" id="sp-toc-title">{P.tocTitle(numberWord(rows.length, lang))}</h2>
  <p class="sp-toc__lead">{lead}</p>
  <ol class="sp-rows">
    {rows.map(r => {
      const shown = yearShown(r.year);
      const approx = shown.startsWith('~');
      const details = [r.year ? P.approxYear(r.year) : '', r.place ?? '', r.age ? P.ageAt(r.age) : '', r.minutes ? P.minutes(r.minutes) : '']
        .filter(Boolean);
      return (
        <li class="sp-row" id={`idea-${r.n}`}>
          <button
            type="button"
            class="sp-row__btn story-play story-play--row"
            data-story-play
            data-story-n={r.n}
            data-story-minutes={r.minutes ?? undefined}
            aria-pressed="false"
            aria-label={P.rowAria(r.n, r.title, details)}
          >
            <span class="sp-row__year" aria-hidden="true">{approx ? <><span class="sp-row__approx">~</span>{shown.slice(1)}</> : shown}</span>
            <span class="sp-row__body">
              <span class="sp-row__title">{r.title}</span>
              <span class="sp-row__where">{[r.place, r.age ? P.ageAt(r.age) : ''].filter(Boolean).join(' · ')}{r.minutes && <span class="sp-row__min" data-story-min>{P.minutes(r.minutes)}</span>}</span>
            </span>
            <span class="sp-row__end">
              {r.minutes && <span class="sp-row__min" data-story-min>{P.minutes(r.minutes)}</span>}
              <span class="sp-row__glyph" aria-hidden="true">
                <svg class="sp-ring sp-ring--row" viewBox="0 0 36 36" focusable="false">
                  <circle class="sp-ring__track" cx="18" cy="18" r="16.5" />
                  <circle class="sp-ring__run" cx="18" cy="18" r="16.5" pathLength="100" data-story-ring />
                  <circle class="sp-ring__wait" cx="18" cy="18" r="16.5" pathLength="100" />
                </svg>
                <span class="sp-row__core">
                  <svg class="story-play__icon story-play__icon--play" viewBox="0 0 24 24" focusable="false"><path d="M8.2 5.3v13.4c0 .5.5.8.9.5l10.3-6.7a.6.6 0 0 0 0-1L9.1 4.8c-.4-.3-.9 0-.9.5z" /></svg>
                  <svg class="story-play__icon story-play__icon--pause" viewBox="0 0 24 24" focusable="false"><rect x="6.6" y="5" width="3.8" height="14" rx="1" /><rect x="13.6" y="5" width="3.8" height="14" rx="1" /></svg>
                  <svg class="sp-row__check" viewBox="0 0 24 24" focusable="false"><path d="M5 12.6l4.4 4.4L19 7.4" /></svg>
                </span>
              </span>
            </span>
          </button>
        </li>
      );
    })}
  </ol>

  <button type="button" class="story-autonext" data-story-autonext aria-pressed="true">
    <span class="story-autonext__box" aria-hidden="true">
      <svg viewBox="0 0 24 24" focusable="false"><path d="M5 12.6l4.4 4.4L19 7.4" /></svg>
    </span>
    <span>{P.autoNext}</span>
  </button>

  {rows.some(r => r.documented || r.recreated) && (
    <details class="sp-ledger">
      <summary>
        <span>{P.ledgerTitle}</span>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M6 9.5l6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </summary>
      <dl>
        {rows.filter(r => r.documented || r.recreated).map(r => (
          <div class="sp-ledger__item">
            <dt>{[r.year, r.title].filter(Boolean).join(' · ')}</dt>
            {r.documented && <dd><span class="sp-ledger__key">{P.documented}:</span> {r.documented}</dd>}
            {r.recreated && <dd><span class="sp-ledger__key">{P.recreated}:</span> {r.recreated}</dd>}
          </div>
        ))}
      </dl>
    </details>
  )}

  <p class="story-applink">
    <a
      class="pub-textlink"
      href={`/app?figure=${slug}&lang=${lang}&mode=story&chapter=1`}
      data-agc-cta="start-exploring"
      data-agc-figure={figureId}
      data-agc-door="fig_app_read"
    >{P.appLink}</a>
  </p>
</section>
