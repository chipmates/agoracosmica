---
// The introduction and the twelve stories as the book's contents, keyed by
// year, rendered here so search and a slow phone see the list before any
// script. A tap on a row unfolds it (listen, read, facts, share) and plays
// nothing. The panels carry no story text and no facts: the story's first
// line and the facts are fetched when the visitor opens them.
import { numberWord } from '../../lib/figureWorld';
import { figureMinutes } from '../../lib/storyRuntime';
import { LIST_SEP, playerStrings } from '../../player/strings';
import { factWords } from '../../player/factWords';
import type { PlayerLang } from '../../player/strings';
import type { StoryQueue } from '../../player/types';

interface Props {
  figureId: string;
  slug: string;
  lang: PlayerLang;
  queue: StoryQueue;
}

const { figureId, slug, lang, queue } = Astro.props;
const P = playerStrings(lang);
const W = factWords(lang);
const stories = queue.entries.filter(e => e.n > 0);

// One era for the whole life drops out of the year column; the hero's dates
// and each row's spoken name carry it.
const ERAS = [' AD', ' n. Chr.'];
const era = ERAS.find(e => stories.length > 0 && stories.every(r => (r.year ?? '').endsWith(e)));
const yearShown = (year: string | undefined) => (year ? (era ? year.slice(0, -era.length) : year) : '');

const total = figureMinutes(figureId, lang);
const lead = P.tocLead(stories[0]?.age ?? '', stories[stories.length - 1]?.age ?? '', total ? P.totalTime(total) : '', !!queue.she);
---
<section class="sp-toc" id="stories" aria-labelledby="sp-toc-title">
  <h2 class="sp-toc__title" id="sp-toc-title">{P.tocTitle(numberWord(stories.length, lang))}</h2>
  <p class="sp-toc__lead">{lead}</p>
  <div class="sp-toc__tools">
    <div class="sp-viewswitch" role="group" aria-label={P.viewAria}>
      <button type="button" data-story-view="list" aria-pressed="true">{P.listView}</button>
      <button type="button" data-story-view="map" aria-pressed="false">{P.mapView}</button>
    </div>
    <button type="button" class="sp-savedbtn" data-story-saved-open hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.5 4h11v16l-5.5-4-5.5 4z" /></svg>
      <span data-saved-count></span>
    </button>
  </div>
  <ol class="sp-rows">
    {queue.entries.map(r => {
      const intro = r.n === 0;
      const shown = yearShown(r.year);
      const approx = shown.startsWith('~');
      const details = intro
        ? [r.minutes ? P.minutes(r.minutes) : '']
        : [r.year ? P.approxYear(r.year) : '', r.place ?? '', r.age ? P.ageAt(r.age) : '', r.minutes ? P.minutes(r.minutes) : ''];
      const sub = intro
        ? (r.minutes ? P.introRowSub(r.minutes) : '')
        : [r.place, r.age ? P.ageAt(r.age) : '', r.minutes ? P.minutes(r.minutes) : ''].filter(Boolean).join(LIST_SEP);
      return (
        <li class:list={['sp-row', intro && 'sp-row--intro']} id={`idea-${r.n}`} data-n={r.n}>
          <button
            type="button"
            class="sp-row__btn"
            id={`story-${r.n}`}
            data-story-row={r.n}
            aria-expanded="false"
            aria-controls={`sp-panel-${r.n}`}
            aria-label={P.rowAria(r.n, r.title, details.filter(Boolean))}
          >
            <span class="sp-row__year" aria-hidden="true">
              {intro ? (
                <svg class="sp-row__scroll" viewBox="0 0 24 24" focusable="false"><path d="M7 4h11v13a3 3 0 0 1-3 3H6" /><path d="M7 4a2.5 2.5 0 0 0-2.5 2.5V8H7" /><path d="M6 20a3 3 0 0 0 3-3v-1H3v1a3 3 0 0 0 3 3z" /><path d="M10 8.5h5M10 12h5" /></svg>
              ) : approx ? (
                <><span class="sp-row__approx">{P.approxYear('~').trim()}</span>{shown.slice(1).trim()}</>
              ) : shown}
            </span>
            <span class="sp-row__body">
              <span class="sp-row__title">{r.title}</span>
              {sub && <span class="sp-row__sub">{sub}</span>}
            </span>
            <span class="sp-row__state" aria-hidden="true">
              <svg class="sp-ring sp-ring--row" viewBox="0 0 24 24" focusable="false">
                <circle class="sp-ring__track" cx="12" cy="12" r="9" />
                <circle class="sp-ring__run" cx="12" cy="12" r="9" pathLength="100" data-story-ring />
              </svg>
              <svg class="sp-row__check" viewBox="0 0 24 24" focusable="false"><path d="M5 12.6l4.4 4.4L19 7.4" /></svg>
            </span>
            <svg class="sp-row__chev" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9.5l6 6 6-6" /></svg>
          </button>
          <div class="sp-row__panel" id={`sp-panel-${r.n}`} hidden data-nosnippet>
            <div class="sp-acts">
              <button type="button" class="sp-act sp-act--main" data-story-play data-story-n={r.n} data-door="row_listen" data-state="idle">
                <span class="sp-act__disc" aria-hidden="true">
                  <svg class="story-play__icon story-play__icon--play" viewBox="0 0 24 24" focusable="false"><path d="M8.2 5.3v13.4c0 .5.5.8.9.5l10.3-6.7a.6.6 0 0 0 0-1L9.1 4.8c-.4-.3-.9 0-.9.5z" /></svg>
                  <svg class="story-play__icon story-play__icon--pause" viewBox="0 0 24 24" focusable="false"><rect x="6.6" y="5" width="3.8" height="14" rx="1" /><rect x="13.6" y="5" width="3.8" height="14" rx="1" /></svg>
                </span>
                <span class="sp-act__words">
                  <span class="sp-act__t" data-act-t>{P.listen}</span>
                  <span class="sp-act__s" data-act-s>{r.minutes ? P.minutes(r.minutes) : ''}</span>
                </span>
              </button>
              <button type="button" class="sp-act" data-story-read={r.n} data-door="row_read">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 6.6C9.7 5 6.6 4.7 3.5 5.6v12.8c3.1-.9 6.2-.6 8.5 1M12 6.6c2.3-1.6 5.4-1.9 8.5-1v12.8c-3.1-.9-6.2-.6-8.5 1M12 6.6v12.8" /></svg>
                <span>{P.read}</span>
              </button>
              <button type="button" class="sp-act" data-story-facts={r.n} data-door="row_facts">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8.5" /><path d="M8.2 12.3l2.6 2.6 5-5.2" /></svg>
                <span>{W.facts}</span>
              </button>
              <button type="button" class="sp-act" data-story-share={r.n} data-door="row_share">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 15V4" /><path d="M8 7.5L12 3.5l4 4" /><path d="M6 11v8.5h12V11" /></svg>
                <span>{P.share}</span>
              </button>
            </div>
          </div>
        </li>
      );
    })}
  </ol>

  <p class="story-applink">
    <a
      class="pub-textlink"
      href={`/app?figure=${slug}&lang=${lang}&mode=story&chapter=1`}
      data-agc-cta="start-exploring"
      data-agc-figure={figureId}
      data-agc-door="fig_app_read"
    >{P.appLink}</a>
  </p>
</section>
