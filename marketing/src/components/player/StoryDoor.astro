---
// The story door under a poem: the figure's introduction and story 1 begin
// here, on the poem's own page. The plate and the dock are the figure page's
// player; the queue sits under its own attribute, so the consent card keeps
// the poem's moment on this page.
import { getFigureById } from '@client/data/public/figuresCatalog';
import { numberWord } from '../../lib/figureWorld';
import { publicUrl } from '../../lib/urls';
import { VOICE_DESC_ID, labelHalves, playerStrings } from '../../player/strings';
import { storyLabel } from '../../player/label';
import { buildStoryQueue } from '../../player/queue';
import type { PlayerLang } from '../../player/strings';

interface Props {
  figureId: string;
  slug: string;
  lang: PlayerLang;
}

const { figureId, slug, lang } = Astro.props;
const P = playerStrings(lang);
const name = getFigureById(figureId, lang)?.name ?? '';
const queue = buildStoryQueue(figureId, slug, name, lang);
const queueJson = JSON.stringify(queue).replace(/</g, '\\u003c');
const intro = queue.entries.find(e => e.n === 0);
const first = queue.entries.find(e => e.n === 1);
const storyCount = queue.entries.filter(e => e.n > 0).length;
const countWord = numberWord(storyCount, lang);
const idleWhat = intro?.minutes && first ? P.beginSubWith(intro.minutes, first.title) : first?.title ?? '';
const label = storyLabel(lang);
const halves = labelHalves(label.brief);
---
<aside class="sp-door" aria-labelledby="sp-door-title" data-nosnippet>
  <script is:inline type="application/json" data-story-door-queue set:html={queueJson} />
  <h2 class="sp-door__title" id="sp-door-title">{P.doorTitle(name, countWord)}</h2>
  <p class="sp-door__note">{P.retellingNote(!!queue.she)}</p>
  <details class="story-label sp-label">
    <summary>
      <span class="sp-label__i" aria-hidden="true">i</span>
      <span class="sp-label__brief">{halves.map((half, i) => (
        <Fragment>{i > 0 ? ' ' : ''}<span class="sp-label__half">{half}</span></Fragment>
      ))}</span>
    </summary>
    <p>{label.expanded}</p>
  </details>
  <div class="sp-plate-wrap">
    <button
      type="button"
      class="sp-plate story-play story-play--hero"
      data-story-play
      data-story-n={intro ? 0 : 1}
      data-story-hero-plate
      data-idle-what={idleWhat}
      data-door="poem_plate"
      data-state="idle"
      aria-pressed="false"
      aria-describedby={VOICE_DESC_ID}
    >
      <span class="sp-disc" aria-hidden="true">
        <svg class="sp-ring" viewBox="0 0 64 64" focusable="false">
          <circle class="sp-ring__track" cx="32" cy="32" r="30.5" />
          <circle class="sp-ring__run" cx="32" cy="32" r="30.5" pathLength="100" data-story-ring />
          <circle class="sp-ring__wait" cx="32" cy="32" r="30.5" pathLength="100" />
        </svg>
        <span class="sp-disc__core">
          <svg class="story-play__icon story-play__icon--play" viewBox="0 0 24 24" focusable="false"><path d="M8.2 5.3v13.4c0 .5.5.8.9.5l10.3-6.7a.6.6 0 0 0 0-1L9.1 4.8c-.4-.3-.9 0-.9.5z" /></svg>
          <svg class="story-play__icon story-play__icon--pause" viewBox="0 0 24 24" focusable="false"><rect x="6.6" y="5" width="3.8" height="14" rx="1" /><rect x="13.6" y="5" width="3.8" height="14" rx="1" /></svg>
        </span>
      </span>
      <span class="sp-plate__text">
        <span class="sp-plate__do" data-wait={P.loading}><span class="sp-plate__now" data-story-hero-do>{P.begin}</span></span>{' '}
        <span class="sp-plate__what" data-story-hero-what>{idleWhat}</span>
      </span>
    </button>
    <p class="sp-startover" data-story-startover hidden>
      <button type="button" class="sp-textlink" data-story-play data-story-n={intro ? 0 : 1} data-story-from="0" data-door="poem_start_over" aria-describedby={VOICE_DESC_ID}>{P.startOver}</button>
    </p>
  </div>
  <p class="sp-hero__links">
    <button type="button" class="sp-textlink" data-story-read={intro ? 0 : 1} data-door="poem_read">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 6.6C9.7 5 6.6 4.7 3.5 5.6v12.8c3.1-.9 6.2-.6 8.5 1M12 6.6c2.3-1.6 5.4-1.9 8.5-1v12.8c-3.1-.9-6.2-.6-8.5 1M12 6.6v12.8" /></svg>
      <span>{P.readInstead}</span>
    </button>
    <a class="sp-textlink" href={publicUrl(lang, `/figures/${slug}/`)} data-door="poem_all_stories">{P.allStories(countWord)}</a>
  </p>
</aside>
