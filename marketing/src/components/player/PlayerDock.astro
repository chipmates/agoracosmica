---
// The dock's mount point. The router keeps this element, and the island in it,
// across page changes, so it must render with the same id on every player page.
import StoryDock from '../../islands/StoryDock';
import { storyLabel } from '../../player/label';
import { factWords } from '../../player/factWords';
import { localizedShortName } from '../figureNames';
import { getFiguresCatalog } from '@client/data/public/figuresCatalog';
import type { PlayerLang } from '../../player/strings';

interface Props {
  lang: PlayerLang;
  /** False on a page outside the player's router (the poem door): the dock lives with that page. */
  persist?: boolean;
  /** A page's own label words (the landing's), both languages; the app's label where none is given. */
  label?: Record<PlayerLang, { brief?: string; expanded?: string }>;
}

const { lang, persist = true, label } = Astro.props;
const own = (l: PlayerLang) => ({ ...storyLabel(l), ...label?.[l] });
const labels = { en: own('en'), de: own('de') };
// The app's own words for the facts, both languages: the dock outlives a language switch.
const facts = { en: factWords('en'), de: factWords('de') };
// The bar's name where the full one does not fit: the short name the rail uses, its first word when it is still long.
const barName = (id: string, l: PlayerLang): string => {
  const short = localizedShortName(id, l);
  return short.length > 14 ? short.split(' ')[0] ?? short : short;
};
// One plain string ("id=English|German;..."), only where a short name differs: the props ride on every player page.
const fullName = (id: string, l: PlayerLang): string => getFiguresCatalog(l).find(f => f.id === id)?.name ?? '';
const shortNames = getFiguresCatalog('en')
  .map(f => [f.id, barName(f.id, 'en'), barName(f.id, 'de')] as const)
  .filter(([id, en, de]) => en !== fullName(id, 'en') || de !== fullName(id, 'de'))
  .map(([id, en, de]) => `${id}=${en}|${de}`)
  .join(';');
---
{persist ? (
  <div class="story-dock-mount" transition:persist="story-dock">
    <StoryDock client:load lang={lang} labels={labels} facts={facts} shortNames={shortNames} />
  </div>
) : (
  <div class="story-dock-mount">
    <StoryDock client:load lang={lang} labels={labels} facts={facts} shortNames={shortNames} />
  </div>
)}
