---
// The title page of a player figure: who this is in a line, that these are
// retellings, the label, and one plate that begins with the introduction,
// story 1 following. The plate is the player in place: page.ts turns its
// words into the state (pause, minutes left, a kept place on return). Under
// it one quiet line: the text without sound, and the figure's own writing.
import { getPublicImageSrcSet, getPublicImageUrl } from '@client/utils/public/publicMediaUrl';
import { numberWord } from '../../lib/figureWorld';
import { VOICE_DESC_ID, playerStrings } from '../../player/strings';
import LabelItems from './LabelItems.astro';
import { storyLabel } from '../../player/label';
import { keepCompounds, keepRanges, metaShown } from '../../player/storyFields';
import { heroLine, ownWords } from '../../player/figureCopy';
import type { PlayerLang } from '../../player/strings';
import type { StoryQueue } from '../../player/types';

interface Props {
  figureId: string;
  name: string;
  lang: PlayerLang;
  meta: string;
  leadAnswer: string;
  queue: StoryQueue;
}

const { figureId, name, lang, meta, leadAnswer, queue } = Astro.props;
const P = playerStrings(lang);
const label = storyLabel(lang);
const first = queue.entries[0];
const intro = queue.entries.find(e => e.n === 0);
const doText = P.begin;
const whatText = intro?.minutes ? P.beginSub(intro.minutes) : [first?.title, first?.minutes ? P.minutes(first.minutes) : ''].filter(Boolean).join(' · ');
// The alt names the picture as an AI image; the label below names the images for the eye.
const alt = `${name}, ${P.portraitNote}`;
const own = ownWords(figureId, lang);
const storyCount = queue.entries.filter(e => e.n > 0).length;
---
<section class="sp-hero" aria-labelledby="sp-name" data-story-hero>
  <div class="sp-hero__id">
    <div class="sp-hero__names">
      <h1 class="sp-hero__name" id="sp-name">{name}</h1>
      {meta && <p class="sp-hero__meta">{keepRanges(metaShown(meta)).map(p => (p.keep ? <span class="sp-nb">{p.text}</span> : p.text))}</p>}
    </div>
    <figure class="sp-hero__portrait">
      <picture>
        <source type="image/webp" srcset={getPublicImageSrcSet(figureId, 'thumbnail', 'webp')} sizes="(min-width: 1024px) 132px, 104px" />
        <img
          src={getPublicImageUrl(figureId, 'thumbnail', 320, 'png')}
          alt={alt}
          width="320"
          height="320"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </figure>
  </div>
  <p class="sp-hero__line">{heroLine(figureId, lang, leadAnswer)}</p>
  <p class="sp-hero__note">{keepCompounds(P.heroNote(numberWord(storyCount, lang), !!queue.she)).map(p => (p.keep ? <span class="sp-nb">{p.text}</span> : p.text))}</p>

  <div class="sp-plate-wrap">
    <button
      type="button"
      class="sp-plate story-play story-play--hero"
      data-story-play
      data-story-n={first?.n ?? 0}
      data-story-hero-plate
      data-door="hero_plate"
      data-state="idle"
      aria-pressed="false"
      aria-describedby={VOICE_DESC_ID}
    >
      <span class="sp-disc" aria-hidden="true">
        <svg class="sp-ring" viewBox="0 0 64 64" focusable="false">
          <circle class="sp-ring__track" cx="32" cy="32" r="30.5" />
          <circle class="sp-ring__run" cx="32" cy="32" r="30.5" pathLength="100" data-story-ring />
          <circle class="sp-ring__wait" cx="32" cy="32" r="30.5" pathLength="100" />
        </svg>
        <span class="sp-disc__core">
          <svg class="story-play__icon story-play__icon--play" viewBox="0 0 24 24" focusable="false"><path d="M8.2 5.3v13.4c0 .5.5.8.9.5l10.3-6.7a.6.6 0 0 0 0-1L9.1 4.8c-.4-.3-.9 0-.9.5z" /></svg>
          <svg class="story-play__icon story-play__icon--pause" viewBox="0 0 24 24" focusable="false"><rect x="6.6" y="5" width="3.8" height="14" rx="1" /><rect x="13.6" y="5" width="3.8" height="14" rx="1" /></svg>
        </span>
      </span>
      <span class="sp-plate__text">
        <span class="sp-plate__do" data-wait={P.loading}><span class="sp-plate__now" data-story-hero-do>{doText}</span></span>{' '}
        <span class="sp-plate__what" data-story-hero-what>{whatText}</span>
      </span>
    </button>
    <p class="sp-startover" data-story-startover hidden>
      <button type="button" class="sp-textlink" data-story-play data-story-n={first?.n ?? 0} data-story-from="0" data-door="hero_start_over" aria-describedby={VOICE_DESC_ID}>{P.startOver}</button>
    </p>
  </div>
  <p class="sp-hero__links">
    <button type="button" class="sp-textlink" data-story-read={first?.n ?? 0} data-door="hero_read">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 6.6C9.7 5 6.6 4.7 3.5 5.6v12.8c3.1-.9 6.2-.6 8.5 1M12 6.6c2.3-1.6 5.4-1.9 8.5-1v12.8c-3.1-.9-6.2-.6-8.5 1M12 6.6v12.8" /></svg>
      <span>{P.readInstead}</span>
    </button>
    {own && (
      <a class="sp-textlink sp-textlink--own" href={own.href} data-door="hero_own_words">
        <span>{own.label}{own.note && <span class="sp-textlink__note">{own.note}</span>}</span>
      </a>
    )}
  </p>
  {/* the label closes the first screen, under the links: away from the picture and the words, still before any play */}
  <details class="story-label sp-label">
    <summary>
      <span class="sp-label__i" aria-hidden="true">i</span>
      {/* the label breaks at its middle dots; an item wider than the line (200 % text) at its hyphens */}
      <span class="sp-label__brief"><LabelItems brief={label.brief} half="sp-label__half" sr="sp-sr" /></span>
    </summary>
    <p>{label.expanded}</p>
  </details>
</section>
