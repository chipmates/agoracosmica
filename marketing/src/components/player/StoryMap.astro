---
// The map of the stories: the app's Wisdom Map plate (client WisdomMapModal, atlas mode) drawn at build time.
// The twelve stories sit on the app's twelve stars, placed by the app's own layout and path functions; the
// introduction is one star more, a step before story 1 on the path. The sky is CSS (player.css), the ink is this
// SVG, the cartouche carries the name. page.ts marks heard, playing and started stars and the next one, and a star
// opens its story (its row on a desktop, a card under the plate on a phone); without script a star links to its row.
import {
  CONSTELLATION_PATTERNS,
  calculateConstellationPaths,
  calculateConstellationPositions,
} from '@client/components/ZodiacConstellation';
import constellationsDe from '@client/assets/translations/constellations/de.json';
import { getFigureById } from '@client/data/public/figuresCatalog';
import { cleanDisplayText } from '../../lib/figureWorld';
import { playerStrings } from '../../player/strings';
import { inLifeOrder } from '../../player/queue';
import type { PlayerLang } from '../../player/strings';
import type { StoryQueue } from '../../player/types';

interface Props {
  figureId: string;
  lang: PlayerLang;
  queue: StoryQueue;
}

const { figureId, lang, queue } = Astro.props;
const P = playerStrings(lang);
const enName = getFigureById(figureId, 'en')?.name ?? '';
const constellation = CONSTELLATION_PATTERNS[`Echo of ${enName}`];
const stories = queue.entries.filter(e => e.n > 0);
const hasIntro = queue.entries.some(e => e.n === 0);

// The app keys its German names by the English name in camel case ("The Stoic Taurus" -> theStoicTaurus).
function nameKey(name: string): string {
  const words = name.replace(/[^A-Za-z ]/g, '').split(/\s+/).filter(Boolean);
  return words.map((w, i) => (i === 0 ? w.toLowerCase() : w[0]!.toUpperCase() + w.slice(1).toLowerCase())).join('');
}
const deNames = (constellationsDe as { constellations?: { names?: Record<string, string> } }).constellations?.names ?? {};
const mapName = constellation ? cleanDisplayText(lang === 'de' ? deNames[nameKey(constellation.name)] ?? constellation.name : constellation.name) : '';

type Pt = [number, number];
const pattern = (constellation?.pattern ?? []).slice(0, stories.length) as Pt[];

// The plate in viewBox units, one unit a CSS pixel on a 390 px phone (the plate is 358 px there).
const W = 360;
const TOP = 34; // room for a "next" label over the top row
const FIT_H = 330; // the box the app's layout fits the figure into
const VIA_Y = TOP + FIT_H + 18;
const H = VIA_Y + 116; // the cartouche's band under the via
const SIDE = 14; // the fit's box stands in from the plate's sides, so a "next" ring keeps clear of the frame
const FIT_W = W - 2 * SIDE;
const NUM_DY = -27; // a story's number, centred this far over its star

// The introduction: a step before story 1, against the path's direction (story 2 to story 1), as long as the path's
// usual step; turned in 15 degree steps until it stands clear of every star, and its "next" ring (r 24) on the
// plate clear of every story's number (else the first spot clear of the stars).
function introPoints(): Pt[] {
  const [p1, p2] = pattern;
  if (!p1 || !p2) return [];
  const steps = pattern.slice(1).map((p, i) => Math.hypot(p[0] - pattern[i]![0], p[1] - pattern[i]![1])).sort((a, b) => a - b);
  const len = (steps[Math.floor(steps.length / 2)] ?? 10) * 0.85;
  const base = Math.atan2(p1[1] - p2[1], p1[0] - p2[0]);
  const out: Pt[] = [];
  for (let k = 0; k < 24; k++) {
    const a = base + Math.ceil(k / 2) * (Math.PI / 12) * (k % 2 ? 1 : -1);
    const q: Pt = [p1[0] + Math.cos(a) * len, p1[1] + Math.sin(a) * len];
    if (pattern.every(p => Math.hypot(p[0] - q[0], p[1] - q[1]) >= len * 0.8)) out.push(q);
  }
  return out;
}
function ringClearOfNumbers(q: Pt): boolean {
  const pts = [q, ...pattern];
  const f = calculateConstellationPositions(pts.map((_, i) => ({ id: String(i), gathered: false })), { name: '', description: '', pattern: pts }, { width: FIT_W, height: FIT_H }, { marginFactor: 0.86 });
  const xy = f.seedPositions.map(p => [(p.coordX / 100) * FIT_W + SIDE, (p.coordY / 100) * FIT_H + TOP] as Pt);
  const [ix, iy] = xy[0]!;
  return xy.slice(1).every(([x, y], j) => {
    const w = j + 1 >= 10 ? 13 : 7;
    const dx = Math.max(x - w / 2 - ix, 0, ix - x - w / 2);
    const dy = Math.max(y + NUM_DY - 8 - iy, 0, iy - y - NUM_DY - 2.5);
    return Math.hypot(dx, dy) >= 27;
  });
}
const introCands = hasIntro ? introPoints() : [];
const intro = introCands.find(ringClearOfNumbers) ?? introCands[0] ?? null;
const points: Pt[] = intro ? [intro, ...pattern] : pattern;
const numbers = intro ? [0, ...stories.map(s => s.n)] : stories.map(s => s.n);
const seeds = points.map((_, i) => ({ id: String(numbers[i]), gathered: false }));
const fit = points.length > 1
  ? calculateConstellationPositions(seeds, { name: constellation?.name ?? '', description: '', pattern: points }, { width: FIT_W, height: FIT_H }, { marginFactor: 0.86 })
  : null;
const at: Pt[] = (fit?.seedPositions ?? []).map(p => [(p.coordX / 100) * FIT_W + SIDE, (p.coordY / 100) * FIT_H + TOP]);
const segments = fit
  ? calculateConstellationPaths(fit.seedPositions, fit.boundingBox, points, { width: FIT_W, height: FIT_H }, { name: '', description: '', pattern: points })
      .map(s => ({ x1: s.x1 + SIDE, y1: s.y1 + TOP, x2: s.x2 + SIDE, y2: s.y2 + TOP }))
  : [];
const r1 = (v: number) => Math.round(v * 10) / 10;
// A star's tap area (r 25) stops halfway to its nearest neighbour, so where stars stand close (a ladder) each
// star is still tapped at its own centre rather than under the next star's area.
const hitR = at.map(([x, y], i) => Math.min(25, ...at.filter((_, j) => j !== i).map(([u, v]) => Math.floor(Math.hypot(u - x, v - y) * 5) / 10)));

// The app's graticule (three arcs, two bent meridians) and its via sapientiae, for this plate.
const grat = [
  ...[0.22, 0.5, 0.78].map(fy => { const y = H * fy; return `M0 ${r1(y + 14)}Q${W / 2} ${r1(y - 14)} ${W} ${r1(y + 14)}`; }),
  ...[0.3, 0.7].map(fx => { const x = W * fx; return `M${r1(x)} 0Q${r1(x + (fx - 0.5) * -36)} ${H / 2} ${r1(x)} ${H}`; }),
];
const via = `M${r1(-W * 0.05)} ${r1(VIA_Y + 10)}Q${W / 2} ${r1(VIA_Y - 18)} ${r1(W * 1.05)} ${r1(VIA_Y + 10)}`;

// Labels beside the stars, placed at build time: the plate numbers at one place over their stars, the introduction's
// name beside its star, then each star's "next" tag where it stands clear of every label.
type Box = { l: number; t: number; r: number; b: number };
const STAR_R = 16;
const starBoxes: Box[] = at.map(([x, y]) => ({ l: x - STAR_R, t: y - STAR_R, r: x + STAR_R, b: y + STAR_R }));
const overlap = (a: Box, c: Box) => Math.max(0, Math.min(a.r, c.r) - Math.max(a.l, c.l)) * Math.max(0, Math.min(a.b, c.b) - Math.max(a.t, c.t));
const gap = (a: Box, c: Box) => Math.hypot(Math.max(0, a.l - c.r, c.l - a.r), Math.max(0, a.t - c.b, c.t - a.b));
const grow = (a: Box, x: number, y: number): Box => ({ l: a.l - x, t: a.t - y, r: a.r + x, b: a.b + y });
// a label keeps SIDE units from the plate's sides: a desktop's frame line stands 13 px in (about 10 units there)
const outside = (a: Box) => Math.max(0, SIDE - a.l) + Math.max(0, a.r - (W - SIDE)) + Math.max(0, 4 - a.t) + Math.max(0, a.b - (VIA_Y - 6));
const segBoxes: Box[] = segments.flatMap(s => {
  // a line as a few small boxes along it, so a label keeps off the ink
  const n = Math.max(2, Math.round(Math.hypot(s.x2 - s.x1, s.y2 - s.y1) / 10));
  return Array.from({ length: n - 1 }, (_, k) => {
    const t = (k + 1) / n; const x = s.x1 + (s.x2 - s.x1) * t; const y = s.y1 + (s.y2 - s.y1) * t;
    return { l: x - 2, t: y - 2, r: x + 2, b: y + 2 };
  });
});
// what a label costs on the plate: other stars, the lines, the edge
const ink = (i: number, a: Box) => starBoxes.reduce((s, sb, j) => s + (j === i ? 0 : overlap(a, sb)), 0) * 4
  + segBoxes.reduce((s, sb) => s + overlap(a, sb), 0) + outside(a) * 400;
type Spot = { dx: number; dy: number; anchor: 'start' | 'end' | 'middle' };
type Pick = { c: Spot; score: number };
function place(i: number, cands: Spot[], boxOf: (i: number, c: Spot) => Box, score: (a: Box) => number): Pick {
  let best: Pick | null = null;
  for (const c of cands) {
    const s = score(boxOf(i, c));
    if (!best || s < best.score) best = { c, score: s };
  }
  return best!;
}
// The plate numbers first: one fixed place for every star, centred above it and over a "next" ring's top (r 24), so a
// number never reads as its neighbour's.
const numberBox: (Box | null)[] = at.map(([x, y], i) => {
  if (numbers[i] === 0) return null;
  const w = numbers[i]! >= 10 ? 13 : 7;
  return { l: x - w / 2, t: y + NUM_DY - 10 * 0.8, r: x + w / 2, b: y + NUM_DY + 10 * 0.25 };
});
const numbersBut = (i: number): Box[] => numberBox.filter((b, j): b is Box => b !== null && j !== i);
// Then the introduction's name, beside its star where that is clear, under it otherwise; it keeps off the star's own
// "next" ring, so it stays put whichever star is next.
const introAt = numbers.indexOf(0);
const NAME_W = 7.4 * P.introTitle.length;
function nameBox(i: number, c: Spot): Box {
  const [x, y] = at[i]!;
  const l = c.anchor === 'start' ? x + c.dx : c.anchor === 'end' ? x + c.dx - NAME_W : x + c.dx - NAME_W / 2;
  return { l, t: y + c.dy - 13 * 0.8, r: l + NAME_W, b: y + c.dy + 13 * 0.25 };
}
const introPick = introAt < 0 ? null : (() => {
  const [x, y] = at[introAt]!;
  const dy = 37; // under a "next" ring's foot (r 24)
  const cands: Spot[] = [
    { dx: 27, dy: 4, anchor: 'start' }, { dx: -27, dy: 4, anchor: 'end' },
    { dx: 0, dy, anchor: 'middle' }, { dx: -12, dy, anchor: 'start' }, { dx: 12, dy, anchor: 'end' },
    { dx: 0, dy: -29, anchor: 'middle' },
    { dx: 20, dy: 30, anchor: 'start' }, { dx: -20, dy: 30, anchor: 'end' },
    { dx: -12, dy: -29, anchor: 'start' }, { dx: 12, dy: -29, anchor: 'end' },
  ];
  const hard = [...numbersBut(introAt).map(b => grow(b, 9, 6)), { l: x - 26, t: y - 26, r: x + 26, b: y + 26 }];
  return place(introAt, cands, nameBox, a => ink(introAt, a) + hard.reduce((s, pb) => s + overlap(a, pb), 0) * 8);
})();
const introBox = introPick ? nameBox(introAt, introPick.c) : null;
// Last the "next" tag (one star at a time), never on a leader: it keeps every number, its own included, a line
// (13 units) above and below and half a figure (4) beside, and the introduction's name the same; it stands nearer its
// own ring than any other star's label. Its box is the ink at its larger size (11 units at 380 px and under).
const KEEP_X = 4;
const KEEP_Y = 13;
const TAG_W = 10.2 * [...P.nextTag].length;
function tagBox(i: number, c: Spot): Box {
  const [x, y] = at[i]!;
  const l = c.anchor === 'start' ? x + c.dx : c.anchor === 'end' ? x + c.dx - TAG_W : x + c.dx - TAG_W / 2;
  return { l: l - 1.5, t: y + c.dy - 10, r: l + TAG_W + 1.5, b: y + c.dy + 0.5 };
}
// nearest the ring first, on the side away from the plate's right edge (the app's 62 % rule)
function nextCands(i: number): Spot[] {
  const first = at[i]![0] / W > 0.62 ? -1 : 1;
  const S = (dx: number, dy: number): Spot[] => [first, -first].map(s => ({ dx: s * dx, dy, anchor: s > 0 ? 'start' : 'end' }));
  const M = (dx: number, dy: number): Spot => ({ dx, dy, anchor: 'middle' });
  const q = Math.round(TAG_W / 5);
  return [
    ...S(30, 4), // beside the ring, at the star's height
    M(0, 38), M(q, 38), M(-q, 38), // under the ring
    ...S(22, -22), ...S(22, 31), // at the ring's shoulders
    ...S(30, 24), ...S(30, -16), // beside it, a line lower or higher
    M(0, -50), M(q, -50), M(-q, -50), // over its own number, a line above it
    ...[-38, -46, 46, 62, -54, 70].flatMap(dy => S(38, dy)), // further out on the diagonals
  ];
}
const marks = (i: number): Box[] => [...numberBox.filter((b): b is Box => b !== null), ...(i !== introAt && introBox ? [grow(introBox, 2, 2)] : [])];
function tagScore(i: number, L: Box): number {
  const [x, y] = at[i]!; const star = { l: x, t: y, r: x, b: y };
  let s = ink(i, L);
  // never through another star, over the plate's edge, on its own ring or on the introduction's own name
  if (starBoxes.some((sb, j) => j !== i && overlap(L, sb) > 40) || outside(L) > 0.5 || gap(L, star) < 26
    || (i === introAt && introBox && overlap(L, grow(introBox, 3, 3)) > 0)) s += 1e7;
  const ring = Math.max(0, gap(grow(L, -5, -2), star) - 24);
  let near = Infinity;
  for (const k of marks(i)) {
    const o = overlap(L, grow(k, KEEP_X, KEEP_Y));
    if (o > 0) s += 1e6 + o * 1000;
    if (k !== numberBox[i]) near = Math.min(near, gap(L, k));
  }
  if (near <= ring + 2) s += 1e5 + (ring + 2 - near) * 100;
  return s;
}
// Where no spot clears the margins (a long tag among close stars), the app's diagonal spot, as the earlier rule chose it.
function earlierPick(i: number): Pick {
  const first = at[i]![0] / W > 0.62 ? -1 : 1;
  const hard = numbersBut(i);
  const cands: Spot[] = [-38, -46, 46, 62].flatMap(dy => [first, -first].map(s => ({ dx: s * 38, dy, anchor: s > 0 ? 'start' : 'end' } as Spot)));
  return place(i, cands, tagBox, L => ink(i, L) + hard.reduce((s, pb) => s + overlap(L, pb), 0) * 8);
}
const nextAt = at.map((_, i) => {
  const p = place(i, nextCands(i), tagBox, L => tagScore(i, L));
  return (p.score < 1e6 ? p : earlierPick(i)).c;
});
const numberAt = at.map((_, i) => (i === introAt && introPick ? introPick.c : { dx: 0, dy: NUM_DY, anchor: 'middle' } as Spot));

const title = (n: number) => stories.find(e => e.n === n)?.title ?? '';
// The map's note where the stories' years do not follow the life's order (a placeholder for the writer).
const mapNoteLoose = lang === 'de'
  ? 'Jeder Stern ist eine Geschichte. Wähle einen Stern, und die Geschichte öffnet sich.'
  : 'Each star is one story. Choose a star and the story opens.';
---
{constellation && at.length > 1 && (
  <section class="sp-mapwrap" aria-labelledby="sp-map-title" data-nosnippet>
    <div class="sp-atlas">
      <div class="sp-atlas__sky" aria-hidden="true"></div>
      <svg class="sp-map sp-atlas__plate" data-story-map viewBox={`0 0 ${W} ${H}`} role="group" aria-labelledby="sp-map-title">
        <g class="sp-atlas__ink" aria-hidden="true">
          {grat.map(d => <path class="sp-atlas__grat" d={d} />)}
          <path class="sp-atlas__via" d={via} />
          <text class="sp-atlas__vialabel" x={r1(W * 0.4)} y={r1(VIA_Y - 14)}>via sapientiae</text>
          {segments.map(s => <line class="sp-atlas__line" x1={r1(s.x1)} y1={r1(s.y1)} x2={r1(s.x2)} y2={r1(s.y2)} />)}
          {segments.map((s, i) => (
            <line class="sp-map__link" data-link={`${numbers[i]}-${numbers[i + 1]}`} x1={r1(s.x1)} y1={r1(s.y1)} x2={r1(s.x2)} y2={r1(s.y2)} />
          ))}
        </g>
        {at.map(([cx, cy], i) => {
          const n = numbers[i]!;
          const num = numberAt[i]!;
          const nx = nextAt[i]!;
          const lx = cx + nx.dx; const ly = cy + nx.dy;
          return (
            <a class:list={['sp-star', n === 0 && 'sp-star--intro']} href={`#story-${n}`} data-story-star={n}
              aria-label={P.rowAria(n, n === 0 ? P.introTitle : title(n), [])}>
              <circle class="sp-star__hit" cx={r1(cx)} cy={r1(cy)} r={hitR[i]! >= 25 ? '25' : String(hitR[i])} />
              <g class="sp-star__orn" transform={`translate(${r1(cx)} ${r1(cy)})`}>
                <circle class="sp-star__sel" r="16" />
                <circle class="sp-star__track" r="20" />
                <circle class="sp-star__arc" r="20" pathLength="100" data-star-arc transform="rotate(-90)" />
                <g class="sp-star__l0">
                  <circle class="sp-star__dots" r="8" />
                  <path class="sp-star__tick" d="M11.5 0H15.5M-11.5 0H-15.5M0 11.5V15.5M0 -11.5V-15.5" />
                  <circle class="sp-star__ink" r="1.9" />
                </g>
                <g class="sp-star__l1">
                  <circle class="sp-star__ring" r="7.5" />
                  <circle class="sp-star__core" r="3.2" />
                </g>
                <g class="sp-star__nextmark">
                  <circle class="sp-star__nextring" r="24" />
                </g>
              </g>
              {n === 0
                ? <text class="sp-star__intro" x={r1(cx + num.dx)} y={r1(cy + num.dy)} text-anchor={num.anchor}>{P.introTitle}</text>
                : <text class="sp-star__num" x={r1(cx + num.dx)} y={r1(cy + num.dy)} text-anchor={num.anchor}>{n}</text>}
              <text class="sp-star__next" x={r1(lx)} y={r1(ly)} text-anchor={nx.anchor}>{P.nextTag}</text>
            </a>
          );
        })}
      </svg>
      <div class="sp-atlas__cartouche">
        <h3 class="sp-atlas__name" id="sp-map-title">{mapName}</h3>
        <p class="sp-atlas__epithet">{P.mapBy(queue.name)}</p>
      </div>
    </div>
    <p class="sp-mapnote">{inLifeOrder(queue) ? P.mapNote(!!queue.she) : mapNoteLoose}</p>
    <div class="sp-mapsel" data-story-mapsel hidden></div>
  </section>
)}
