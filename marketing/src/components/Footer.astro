---
import { getT } from '../i18n';
import type { Lang } from '../i18n';
import { publicUrl } from '../lib/urls';
import FooterChoice from '../islands/FooterChoice';

interface Props {
  lang: Lang;
  /** A page's own line in place of the platform tagline (the landing's redesign). */
  tagline?: string;
  /** The explainers that stay, in their own column (the landing). */
  explainers?: Array<{ href: string; label: string }>;
}

const { lang, tagline, explainers = [] } = Astro.props;
const t = getT(lang);

// The museum's name stays English in every language; its descriptor always stands beside it.
const museumHref = lang === 'de' ? 'https://museumofages.org/de/' : 'https://museumofages.org/';
const museumLabel = lang === 'de' ? 'Museum of Ages, ein digitales Museum' : 'Museum of Ages, a digital museum';
---
<footer class="pub-footer">
  <div class="pub-footer__inner">
    <div class="pub-footer__brand">
      <span class="pub-footer__name">Agora Cosmica</span>
      <p class="pub-footer__tagline">{tagline ?? t('footer.tagline')}</p>
    </div>

    <div class:list={['pub-footer__links', { 'pub-footer__links--four': explainers.length > 0 }]}>
      {/* Only the pages that stay: the figure list, themes, audio, Echo and the app page went (they forward). */}
      <div class="pub-footer__col">
        <a href={publicUrl(lang, '/about')}>{t('nav.about')}</a>
        <a href={lang === 'de' ? '/de/methodik/' : '/methodology/'}>{lang === 'de' ? 'Methodik' : 'Methodology'}</a>
        <a href={lang === 'de' ? '/de/about/#kontakt' : '/about/#contact'}>{t('nav.contact')}</a>
      </div>
      {explainers.length > 0 && (
        <div class="pub-footer__col">
          {explainers.map(x => <a href={x.href}>{x.label}</a>)}
        </div>
      )}
      <div class="pub-footer__col">
        <a href="/impressum/">{t('footer.impressum')}</a>
        <a href={lang === 'en' ? '/privacy/' : '/datenschutz/'}>{t('footer.datenschutz')}</a>
        <a href="/cookie-policy/">{t('footer.cookiePolicy')}</a>
        <a href={lang === 'en' ? '/terms/' : '/nutzungsbedingungen/'}>{t('footer.terms')}</a>
        {/* Withdrawing ad-measurement consent must be as easy as giving it,
            on every page where the yes can be given. */}
        <FooterChoice client:visible lang={lang} />
      </div>
      <div class="pub-footer__col">
        {/* No noreferrer: the museum's edge counter reads only the referrer's host to file the visit. */}
        <a href={museumHref} target="_blank" rel="noopener">{museumLabel}</a>
        <a href="https://github.com/chipmates/agoracosmica" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>

    <div class="pub-footer__bottom">
      <p class="pub-footer__project">{t('footer.projectOf')}</p>
      <p class="pub-footer__trust">{t('footer.trustSignals')}</p>
      <p class="pub-footer__star">
        <a href="https://github.com/chipmates/agoracosmica" target="_blank" rel="noopener noreferrer">{t('footer.starCta')}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  /* Subtle, site-wide star ask. Scoped to the footer so it does not touch the
     frozen global CSS. Plain repo link, no third-party star widget. */
  .pub-footer__star {
    margin-top: 0.75rem;
    font-size: 0.85rem;
  }
  .pub-footer__star a {
    color: var(--gold-primary, #E6BC5C);
    text-decoration: none;
  }
  .pub-footer__star a:hover,
  .pub-footer__star a:focus-visible {
    color: var(--gold-hover, #F6D55C);
    text-decoration: underline;
  }
</style>
