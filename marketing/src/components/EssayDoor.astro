---
// The first-screen door of the explainer and poetry pages, under the lead: the figure's portrait, the page's AI label
// beside it, and the closing door's own button (same address, same words). The label stands before the portrait in
// the markup, so a screen reader meets it first; on short screens the page's label under the title stands in for it
// and the door shows the button alone (the styles below). The click counts apart from the closing door by its place.
import StaticImage from './StaticImage.astro';
import AiLabel from './AiLabel.astro';
import './portrait-credit.css';
import { portraitAlt } from '../lib/portraitCredit';
import { getFigureById } from '@client/data/public/figuresCatalog';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  href: string;
  buttonLabel: string;
  figureId: string;
}

const { lang, href, buttonLabel, figureId } = Astro.props;
const alt = portraitAlt(getFigureById(figureId, lang)?.name ?? figureId, lang);
---
<div class="esy-door">
  <AiLabel lang={lang} class="esy-door__label" />
  <div class="esy-door__portrait">
    <StaticImage figureId={figureId} type="thumbnail" alt={alt} loading="eager" width={64} height={64} sizes="(max-width: 560px) 44px, 64px" />
  </div>
  <a class="esy-door__button pub-cta__button" href={href} data-agc-cta="start-exploring" data-agc-figure={figureId} data-agc-door="essay_top">
    {buttonLabel}
  </a>
</div>

<style is:global>
  /* Desktop: the portrait beside a column of the label over the button. */
  .esy-door {
    display: grid;
    grid-template-columns: 64px auto;
    grid-template-areas:
      'portrait label'
      'portrait button';
    justify-content: start;
    align-items: center;
    column-gap: 1rem;
    row-gap: 0.35rem;
    margin: 1.4rem 0 0;
  }
  .esy-door .esy-door__label {
    grid-area: label;
    margin: 0;
  }
  /* level with the closed label and button, from the top, so an opened note does not move it */
  .esy-door__portrait {
    grid-area: portrait;
    align-self: start;
    margin-top: calc((44px + 0.35rem + 48px - 64px) / 2);
    width: 64px;
    height: 64px;
  }
  .esy-door__portrait img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid color-mix(in srgb, var(--gold-subtle) 40%, transparent);
  }
  .esy-door__button {
    grid-area: button;
    justify-self: start;
    min-height: 48px;
    padding: 0.7rem 1.6rem;
  }
  /* Phone: the portrait and the label share a row, the button takes the column's width under them. */
  @media (max-width: 560px) {
    .esy-door {
      grid-template-columns: 44px minmax(0, 1fr);
      grid-template-areas:
        'portrait label'
        'button button';
      justify-content: stretch;
      column-gap: 0.6rem;
      row-gap: 2px;
      margin-top: 0.5rem;
    }
    .esy-door__portrait {
      margin-top: 0;
      width: 44px;
      height: 44px;
    }
    .esy-door__button {
      justify-self: stretch;
      min-height: 44px;
      padding: 0.55rem 1rem;
      font-size: 0.9rem;
      white-space: normal;
    }
  }
  /* The page's second label instance, under the title, shows only on short screens below. */
  .esy-hero .esy-hero__label {
    display: none;
  }
  /* Short screens: the tall layout only where the whole door row ends at least 56 px above the fold on every page
     (room for a browser's bottom bar), measured per width band with the fonts loaded, Chromium and WebKit, at the
     band's narrowest width. Elsewhere the label stands under the title, said once, and the door shows the button
     alone, so no AI image stands below the label without a mark. */
  @media (max-width: 374px) and (max-height: 1065px),
    (min-width: 375px) and (max-width: 389px) and (max-height: 953px),
    (min-width: 390px) and (max-width: 411px) and (max-height: 919px),
    (min-width: 412px) and (max-width: 429px) and (max-height: 892px),
    (min-width: 430px) and (max-width: 560px) and (max-height: 863px),
    (min-width: 561px) and (max-height: 779px) {
    .esy-hero .esy-hero__label {
      display: block;
    }
    .esy-door .esy-door__label,
    .esy-door .esy-door__portrait {
      display: none;
    }
    .esy-door {
      grid-template-areas: 'button button';
    }
  }
</style>
