---
// The poem pages' app door. The chat ended (its addresses forward to the landing), so the door renders nothing; the
// pages drop its slot in their next round.

type PoemDoorSlot = 'hero' | 'after-first-poem';

interface Props {
  /** Which slot this instance sits in. Only the active placement renders. */
  at: PoemDoorSlot;
  href: string;
  buttonLabel: string;
  /** Internal figure id for the conversion metadata, as the page's invite uses it. */
  figureId: string;
  /** What the page's own invite says the Echo is shaped by. Omit for the plain line. */
  shapedBy?: string;
  /** The door's own line. Omit on a page of poems. */
  line?: string;
  /** The cta slot this door reports. Omit on a page of poems. */
  door?: string;
  /** A page that has ended the top-door test puts its door here instead. */
  placement?: PoemDoorSlot;
}
---
