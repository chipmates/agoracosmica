---
// The honesty capsule at the foot of a figure page: "is this really X
// speaking?", answered plainly.
//
// The other Q&A pairs are not here any more. Pair 0 is now the lead paragraph
// under the H1 (an answer a searcher can read without scrolling), and pairs 1
// and up became the concept sections. The same array still drives the FAQPage
// JSON-LD in the route, so the schema and the visible page stay in step.
//
// Content is drafted from verified keyConcepts/primaryWorks/entity data and was
// web-fact-checked, and it AWAITS THE EDITORIAL VOICE PASS for the 29 figures
// that have not had it (Jung has).
import { getFigureQA } from '@client/data/public/figureQA';
import type { Lang } from '../i18n';

interface Props {
  figureId: string;
  lang: Lang;
}

const { figureId, lang } = Astro.props;
const qa = getFigureQA(figureId, lang);
---
{qa && (
  <section class="pub-section pub-figure__qa-capsule">
    <h2 class="pub-section__title">{qa.disclosure.q}</h2>
    <p class="pub-section__text">{qa.disclosure.a}</p>
  </section>
)}
