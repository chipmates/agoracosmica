---
// Featured-debate hero card on the theme detail page. Mirrors the React
// CouncilHero.tsx — static portraits, title, question, tagline, cast. The
// only interactive island is the council preview audio button.

import StaticImage from './StaticImage.astro';
import CouncilPreviewButton from '../islands/CouncilPreviewButton';
import { getT } from '../i18n';
import type { Lang } from '../i18n';
import {
  type CatalogCouncil,
  getLocalizedTitle,
  getLocalizedQuestion,
  getLocalizedTagline,
  getShortDisplayName,
} from '@client/data/councilCatalog';
import { getPublicCouncilPreviewUrl } from '@client/utils/public/publicMediaUrl';

interface Props {
  council: CatalogCouncil;
  lang: Lang;
  /** Heading level for the council title. Theme pages keep the default h2;
   *  the homepage council section has its own h2 above and passes h3. */
  headingLevel?: 'h2' | 'h3';
  /** Context strip, all optional so the homepage rendering is unchanged. */
  typeLabel?: string;
  runtimeLabel?: string;
  stationLabel?: string;
  /** Doors under the preview: open the debate, or ask the question yourself. */
  openHref?: string;
  openLabel?: string;
  askHref?: string;
  askLabel?: string;
  askFigureId?: string;
}

const {
  council,
  lang,
  headingLevel = 'h2',
  typeLabel,
  runtimeLabel,
  stationLabel,
  openHref,
  openLabel,
  askHref,
  askLabel,
  askFigureId,
} = Astro.props;
const TitleHeading = headingLevel;
const t = getT(lang);
const meta = [typeLabel, runtimeLabel, stationLabel].filter(Boolean) as string[];

const title = getLocalizedTitle(council, lang);
// No-JS fallback: a plain link to the raw preview mp3, same URL the island's
// audio hook builds, so the SSR'd play button is never a dead end.
const previewMp3 = getPublicCouncilPreviewUrl(council.id, lang, 'mp3');
const question = getLocalizedQuestion(council, lang);
const tagline = getLocalizedTagline(council, lang);
const typeEmoji = council.type === 'confrontational' ? '🔥' : '🌊';
const cast = [council.moderator, ...council.participants];
---
<section class="pub-council-hero" data-theme={council.theme}>
  <div class="pub-council-hero__eyebrow">
    {t('themes.featuredDebate', 'Featured debate')}
  </div>

  <div class="pub-council-hero__title-row">
    <span class="pub-council-hero__type" aria-hidden="true">{typeEmoji}</span>
    <TitleHeading class="pub-council-hero__title">{title}</TitleHeading>
  </div>

  <p class="pub-council-hero__question">
    <span
      class="pub-council-hero__question-bar"
      aria-hidden="true"
    />
    <span class="pub-council-hero__question-text">{question}</span>
  </p>

  {tagline && <p class="pub-council-hero__tagline">{tagline}</p>}

  {meta.length > 0 && (
    <p class="pub-council-hero__meta">
      {meta.map((entry, i) => (
        <>
          {i > 0 && <span class="pub-council-hero__meta-sep" aria-hidden="true">·</span>}
          <span>{entry}</span>
        </>
      ))}
    </p>
  )}

  <div class="pub-council-hero__cast" role="list">
    {cast.map((figure, idx) => (
      <div class="pub-council-hero__cast-item" role="listitem">
        <div class="pub-council-hero__portrait-frame">
          <StaticImage
            figureId={figure.id}
            type="thumbnail"
            alt=""
            loading="lazy"
            width={96}
            height={96}
            sizes="96px"
          />
          {idx === 0 && (
            <span
              class="pub-council-hero__crown"
              role="img"
              aria-label={t('themes.moderator', 'Moderator')}
              title={t('themes.moderator', 'Moderator')}
            >
              <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true">
                <path d="M2 7l5 5 5-9 5 9 5-5v12H2z" />
              </svg>
            </span>
          )}
        </div>
        <span class="pub-council-hero__cast-name">
          {getShortDisplayName(figure.id)}
        </span>
      </div>
    ))}
  </div>

  <div class="pub-council-hero__actions">
    <CouncilPreviewButton client:visible councilId={council.id} lang={lang} />
    <noscript>
      <a class="pub-textlink" href={previewMp3}>
        {lang === 'de' ? 'Intro anhören (MP3)' : 'Listen to the intro (MP3)'}
      </a>
    </noscript>
  </div>

  {(openHref || askHref) && (
    <p class="pub-council-hero__doors">
      {openHref && (
        <a
          class="pub-textlink"
          href={openHref}
          data-agc-cta="start-exploring"
          data-agc-council={council.id}
          data-agc-door="theme_debate"
        >{openLabel}</a>
      )}
      {openHref && askHref && <span class="pub-council-hero__meta-sep" aria-hidden="true">·</span>}
      {askHref && (
        <a
          class="pub-textlink"
          href={askHref}
          data-agc-cta="start-exploring"
          data-agc-figure={askFigureId}
          data-agc-door="theme_ask_featured"
        >{askLabel}</a>
      )}
    </p>
  )}

  <!-- Same wording as the Library panels' council disclosure, kept verbatim -->
  <p class="pub-council-hero__ai">
    {lang === 'de'
      ? 'Vier KI-Echos, eines davon moderiert. Deutungen, keine Aufnahmen.'
      : 'Four AI Echoes, one of them moderating. Interpretations, not recordings.'}
  </p>
</section>

<style is:global>
  /* Council question-bar accent color, driven by the section's data-theme
     instead of an inline style attribute, so the strict production CSP (whose
     Astro meta hashes nullify style 'unsafe-inline') cannot block it. Bundled
     to an external stylesheet, served from 'self'. Applies wherever CouncilHero
     renders (homepage + theme pages). The --council-* layer only exists in the
     night reskin, so each rule falls back to the ink token it maps to; without
     the fallback the bar renders invisible on the pages still on public-*.css. */
  .pub-council-hero[data-theme='who-am-i'] .pub-council-hero__question-bar { background: var(--council-who-am-i, var(--gold-primary)); }
  .pub-council-hero[data-theme='love-connection'] .pub-council-hero__question-bar { background: var(--council-love-connection, var(--ink-rose)); }
  .pub-council-hero[data-theme='meaning-purpose'] .pub-council-hero__question-bar { background: var(--council-meaning-purpose, var(--ink-sap-green)); }
  .pub-council-hero[data-theme='mind-creativity'] .pub-council-hero__question-bar { background: var(--council-mind-creativity, var(--ink-smalt)); }
  .pub-council-hero[data-theme='moral-life'] .pub-council-hero__question-bar { background: var(--council-moral-life, var(--ink-verdigris)); }
  .pub-council-hero[data-theme='freedom-justice'] .pub-council-hero__question-bar { background: var(--council-freedom-justice, var(--ink-madder)); }
  .pub-council-hero[data-theme='faith-death-mystery'] .pub-council-hero__question-bar { background: var(--council-faith-death-mystery, var(--ink-folium)); }
  .pub-council-hero[data-theme='loss-grief'] .pub-council-hero__question-bar { background: var(--council-loss-grief, var(--ink-azurite)); }

  /* Context strip + doors, rendered only when the caller passes them. */
  .pub-council-hero__meta {
    margin: var(--space-sm) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }
  .pub-council-hero__meta-sep { color: var(--text-dim); }
  @media (max-width: 560px) {
    .pub-council-hero__meta { flex-direction: column; gap: 0.2rem; }
    .pub-council-hero__meta .pub-council-hero__meta-sep { display: none; }
  }
  .pub-council-hero__doors {
    margin: var(--space-md) 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
    font-size: var(--text-sm);
  }

  /* AI disclosure line under the preview actions: muted, static, never hidden */
  .pub-council-hero__ai {
    margin: var(--space-sm) 0 0;
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
    font-size: var(--text-xs);
    line-height: var(--leading-normal, 1.5);
    color: var(--text-tertiary);
  }
</style>
