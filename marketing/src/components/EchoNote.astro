---
import { getT } from '../i18n';
import type { Lang } from '../i18n';
import { publicUrl } from '../lib/urls';

interface Props {
  variant: 'figure' | 'theme';
  name?: string;
  lang: Lang;
  /** A page's own note and link in place of the shared ones (the story pages). */
  note?: string;
  link?: { href: string; label: string };
}

const { variant, name, lang, note, link } = Astro.props;
const t = getT(lang);
const text =
  note ?? (variant === 'figure'
    ? t('echo.figureNote').replace('{name}', name ?? '')
    : t('echo.themeNote'));
const href = link?.href ?? publicUrl(lang, '/echoes');
const label = link?.label ?? t('echo.whyLink');
---
<section class="pub-section">
  <p class="pub-section__text pub-echo-note">
    {text}
    {' '}<a class="pub-textlink" href={href}>{label}</a>
  </p>
</section>

<style is:global>
  .pub-echo-note {
    margin: 0;
    padding-left: 1rem;
    border-left: 2px solid color-mix(in srgb, var(--gold-subtle) 50%, transparent);
    font-style: italic;
    opacity: 0.85;
  }
</style>
