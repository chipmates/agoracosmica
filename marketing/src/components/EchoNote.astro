---
import { getT } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  variant: 'figure' | 'theme';
  name?: string;
  lang: Lang;
  /** A page's own note in place of the shared one (the story pages); a link only when given. */
  note?: string;
  link?: { href: string; label: string };
}

const { variant, name, lang, note, link } = Astro.props;
const t = getT(lang);
const text =
  note ?? (variant === 'figure'
    ? t('echo.figureNote').replace('{name}', name ?? '')
    : t('echo.themeNote'));
---
<section class="pub-section">
  <p class="pub-section__text pub-echo-note">
    {text}
    {link && <>{' '}<a class="pub-textlink" href={link.href}>{link.label}</a></>}
  </p>
</section>

<style is:global>
  .pub-echo-note {
    margin: 0;
    padding-left: 1rem;
    border-left: 2px solid color-mix(in srgb, var(--gold-subtle) 50%, transparent);
    font-style: italic;
    opacity: 0.85;
  }
</style>
