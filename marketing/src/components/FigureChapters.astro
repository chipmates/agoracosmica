---
// The life, in twelve chapters: one sequential rail, first to last. Server
// rendered, and every line of it is a join of data that already exists:
//
//   title      seeds/{lang}/{id}.json
//   year, age, setting, the documented/recreated ledger   factchecks
//   runtime    stories/{lang}/{id}.json
//
// The rail runs top to bottom in ONE column on every width. Two flowing
// columns read 1-6 down the left and 7-12 down the right, which sends a
// reader who finished chapter six back UP the page for chapter seven.
//
// The ledger is the honesty signature: per scene, what the record shows and
// what we staged. It sits in a per-chapter <details> so the rail stays
// walkable, and its text stays in the page either way. Factcheck strings
// render VERBATIM or not at all.
// No per-chapter art exists (the image manifest carries a portrait and a
// thumbnail only), so the rail is typographic by design.

import type { Lang } from '../i18n';
import { getSeedsFor } from '../lib/seeds';
import { getStoryChapter } from '../lib/stories';
import { getChapterFactcheck } from '../lib/factchecks';
import { cleanDisplayText, cleanFactText } from '../lib/figureWorld';

interface Props {
  figureId: string;
  slug: string;
  figureName: string;
  lang: Lang;
}

const { figureId, slug, figureName, lang } = Astro.props;
const de = lang === 'de';

const S = de
  ? {
      heading: `Das Leben von ${figureName}, in zwölf Kapiteln`,
      lead: 'Jedes Kapitel nimmt eine Idee und macht eine Szene daraus. Der Weg läuft von oben nach unten, Kapitel eins bis zwölf, und unter jeder Szene steht, was belegt ist und was wir für die Erzählung gebaut haben.',
      age: 'mit',
      min: 'Min.',
      ledger: 'Was belegt ist, was wir gebaut haben',
      documented: 'Belegt',
      recreated: 'Für die Szene gebaut',
      listen: 'Kapitel',
      listenTail: 'hören',
    }
  : {
      heading: `The life of ${figureName}, in twelve chapters`,
      lead: 'Each chapter takes one idea and turns it into a scene. The path runs top to bottom, chapter one to twelve, and under every scene we say what the record shows and what we built for the telling.',
      age: 'age',
      min: 'min',
      ledger: 'What the record shows, what we built',
      documented: 'Documented',
      recreated: 'Built for the scene',
      listen: 'Hear chapter',
      listenTail: '',
    };

const seeds = getSeedsFor(figureId, lang);

// The locked-positioning guard: "greatest minds" is a framing the site never
// uses about itself, and validate-seo enforces that on every built page. One
// story hook contains it as narration (a scene at the Solvay Conference), which
// is a true description of that room but still trips the guard, so that chapter
// falls back to its seed summary instead of the hook. Never edit the source
// prose to get past a guard.
const LOCKED_FRAMING = /great(est)? minds|gr(ö|oe)(ß|ss)te[nr]? (denker|geister)/i;

const chapters = seeds.map((seed, i) => {
  const n = i + 1;
  const fc = getChapterFactcheck(figureId, lang, n);
  const story = getStoryChapter(figureId, lang, n);
  const meta = [
    fc?.year,
    fc?.age ? `${S.age} ${fc.age}` : '',
    fc?.setting,
    story?.minutes ? `${story.minutes} ${S.min}` : '',
  ].filter(Boolean).map(cleanFactText) as string[];
  const hook = cleanDisplayText(story?.hook);
  return {
    n,
    title: cleanDisplayText(seed.title),
    summary: cleanDisplayText(seed.summary),
    hook: LOCKED_FRAMING.test(hook) ? '' : hook,
    meta,
    documented: cleanFactText(fc?.documented?.[0]),
    recreated: cleanFactText(fc?.recreated?.[0]),
  };
});
---
{chapters.length > 0 && (
  <section class="pub-section fig-chapters">
    <h2 class="pub-section__title">{S.heading}</h2>
    <p class="pub-section__text">{S.lead}</p>
    <ol class="fig-chapters__list">
      {chapters.map(c => (
        <li class="fig-chapter" id={`idea-${c.n}`}>
          <span class="fig-chapter__n" aria-hidden="true">{c.n}</span>
          <div class="fig-chapter__body">
            <h3 class="fig-chapter__title">{c.title}</h3>
            {c.meta.length > 0 && (
              <p class="fig-chapter__meta">{c.meta.join('  ·  ')}</p>
            )}
            <p class="fig-chapter__text">{c.hook || c.summary}</p>
            {(c.documented || c.recreated) && (
              <details class="fig-chapter__ledger">
                <summary class="fig-chapter__ledger-toggle">{S.ledger}</summary>
                <p class="fig-chapter__ledger-body">
                  {c.documented && (
                    <span class="fig-chapter__ledger-item">
                      <span class="fig-chapter__ledger-key">{S.documented}:</span> {c.documented}
                    </span>
                  )}
                  {c.recreated && (
                    <span class="fig-chapter__ledger-item">
                      <span class="fig-chapter__ledger-key">{S.recreated}:</span> {c.recreated}
                    </span>
                  )}
                </p>
              </details>
            )}
            <p class="fig-chapter__door">
              <a
                class="pub-textlink"
                href={`/app?figure=${slug}&lang=${lang}&mode=story&chapter=${c.n}`}
                data-agc-cta="start-exploring"
                data-agc-figure={figureId}
                data-agc-door="fig_chapter"
              >
                {`${S.listen} ${c.n}${S.listenTail ? ' ' + S.listenTail : ''} →`}
              </a>
            </p>
          </div>
        </li>
      ))}
    </ol>
  </section>
)}

<style is:global>
  .fig-chapters__list {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
  }
  /* The rail: numbered stops in a gutter, one line running through them. */
  .fig-chapter {
    position: relative;
    display: grid;
    grid-template-columns: 1.9rem 1fr;
    column-gap: 0.9rem;
    padding-bottom: 1.9rem;
  }
  .fig-chapter::before {
    content: "";
    position: absolute;
    left: 0.95rem;
    top: 2.1rem;
    bottom: 0;
    width: 1px;
    background: color-mix(in srgb, var(--gold-subtle) var(--a-20, 20%), transparent);
  }
  .fig-chapter:last-child { padding-bottom: 0; }
  .fig-chapter:last-child::before { display: none; }
  .fig-chapter__body { min-width: 0; }
  .fig-chapter__title {
    margin: 0 0 0.3rem;
    font-family: var(--font-content, 'Libre Caslon Text', serif);
    font-weight: var(--weight-regular, 400);
    font-size: 1.2rem;
    line-height: 1.3;
    color: var(--gold-subtle);
  }
  .fig-chapter__n {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 1px solid color-mix(in srgb, var(--gold-subtle) var(--a-45, 45%), transparent);
    border-radius: 50%;
    background: var(--bg-void);
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
    font-size: 0.76rem;
    letter-spacing: 0.04em;
    color: var(--gold-subtle);
  }
  .fig-chapter__meta {
    margin: 0 0 0.55rem;
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
    font-size: 0.74rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }
  .fig-chapter__text {
    margin: 0 0 0.55rem;
    font-family: var(--font-content, 'Libre Caslon Text', serif);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 66ch;
  }
  /* The honesty ledger, one line by default, the wording one tap away. */
  .fig-chapter__ledger {
    margin: 0 0 0.5rem;
    max-width: 66ch;
  }
  .fig-chapter__ledger-toggle {
    display: flex;
    align-items: center;
    min-height: 44px;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-deep);
    transition: color var(--transition-fast);
  }
  .fig-chapter__ledger-toggle::-webkit-details-marker { display: none; }
  .fig-chapter__ledger-toggle::after {
    content: "+";
    margin-left: 0.5rem;
    font-size: 0.9rem;
    line-height: 1;
  }
  .fig-chapter__ledger[open] .fig-chapter__ledger-toggle::after { content: "−"; }
  .fig-chapter__ledger-toggle:hover,
  .fig-chapter__ledger[open] .fig-chapter__ledger-toggle { color: var(--gold-primary); }
  .fig-chapter__ledger-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0 0 0.2rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid color-mix(in srgb, var(--gold-subtle) var(--a-12, 12%), transparent);
    border-radius: var(--plate-radius, 4px);
    background: color-mix(in srgb, var(--bg-card) var(--a-45, 45%), transparent);
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--text-tertiary);
  }
  .fig-chapter__ledger-key {
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-deep);
  }
  .fig-chapter__door { margin: 0; font-size: 0.92rem; }
  @media (min-width: 900px) {
    .fig-chapter { grid-template-columns: 2.2rem 1fr; column-gap: 1.2rem; }
    .fig-chapter::before { left: 1.1rem; }
    .fig-chapter__n { width: 2.2rem; height: 2.2rem; font-size: 0.78rem; }
  }
</style>
