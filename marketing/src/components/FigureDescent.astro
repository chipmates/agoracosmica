---
// The era descent on the front, under the hero: a sticky era bar with five
// anchors, then the five bands, newest birth year first, each portrait a link
// to that figure's page. Every anchor, link and word is server rendered, so
// the whole thing works with JS off. The one script sets the active chip, the
// depth readout and the gauge.
//
// Deliberately NOT taken from the prototype this harvests: the entry gate,
// smooth-scroll library, scroll pinning framework, ambient audio, custom
// cursor. This page's job is to pass rank to thirty children, so it stays on
// native scroll and ships no third-party runtime.

import { getFiguresCatalog } from '@client/data/public/figuresCatalog';
import { figureIdToSlug } from '@client/data/public/slugMap';
import { figureImage, figureSrcset } from '../lib/figureImages';
import { publicUrl } from '../lib/urls';
import { portraitAlt } from '../lib/portraitCredit';
import { STRATA, LIFE_YEARS, getStrataUi } from './figureStrata';
import type { Lang } from '../i18n';
import './figures-index.css';

interface Props {
  lang: Lang;
  /** The section's anchor: the old /figures/ addresses land here. */
  anchor?: string;
}
const { lang, anchor } = Astro.props;
const ui = getStrataUi(lang);
const byId = new Map(getFiguresCatalog(lang).map(f => [f.id, f]));

const intro = lang === 'de'
  ? 'Ganz oben stehen die Stimmen, die uns am nächsten sind. Je weiter du kommst, desto älter wird die Frage. Am Grund liegen die vier ältesten.'
  : 'The voices closest to us are at the top. The further you go, the older the question gets. The four oldest are waiting at the floor.';

const floorLine = lang === 'de'
  ? 'Der Grund. Dreißig Stimmen, fünf Epochen, rund 2.500 Jahre.'
  : 'The floor. Thirty voices, five eras, roughly 2,500 years.';

const bands = STRATA.map(s => {
  const copy = s[lang];
  return {
    id: s.id,
    num: s.num,
    ...copy,
    people: s.figures.map(id => {
      const f = byId.get(id);
      return {
        id,
        name: f ? f.name : id,
        tradition: f ? f.tradition : '',
        learn: f ? f.learn : '',
        years: LIFE_YEARS[id] ? LIFE_YEARS[id][lang] : '',
        href: publicUrl(lang, `/figures/${figureIdToSlug[id]}`),
        src: figureImage(id, 'thumbnail', 160),
        srcset: figureSrcset(id, 'thumbnail', [160, 320]),
      };
    }),
  };
});
---
<section class="fx-front" id={anchor} aria-labelledby="fx-front-h">
<nav class="fx-bar" id="fx-bar" aria-label={ui.navAria}>
  <div class="fx-bar__inner">
    <span class="fx-bar__label">{ui.navLabel}</span>
    <ul class="fx-bar__list">
      {bands.map(b => (
        <li>
          <a class="fx-bar__link" href={`#${b.id}`} data-span={b.span}>
            <span class="fx-bar__num" aria-hidden="true">{b.num}</span>{b.short}
          </a>
        </li>
      ))}
    </ul>
    <p class="fx-bar__depth">
      <span>{ui.depthLabel}</span>
      <b id="fx-depth">{ui.surface}</b>
    </p>
  </div>
  <div class="fx-bar__gauge" aria-hidden="true"><span></span></div>
</nav>

<div class="fx-descent" id="fx-descent">
  <div class="fx-wrap">
    <div class="fx-intro">
      <p class="fx-eyebrow" id="fx-front-h">{ui.descentHeading}</p>
      <p class="fx-intro__text">{intro}</p>
    </div>

    {bands.map(b => (
      <section class="fx-stratum" id={b.id} aria-labelledby={`${b.id}-name`}>
        <div class="fx-plate">
          <span class="fx-num" aria-hidden="true">{b.num}</span>
          <h2 class="fx-name" id={`${b.id}-name`}>{b.name}</h2>
          <p class="fx-span">{b.span}</p>
          <p class="fx-caption">{b.caption}</p>
          <p class="fx-era">{b.era}</p>
        </div>

        <div class="fx-voices">
          <p class="fx-voices__label">{ui.voicesLabel}</p>
          <ul class="fx-list">
            {b.people.map(p => (
              <li>
                <a class="fx-voice" href={p.href}>
                  <span class="fx-voice__face">
                    <img
                      src={p.src}
                      srcset={p.srcset}
                      sizes="56px"
                      alt={portraitAlt(p.name, lang)}
                      width="160"
                      height="160"
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                  <span>
                    <span class="fx-voice__name">{p.name}</span>
                    <span class="fx-voice__meta">{p.years} · {p.tradition}</span>
                    <span class="fx-voice__learn">{p.learn}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))}
  </div>
  <p class="fx-floor">{floorLine}</p>
</div>
</section>

