---
// Die Vertrauensseite (DE). Titel und H1 beantworten beide die Frage, die
// Menschen wirklich tippen. Das FAQ-Schema trägt nur die beiden Überschriften,
// die als Frage auf der Seite stehen, damit DOM und JSON-LD übereinstimmen.
import Public from '../../layouts/Public.astro';
import AboutContent from '../../components/AboutContent.astro';
import { getT } from '../../i18n';
import {
  agoraCosmicaSchema,
  organizationSchema,
  webSiteSchema,
  softwareApplicationSchema,
  faqSchema,
  breadcrumbSchema,
} from '../../lib/schemas';
import { canonicalUrl, SITE_URL } from '../../lib/urls';

const lang = 'de' as const;
const t = getT(lang);

const canonical = canonicalUrl('/de/about');
const faq = [
  { q: t('about.h1'), a: t('about.lead') },
  { q: t('about.trustTitle'), a: t('about.trustAnswer') },
];
---
<Public
  title={t('about.pageTitle')}
  fullTitle={t('about.pageTitle')}
  description={t('about.pageDescription')}
  canonicalPath="/about"
  lang={lang}
  ogType="website"
  schemas={[
    agoraCosmicaSchema(),
    organizationSchema(),
    webSiteSchema(),
    softwareApplicationSchema(),
    faqSchema(faq, canonical),
    breadcrumbSchema([
      { name: t('breadcrumbs.home'), url: `${SITE_URL}/de/` },
      { name: t('breadcrumbs.about'), url: `${SITE_URL}/de/about` },
    ]),
  ]}
>
  <AboutContent lang={lang} />
</Public>
