---
import Public from '../../../layouts/Public.astro';
import { figureImage } from '../../../lib/figureImages';
import FigureDetailContent from '../../../components/FigureDetailContent.astro';

import { getT } from '../../../i18n';
import { breadcrumbSchema, personSchema, audioObjectSchema, faqSchema, itemListSchema } from '../../../lib/schemas';
import { getSeedsFor } from '../../../lib/seeds';
import { dickinsonPoemsFaqDe } from '../../../lib/dickinsonPoemsFaq';
import { canonicalUrl, publicUrl, SITE_URL, MEDIA_URL } from '../../../lib/urls';
import { figureSlugToId } from '@client/data/public/slugMap';
import { getFigureById } from '@client/data/public/figuresCatalog';
import { getFigureSeo } from '@client/data/public/figureSeo';
import { getFigureQA } from '@client/data/public/figureQA';
import { getFigurePageContent } from '@client/data/public/figurePageContent';

export async function getStaticPaths() {
  return Object.entries(figureSlugToId).map(([slug, figureId]) => ({
    params: { slug },
    props: { figureId },
  }));
}

const lang = 'de' as const;
const { slug } = Astro.params;
const { figureId } = Astro.props as { figureId: string };

const t = getT(lang);
const figure = getFigureById(figureId, lang);
const seo = getFigureSeo(figureId, lang);

if (!figure) throw new Error(`Unknown figure: ${figureId}`);

const aboutParas = figure.about.split('\n').map(p => p.trim()).filter(Boolean);
// No pre-slice: a raw .slice(0,160) cuts mid-word and then BaseHead's
// word-boundary clamp sees a "fitting" string and passes it through.
const metaDescription = seo?.description || aboutParas[0] || '';
const figureUrl = `${SITE_URL}/de/figures/${slug}`;
// (figure-portrait LCP preload removed 2026-06-04: it hinted WebP while the
// <picture> serves AVIF, so the browser double-downloaded an unused file. The
// eager <picture> below loads the portrait without it.)
const figurePortrait = figureImage(figureId, 'main', 1200);

const figQA = getFigureQA(figureId, lang);
const figQaItems = (figureId !== 'dickinson' && figQA)
  ? [...figQA.pairs, figQA.disclosure]
  : [];

// Die zwölf Ideen als ItemList, deckungsgleich mit der sichtbaren Ideen-Liste
// und ihren #idea-N-Ankern, damit jede Idee eine zitierbare, verlinkbare Einheit
// ist.
const ideaSeeds = getSeedsFor(figureId, lang);

// Die Werke, die die Seite zeigt: die redigierte Liste, wenn es sie gibt (sie
// trägt die deutschen Titel), sonst die Katalogliste. Als Book-Knoten
// ausgegeben, damit die Werke strukturierte Daten sind und nicht nur Fließtext.
const pageContent = getFigurePageContent(figureId, lang);
const schemaWorks = pageContent?.works?.length
  ? pageContent.works.map(w => w.title)
  : figure.primaryWorks;

const schemas = [
  personSchema({
    name: figure.name,
    about: aboutParas[0] || figure.about,
    period: figure.period,
    tradition: figure.tradition,
    slug: slug!,
    lang,
    image: figurePortrait,
    concepts: figure.keyConcepts.map(c => c.term),
    works: schemaWorks,
  }),
  breadcrumbSchema([
    { name: t('breadcrumbs.home'), url: `${SITE_URL}/de/` },
    { name: t('breadcrumbs.figures'), url: `${SITE_URL}/de/figures` },
    { name: figure.name, url: figureUrl },
  ]),
  audioObjectSchema({
    figureId,
    name: figure.name,
    slug: slug!,
    lang,
  }),
  ...(figureId === 'dickinson'
    ? [faqSchema(dickinsonPoemsFaqDe, `${figureUrl}/`)]
    : []),
  ...(figQaItems.length ? [faqSchema(figQaItems, `${figureUrl}/`)] : []),
  ...(ideaSeeds.length
    ? [itemListSchema(ideaSeeds.map((s, i) => ({
        name: s.title,
        url: `${figureUrl}/#idea-${i + 1}`,
        description: s.summary,
      })))]
    : []),
];
---
<Public
  title={`${figure.name} - ${t('figures.life')} & ${t('figures.teachings')}`}
  fullTitle={seo?.seoTitle}
  description={metaDescription}
  canonicalPath={`/figures/${slug}`}
  lang={lang}
  stickyCta={false}
  ogType="profile"
  ogImage={figurePortrait}
  ogImageAlt={`KI-generiertes Porträt: ${figure.name}`}
  schemas={schemas}
>
  <FigureDetailContent figureId={figureId} slug={slug!} lang={lang} />
</Public>
