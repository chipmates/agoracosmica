---
// Methodik- / redaktionelle-Standards-Seite (DE). Deutsches Pendant zu
// /methodology. Die Vertrauens- und E-E-A-T-Oberfläche, die beantwortet, wie
// die KI-Echos gebaut, belegt und faktengeprüft werden. Eigene Intention,
// getrennt von /echoes (warum wir den Toten eine Stimme geben) und von den
// Hubs und der Open-Source-Positionierungsseite, damit der Cluster sich nicht
// selbst kannibalisiert. EN- und DE-Slug unterscheiden sich (/methodology vs
// /de/methodik), wie bei den Hubs, darum tragen altEn/altDe die echten Pfade,
// und BaseHead leitet Canonical + hreflang daraus ab. Die FAQ wird hier
// definiert und sowohl an die sichtbare Ausgabe als auch an faqSchema()
// übergeben, damit JSON-LD und DOM nicht auseinanderlaufen. Alle Aussagen sind
// faktentreu und bleiben innerhalb der gesperrten Vertrauenssignale.
import Public from '../../layouts/Public.astro';
import MethodologyContent from '../../components/MethodologyContent.astro';
import {
  organizationSchema,
  agoraCosmicaSchema,
  articleSchema,
  faqSchema,
  breadcrumbSchema,
} from '../../lib/schemas';
import { getT } from '../../i18n';
import { canonicalUrl, SITE_URL, MEDIA_URL } from '../../lib/urls';

const lang = 'de' as const;
const t = getT(lang);

const faq = [
  {
    q: 'Spricht hier die echte Person?',
    a: 'Nein. Jede Geschichte ist eine Nacherzählung in der Ich-Form, in Mensch-KI-Zusammenarbeit nach den eigenen Werken dieses Menschen und den historischen Quellen geschrieben und von einer synthetischen Stimme vorgelesen. Sie ist als Nacherzählung gekennzeichnet, nie eine Aufnahme. Die Fakten zu jeder Geschichte sagen, was dokumentiert und was nachgestellt ist.',
  },
  {
    q: 'Wie genau sind die Geschichten?',
    a: 'Daten, Menschen, Orte und Ereignisse kommen aus den Quellen, und die Fakten zu jeder Geschichte führen sie auf. Wo eine Geschichte eine Szene, eine Dialogzeile oder ein Detail nachstellt, sagen die Fakten das. Wir lesen jede Geschichte gegen, bevor sie erscheint, aber eine Nacherzählung kann sich trotzdem in einem Detail irren. Nimm sie als Weg hinein, nicht als Autorität, und prüf alles Wichtige an den Quellen.',
  },
  {
    q: 'Woher kommen die Fakten?',
    a: 'Aus den Primärwerken der Figur, ihren Briefen und ihrem dokumentierten Leben. Wo eine Figur nichts Geschriebenes hinterlassen hat, aus dem, was überliefert ist: dem Kanon einer Lehre, den Interviews, die ein Mensch gegeben hat, den Berichten über ein Leben. Jede Geschichte ist an den Quellen geprüft, und ihre Fakten auf der Seite trennen das Belegte vom Nachgestellten. Der Code ist Open Source unter der AGPL-3.0.',
  },
  {
    q: 'Was, wenn in einer Geschichte etwas nicht stimmt?',
    a: 'Öffne die Fakten zur Geschichte, die benennen, was belegt und was nachgestellt ist, und geh dann zu den Werken, die die Seite nennt. Wenn du einen echten Fehler findest, schreib uns an agoracosmica@chipmates.ai. Wir korrigieren die Geschichte und ihre Fakten auf der Seite.',
  },
];

const canonicalPath = '/de/methodik';
const url = canonicalUrl(canonicalPath);
const schemas = [
  organizationSchema(),
  agoraCosmicaSchema(),
  articleSchema({
    title: 'Wie wir die KI-Echos bauen, belegen und faktenprüfen',
    description:
      'Unsere Methodik und redaktionellen Standards: wie jedes KI-Echo aus Primärwerken gebaut, belegt und faktengeprüft wird, und wo die Grenzen liegen.',
    url,
    lang,
    image: `${MEDIA_URL}/images/ui/og-default/1200.webp`,
    datePublished: '2026-06-24',
    dateModified: '2026-10-28',
  }),
  faqSchema(faq, url),
  breadcrumbSchema([
    { name: t('breadcrumbs.home'), url: `${SITE_URL}/de/` },
    { name: 'Wie wir die Echos bauen', url },
  ]),
];
---
<Public
  title="Wie wir die Echos bauen"
  fullTitle="Methodik: Wie wir KI-Echos bauen, belegen und prüfen"
  description="Wie Agora Cosmica seine KI-Echos baut: ein quellenbewusstes Stimmprofil aus Primärwerken, ein öffentlicher Faktencheck pro Mensch und Open-Source-Code. Ehrlich über die Grenzen."
  canonicalPath={canonicalPath}
  lang={lang}
  ogType="article"
  altEn="/methodology"
  altDe="/de/methodik"
  schemas={schemas}
>
  <MethodologyContent lang={lang} faq={faq} />
</Public>
