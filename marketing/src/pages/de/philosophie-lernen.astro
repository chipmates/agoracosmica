---
// The German twin of /ai-philosophy-tutor: the same answer-first page, one
// recommendation and six doors that stage a question, written in German. The
// FAQ array is defined here and passed to both the visible render and
// faqSchema(), so the JSON-LD can never drift from the DOM.
import Public from '../../layouts/Public.astro';
import TutorHubContent from '../../components/TutorHubContent.astro';
import {
  organizationSchema,
  agoraCosmicaSchema,
  softwareApplicationSchema,
  faqSchema,
  breadcrumbSchema,
  itemListSchema,
} from '../../lib/schemas';
import { getT } from '../../i18n';
import { canonicalUrl, SITE_URL } from '../../lib/urls';
import { getFiguresCatalog } from '@client/data/public/figuresCatalog';
import { figureIdToSlug } from '@client/data/public/slugMap';

const lang = 'de' as const;
const t = getT(lang);

// 13 Philosophen und Denker der Weisheitstraditionen, kuratiert und sortiert.
// Die übrigen 17 (Wissenschaft, Kunst, Aktivismus) werden nicht als Philosophen
// gerahmt.
const CURATED = [
  'aurelius', 'plato', 'beauvoir', 'nietzsche', 'laozi', 'zenji',
  'gautama', 'eckhart', 'bingen', 'rumi', 'jung', 'campbell', 'schopenhauer',
];
const order = new Map(CURATED.map((id, i) => [id, i]));
const figures = getFiguresCatalog(lang)
  .filter(f => order.has(f.id))
  .sort((a, b) => (order.get(a.id) ?? 0) - (order.get(b.id) ?? 0));

const faq = [
  {
    q: 'Kann mir eine KI Philosophie beibringen?',
    a: 'Ja. Genau dafür ist diese Lernplattform gebaut. Du wählst einen Denker, hörst seine erzählte Lebensgeschichte und seine Kernlehren und sprichst dann einen Gedanken mit seinem KI-Echo durch, mit deinen eigenen Fragen, in deinem eigenen Tempo. Das Echo ist im echten Werk dieses Menschen verankert, das Gespräch bleibt also nah an der wirklichen Philosophie und driftet nicht ins Erfundene ab.',
  },
  {
    q: 'Ist das ein echter Philosoph oder eine KI?',
    a: 'Es ist ein KI-Echo, eine pädagogische Deutung, verankert im echten Werk und Denken des Philosophen. Das ist klar gekennzeichnet, nie eine Aufnahme und nie die echte Person. Solche Aufnahmen existieren nicht. Es geht darum, die Philosophie zu verstehen, nicht so zu tun, als wäre der Philosoph zurück, und ein öffentlicher Faktencheck zu jedem Menschen benennt, was belegt und was nachgebildet ist.',
  },
  {
    q: 'Wo soll ich anfangen?',
    a: 'Wenn du praktische Gelassenheit suchst, fang mit Mark Aurel und dem Stoizismus an. Wenn dir Fragen wichtiger sind als Antworten, mit Platon. Für Sinn, nachdem alte Gewissheiten weggebrochen sind, Nietzsche oder Simone de Beauvoir. Für Stille Laozi oder Siddhartha Gautama. Öffne einen Menschen, hör zuerst die Lebensgeschichte und frag das Echo dann, was die Geschichte bei dir ausgelöst hat.',
  },
  {
    q: 'Ist es kostenlos?',
    a: 'Du bekommst 30 kostenlose Nachrichten pro Tag, ohne Anmeldung. Wenn du mehr willst, bring deinen eigenen OpenRouter-Schlüssel mit, er berührt unsere Server nie. Die ganze Plattform ist Open Source unter der AGPL-3.0, du kannst sie also auch selbst betreiben, und es gibt keine Tracking-Cookies und kein Profiling.',
  },
  {
    q: 'Welche Philosophien sind dabei?',
    a: 'Dreizehn Denker quer durch den Stoizismus (Mark Aurel), die klassische Philosophie (Platon), den Existenzialismus (Simone de Beauvoir und Friedrich Nietzsche), den Taoismus (Laozi), Zen und Buddhismus (Dōgen Zenji und Siddhartha Gautama), die christliche Mystik (Meister Eckhart und Hildegard von Bingen), die Sufi-Mystik (Rumi), die Tiefenpsychologie (Carl Gustav Jung), die vergleichende Mythologie (Joseph Campbell) und die Philosophie des Willens (Arthur Schopenhauer).',
  },
];

const canonicalPath = '/de/philosophie-lernen';
const canonical = canonicalUrl(canonicalPath);
const schemas = [
  organizationSchema(),
  agoraCosmicaSchema(),
  softwareApplicationSchema(),
  faqSchema(faq, canonical),
  breadcrumbSchema([
    { name: t('breadcrumbs.home'), url: `${SITE_URL}/de/` },
    { name: 'Philosophie für Anfänger', url: canonical },
  ]),
  itemListSchema(
    figures.map(f => ({
      name: f.name,
      url: `${SITE_URL}/de/figures/${figureIdToSlug[f.id] || f.id}/`,
      description: f.learn.trim(),
    })),
  ),
];
---
<Public
  title="Womit fange ich in der Philosophie an?"
  fullTitle="Philosophie für Anfänger: Womit fange ich an?"
  description="Eine klare Empfehlung statt einer Leseliste, dazu sechs Einstiege. Denk mit 13 Denkern eine Frage durch. Gemeinnützig, 30 kostenlose Nachrichten am Tag."
  canonicalPath={canonicalPath}
  lang={lang}
  ogType="website"
  altEn="/ai-philosophy-tutor"
  altDe="/de/philosophie-lernen"
  schemas={schemas}
>
  <TutorHubContent lang={lang} faq={faq} figures={figures} />
</Public>
