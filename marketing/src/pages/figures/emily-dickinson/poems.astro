---
// Emily Dickinson's poems, grouped by theme. The text is transcribed verbatim
// from her own manuscripts (public domain; she died in 1886), not from the
// copyrighted Johnson 1955 / Franklin 1998 editions, so her dashes, capitals,
// and spellings are kept as she wrote them. Manuscript images are served from
// the media CDN, reproduced courtesy of the holding libraries:
//   - Boston Public Library (Digital Commonwealth): no known copyright restrictions.
//   - Amherst College, Archives & Special Collections: free for non-commercial
//     and educational use, with attribution.
//   - Houghton Library, Harvard University: publishing images of its public-domain
//     material is permitted, with credit.
// The poem text is quoted primary source; her dashes are intentional, not house style.

import Public from '../../../layouts/Public.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import PoemDoor from '../../../components/PoemDoor.astro';
import {
  dickinsonPoems as POEMS,
  dickinsonFacsimileLeaves as FACS_LEAVES,
  dickinsonFacsimileSources as FACS,
} from '../../../data/poems/dickinson.mjs';
import { poemsByPoet } from '../../../data/poems/index.mjs';
// Where each poem's own page lives, from the same data the pages render from.
const OWN_PAGE: Record<string, string> = Object.fromEntries(
  poemsByPoet('dickinson').map((poem) => [poem.key, poem.path]),
);
// Slot 4 of the app's ask contract is this page's own question: the door skips
// the mode choice and opens Free Talk about the poem the visitor just read.
const DOOR_HREF = '/app?figure=emily-dickinson&lang=en&ask=f:dickinson:4';
// Manuscripts + portrait + audio are served from R2 (the media CDN), not
// bundled, so the public repo stays free of binaries. Image stems below resolve
// to /images/dickinson/{stem}.webp; audio sits under /trailers/dickinson/.
const MS = 'https://media.agoracosmica.org/images/dickinson';
const msUrl = (stem: string) => `${MS}/${stem}.webp`;

const lang = 'en' as const;

// --- Poems, manuscript leaves and repositories: one copy in the data module,
//     shared with the page each poem has of its own ---

// Optional per-poem note (reusable): surfaces a spot where the manuscript reading
// is kept over a smoothed printed one. Empty for now.
const POEM_NOTES: Record<string, string> = {};

// Echo-voice recording of "This is my letter to the World", the closing teaser
// by the CTA (you've read her words + seen her hand, now hear her). Set to the
// media-CDN MP3 URL once generated (ElevenLabs /with-timestamps, real Echo
// voice). Empty string = the player does not render, so the page never ships an
// empty/broken audio control. Save the .timestamps.json alongside the .mp3.
// Upload both to R2 (media.agoracosmica.org) and paste the URLs here. Both are
// allowed by media-src in the header CSP (https://*.agoracosmica.org) and the
// meta CSP does not restrict media, so NO header/hash change is needed.
// e.g. 'https://media.agoracosmica.org/audio/emily-dickinson/letter-echo.mp3'
// Currently served locally from public/audio (= 'self') so it previews now.
// To move to R2 later, just swap these two to the media.agoracosmica.org URLs.
const ECHO_AUDIO = 'https://media.agoracosmica.org/trailers/dickinson/letter-echo.mp3';
const ECHO_AUDIO_WEBM = 'https://media.agoracosmica.org/trailers/dickinson/letter-echo.webm';
const ECHO_AUDIO_POEM = 'This is my letter to the World';

// --- Themes: the page's spine (title + a short framing + the poems in it) ---
const THEMES = [
  {
    id: 'death',
    title: 'On death, and what waits',
    framing:
      'Death was never an ending for Dickinson. It was a visitor, a carriage, a fly in the room. She wrote about it the way you write about something you have looked at closely and stopped fearing.',
    poems: ['chariot', 'dying', 'alabaster'],
  },
  {
    id: 'self',
    title: 'The self, and its closed door',
    framing:
      'She chose her own company and shut the door on the rest. These are poems about identity and power, the inner life she guarded, and how vast it turned out to be.',
    poems: ['nobody', 'loadedgun', 'exclusion', 'letter'],
  },
  {
    id: 'hope',
    title: 'Hope, and what survives',
    framing:
      'Hope, in her hands, is not loud. It is a small bird that sings in the worst weather and never asks for anything back.',
    poems: ['hope', 'success'],
  },
  {
    id: 'nature',
    title: 'Nature, watched up close',
    framing:
      'Dickinson watched the small world closely, a snake in the grass, a bird on the path, and found the whole of it strange and alive.',
    poems: ['snake', 'garden'],
  },
  {
    id: 'mind',
    title: 'The mind, truth, and books',
    framing:
      'How much truth can a person take at once, and where do we go to escape? She thought a book could carry you further than any ship, and that the truth is best told a little sideways.',
    poems: ['tellslant', 'brain', 'frigate'],
  },
  {
    id: 'despair',
    title: 'The dark weather',
    framing:
      'She mapped despair like a kind of weather. A slant of winter light. A funeral held inside the skull. Few people have described the inside of a hard day better.',
    poems: ['slant', 'funeral'],
  },
  {
    id: 'longing',
    title: 'Longing',
    framing: 'And sometimes she simply wanted. These are her wildest lines.',
    poems: ['wildnights'],
  },
];

// --- JSON-LD: the citable interpretive layer (poem text itself is Gutenberg's
//     turf; our value is the curation + framing). ---
const PAGE_URL = 'https://agoracosmica.org/figures/emily-dickinson/poems/';
const dickinson = {
  '@type': 'Person',
  '@id': `${PAGE_URL}#person`,
  name: 'Emily Dickinson',
  birthDate: '1830-12-10',
  deathDate: '1886-05-15',
  birthPlace: 'Amherst, Massachusetts',
  sameAs: ['https://en.wikipedia.org/wiki/Emily_Dickinson', 'https://www.wikidata.org/wiki/Q4441'],
};
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: "Emily Dickinson's poems, by what they're about",
    url: PAGE_URL,
    about: dickinson,
    inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', name: 'Agora Cosmica', url: 'https://agoracosmica.org' },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: THEMES.flatMap(t => t.poems).map((key, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: { '@type': 'CreativeWork', name: POEMS[key].firstLine, inLanguage: 'en', author: dickinson },
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: "What are Emily Dickinson's poems about?",
        acceptedAnswer: {
          '@type': 'Answer',
          text: "Emily Dickinson's poems return again and again to a handful of subjects: death and immortality, the inner self and its privacy, hope, despair, the close watching of nature, the limits of the mind, and longing. She wrote nearly eighteen hundred poems and published almost none of them in her lifetime.",
        },
      },
      {
        '@type': 'Question',
        name: "Why do Emily Dickinson's poems use so many dashes?",
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Dickinson wrote with dashes instead of ordinary commas and periods, and capitalized nouns inside her lines. The smoothed versions printed after her death removed much of this. The poems here are transcribed from her own manuscripts, so the dashes and capitals are hers.',
        },
      },
    ],
  },
];
---
<Public
  title="Emily Dickinson's poems, in her own hand"
  description="Emily Dickinson's poems by theme: death, the self, hope, nature, mind. Transcribed from her own manuscripts, her dashes kept. Read a few, then talk with her."
  canonicalPath="/figures/emily-dickinson/poems"
  lang={lang}
  ogType="article"
  noindex={false}
  noHreflang={true}
  stickyCta={false}
  schemas={schemas}
>
  <div class="pub-content ed">
    <Breadcrumbs
      lang={lang}
      items={[
        { label: 'Figures', path: '/figures' },
        { label: 'Emily Dickinson', path: '/figures/emily-dickinson' },
        { label: 'Poems' },
      ]}
    />

    <header class="ed-hero">
      <figure class="ed-hero__portrait">
        <img
          class="ed-hero__img"
          src={msUrl('portrait-1847')}
          alt="Emily Dickinson, daguerreotype, about 1847"
          width="560"
          height="688"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption class="ed-hero__caption">Emily Dickinson, c. 1847</figcaption>
      </figure>
      <div class="ed-hero__text">
        <p class="ed-hero__eyebrow">In her own words</p>
        <h1 class="ed-hero__title">Emily Dickinson</h1>
        <p class="ed-hero__dates">1830-1886 · Amherst, Massachusetts</p>
        <p class="ed-hero__lead">
          She wrote nearly eighteen hundred poems and published almost none of
          them. She kept them in a drawer, stitched into little hand-sewn
          booklets, and let almost no one read them. What survives is a mind
          testing the largest questions in the smallest spaces. Here are a few
          of her poems, grouped by what they reach for, in the words and dashes
          she actually used.
        </p>
      </div>
    </header>

    <PoemDoor
      at="hero"
      href={DOOR_HREF}
      buttonLabel="Ask her Echo about it"
      figureId="dickinson"
      shapedBy="her poems and letters"
    />

    {THEMES.map((theme, ti) => (
      <section class="ed-theme" id={`theme-${theme.id}`}>
        <h2 class="ed-theme__title">{theme.title}</h2>
        <p class="ed-theme__framing">{theme.framing}</p>
        <div class="ed-poems">
          {theme.poems.map((key, i) => (
            <Fragment>
              <details class="ed-poem" open={ti === 0 && i === 0}>
                <summary class="ed-poem__first-line">{POEMS[key].firstLine}</summary>
                <div class="ed-poem__body">
                  <div class="ed-poem__text">{POEMS[key].text}</div>
                  {POEM_NOTES[key] && <p class="ed-poem__note">{POEM_NOTES[key]}</p>}
                  <p class="ed-poem__own">
                    <a class="pub-textlink" href={OWN_PAGE[key]}>Open this poem on its own page</a>
                  </p>
                  {FACS_LEAVES[key] ? (
                    FACS_LEAVES[key].length > 1 ? (
                      <figure class="ed-hand">
                        <div
                          class="ed-carousel"
                          data-ed-carousel
                          role="group"
                          aria-roledescription="carousel"
                          aria-label={`Manuscript of "${POEMS[key].firstLine}", ${FACS_LEAVES[key].length} pages`}
                        >
                          <div class="ed-carousel__track">
                            {FACS_LEAVES[key].map((leaf, n) => (
                              <a
                                class="ed-carousel__slide"
                                href={msUrl(leaf)}
                                target="_blank"
                                rel="noopener"
                                aria-label={`Page ${n + 1} of ${FACS_LEAVES[key].length}, manuscript of "${POEMS[key].firstLine}", opens full size in a new tab`}
                              >
                                <img
                                  class="ed-hand__img"
                                  src={msUrl(leaf)}
                                  alt={`Emily Dickinson's manuscript of "${POEMS[key].firstLine}", page ${n + 1} of ${FACS_LEAVES[key].length}`}
                                  loading="lazy"
                                  decoding="async"
                                />
                              </a>
                            ))}
                          </div>
                          <div class="ed-carousel__dots" hidden>
                            {FACS_LEAVES[key].map((_, n) => (
                              <button type="button" class="ed-carousel__dot" data-ed-dot aria-current={n === 0 ? 'true' : 'false'} aria-label={`Go to page ${n + 1}`}></button>
                            ))}
                          </div>
                        </div>
                        <figcaption class="ed-hand__caption">
                          In her own hand · {FACS[key].repo} · {FACS_LEAVES[key].length} pages
                          <span class="ed-hand__zoom"> · swipe, or open full size</span>
                        </figcaption>
                      </figure>
                    ) : (
                      <figure class="ed-hand">
                        <div class="ed-hand__leaves is-single">
                          <a
                            class="ed-hand__leaf"
                            href={msUrl(FACS_LEAVES[key][0])}
                            target="_blank"
                            rel="noopener"
                            aria-label={`Open the manuscript of "${POEMS[key].firstLine}" full size in a new tab`}
                          >
                            <img
                              class="ed-hand__img"
                              src={msUrl(FACS_LEAVES[key][0])}
                              alt={`Emily Dickinson's handwritten manuscript of "${POEMS[key].firstLine}"`}
                              loading="lazy"
                              decoding="async"
                            />
                          </a>
                        </div>
                        <figcaption class="ed-hand__caption">
                          In her own hand · {FACS[key].repo}
                          <span class="ed-hand__zoom"> · open full size</span>
                        </figcaption>
                      </figure>
                    )
                  ) : (
                    <p class="ed-poem__provenance">
                      In her own hand: {FACS[key].repo} ({FACS[key].cite})
                    </p>
                  )}
                </div>
              </details>
              {ti === 0 && i === 0 && (
                <PoemDoor
                  at="after-first-poem"
                  href={DOOR_HREF}
                  buttonLabel="Ask her Echo about it"
                  figureId="dickinson"
                  shapedBy="her poems and letters"
                />
              )}
            </Fragment>
          ))}
        </div>
      </section>
    ))}

    <aside class="ed-invite">
      <p class="ed-invite__eyebrow">A living library you can talk to</p>
      <p class="ed-invite__line">
        You have just read Emily Dickinson in her own words and seen her own
        hand. On Agora Cosmica you can go one step further: hear narrated stories
        from her life, sit with the ideas behind the poems, and talk them through
        with her Echo, a voice shaped by her poems and letters.
      </p>
      <a
        class="ed-invite__button pub-cta__button"
        href={'/app?figure=emily-dickinson&lang=en'}
        data-agc-cta="start-exploring"
        data-agc-figure="dickinson"
      >
        Learn from her Echo
      </a>
      <p class="ed-invite__reassure">Nonprofit · Open Source · No tracking cookies, no profiling</p>
      <p class="ed-invite__reassure">30 free messages a day. No signup needed.</p>
      {ECHO_AUDIO && (
        <div class="ed-listen" data-ed-audio>
          <p class="ed-listen__eyebrow">In her Echo's voice. An AI voice, not a recording.</p>
          <p class="ed-listen__poem">"{ECHO_AUDIO_POEM}"</p>
          {/* Styled play button (reveals via JS); native controls below are the
              no-JS fallback, hidden by the script once it takes over. */}
          <button type="button" class="pub-trailer ed-listen__btn" data-ed-audio-btn aria-pressed="false" hidden>
            <span class="pub-trailer__icon" data-ed-audio-icon aria-hidden="true">
              <svg viewBox="0 0 16 16" width="13" height="13" fill="currentColor"><path d="M4 3l9 5-9 5z"></path></svg>
            </span>
            <span class="pub-trailer__label" data-ed-audio-label>Hear her letter</span>
            <span class="pub-trailer__dur">0:17</span>
          </button>
          <audio class="ed-listen__player" data-ed-audio-el controls preload="none">
            {ECHO_AUDIO_WEBM && <source src={ECHO_AUDIO_WEBM} type="audio/webm" />}
            <source src={ECHO_AUDIO} type="audio/mpeg" />
            <a href={ECHO_AUDIO}>Download the recording</a>
          </audio>
        </div>
      )}
      <p class="ed-invite__more">
        <a class="pub-textlink" href="/figures/emily-dickinson/">Read more about Emily Dickinson</a>
      </p>
    </aside>

    <script>
      // Feed the Echo teaser into the shared listened accumulator like every
      // other marketing play surface. The playback UI stays in /ed-audio.js
      // (its no-JS fallback intact); this only counts seconds actually heard.
      import { trackHeardSeconds } from '../../../utils/heardSeconds';
      const audio = document.querySelector('[data-ed-audio-el]');
      if (audio instanceof HTMLAudioElement) {
        trackHeardSeconds(audio, () => 'dickinson');
      }
    </script>

    <footer class="ed-sources">
      <p>
        The poems here are transcribed from Dickinson's own manuscripts, which
        are in the public domain. Her dashes, capital letters, and spellings are
        kept as she wrote them, so these read differently from the smoothed
        versions printed after her death. The manuscript images are reproduced
        courtesy of the libraries that hold them: the Boston Public Library (no
        known copyright restrictions), Amherst College Archives and Special
        Collections (free for non-commercial and educational use, with credit),
        and the Houghton Library at Harvard University, whose policy permits
        publishing images of its public-domain holdings. The modern dash-faithful
        scholarly editions remain under copyright and are not used here.
      </p>
    </footer>
  </div>
</Public>

<style>
  /* Scoped reading-room treatment. Uses brand design tokens only; adds no
     global CSS (architecture frozen at 89/100). */
  .ed {
    max-width: 46rem;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 4rem;
  }

  /* Hero */
  .ed-hero {
    display: flex;
    gap: 1.75rem;
    align-items: center;
    margin: 1.5rem 0 3.5rem;
  }
  .ed-hero__portrait {
    flex: 0 0 auto;
    width: 132px;
    margin: 0;
    text-align: center;
  }
  .ed-hero__img {
    width: 132px;
    aspect-ratio: 4 / 5;
    height: auto;
    border-radius: 3px;
    object-fit: cover;
    object-position: center 30%;
    border: 1px solid color-mix(in srgb, var(--gold-subtle) 38%, transparent);
    box-shadow: 0 8px 24px color-mix(in srgb, #000 38%, transparent);
  }
  .ed-hero__caption {
    margin: 0.55rem 0 0;
    font-size: 0.66rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-secondary);
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
  }
  .ed-hero__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.72rem;
    color: var(--gold-primary);
    margin: 0 0 0.4rem;
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
  }
  .ed-hero__title {
    font-size: clamp(2rem, 5vw, 2.9rem);
    line-height: 1.05;
    margin: 0 0 0.5rem;
    color: var(--text-primary);
  }
  .ed-hero__dates {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin: 0 0 1rem;
  }
  .ed-hero__lead {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0;
    max-width: 34rem;
  }

  /* Themed sections */
  .ed-theme {
    margin: 0 0 3.25rem;
  }
  .ed-theme__title {
    font-size: clamp(1.4rem, 3.5vw, 1.85rem);
    color: var(--gold-primary);
    margin: 0 0 0.6rem;
    line-height: 1.2;
  }
  .ed-theme__framing {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0 0 2rem;
    max-width: 36rem;
  }

  /* Poems: the reading layer */
  .ed-poems {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }
  .ed-poem {
    border-left: 2px solid color-mix(in srgb, var(--gold-subtle) 30%, transparent);
    padding-left: 1.5rem;
  }
  .ed-poem__first-line {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0.4rem 0;
    gap: 0.65rem;
    font-size: 0.84rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--gold-subtle);
    font-weight: 500;
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
    transition: color 0.15s ease;
  }
  .ed-poem__first-line::-webkit-details-marker {
    display: none;
  }
  .ed-poem__first-line::before {
    content: '+';
    color: var(--gold-primary);
    font-size: 1.05rem;
    line-height: 1;
  }
  .ed-poem[open] > .ed-poem__first-line::before {
    content: '\2212';
  }
  .ed-poem__first-line:hover {
    color: var(--gold-hover);
  }
  .ed-poem[open] > .ed-poem__first-line {
    color: var(--gold-primary);
  }
  .ed-poem__text {
    white-space: pre-line;
    font-family: 'Iowan Old Style', Palatino, Georgia, 'Times New Roman', serif;
    font-size: 1.16rem;
    line-height: 1.75;
    color: var(--text-primary);
    margin-top: 1.05rem;
  }
  .ed-poem__own {
    margin: 1.4rem 0 0;
    font-size: 0.82rem;
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
  }
  .ed-poem__note {
    margin: 1rem 0 0;
    padding-left: 0.9rem;
    border-left: 2px solid color-mix(in srgb, var(--gold-subtle) 35%, transparent);
    font-size: 0.82rem;
    line-height: 1.55;
    font-style: italic;
    color: var(--text-secondary);
    max-width: 32rem;
  }

  /* "In her own hand" facsimile (single image or a multi-leaf gallery) */
  .ed-hand {
    margin: 1.75rem 0 0;
  }
  .ed-hand__leaves.is-single {
    max-width: 420px;
  }
  .ed-hand__leaf {
    display: block;
    border: 1px solid color-mix(in srgb, var(--gold-subtle) 30%, transparent);
    border-radius: 4px;
    overflow: hidden;
    background: color-mix(in srgb, #fff 92%, var(--gold-subtle) 8%);
    transition: border-color 0.15s ease;
  }
  .ed-hand__leaf:hover,
  .ed-hand__leaf:focus-visible {
    border-color: var(--gold-primary);
  }
  .ed-hand__img {
    display: block;
    width: 100%;
    height: auto;
    /* Reserve space before lazy load to stop layout shift. Manuscript leaves are
       portrait but vary; 3 / 4 is a conservative placeholder, height: auto lets
       the real ratio take over once the image decodes. */
    aspect-ratio: 3 / 4;
  }

  /* Carousel for multi-leaf manuscripts: native swipe + snap, dots track position.
     Works with no JS (swipe + snap are pure CSS); the bundled script only adds
     active-dot tracking and click-to-page (progressive enhancement). */
  .ed-carousel {
    max-width: 420px;
  }
  .ed-carousel__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    border-radius: 4px;
    border: 1px solid color-mix(in srgb, var(--gold-subtle) 30%, transparent);
    background: color-mix(in srgb, #fff 92%, var(--gold-subtle) 8%);
  }
  .ed-carousel__track::-webkit-scrollbar {
    display: none;
  }
  .ed-carousel__slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    display: block;
  }
  .ed-carousel__slide:focus-visible {
    outline: 2px solid var(--gold-primary);
    outline-offset: -2px;
  }
  .ed-carousel__dots {
    display: flex;
    justify-content: center;
    gap: 0.1rem;
    margin-top: 0.4rem;
  }
  .ed-carousel__dot {
    width: 44px;
    height: 44px;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .ed-carousel__dot::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--gold-subtle) 65%, transparent);
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .ed-carousel__dot[aria-current='true']::before {
    background: var(--gold-primary);
    transform: scale(1.35);
  }
  .ed-hand__caption {
    margin: 0.6rem 0 0;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
  }
  .ed-hand__zoom {
