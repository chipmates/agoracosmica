---
// A page for each Dickinson poem the collection page hosts. The searcher who
// types a first line lands on that poem and nothing else.

import PoemPage from '../../../../components/PoemPage.astro';
import PlayerHead from '../../../../components/player/PlayerHead.astro';
import PlayerDock from '../../../../components/player/PlayerDock.astro';
import { isStoryCompanionPath } from '../../../../player/pages';
import { poemsByPoet } from '../../../../data/poems/index.mjs';

export function getStaticPaths() {
  return poemsByPoet('dickinson').map((poem) => ({
    params: { poem: poem.slug },
    props: { poem },
  }));
}

const { poem } = Astro.props;
// A companion page of a story player figure: the dock keeps playing here.
const storyDock = isStoryCompanionPath(Astro.url.pathname);
---
<PoemPage poem={poem}>
  {storyDock && <PlayerHead slot="head" />}
  {storyDock && <PlayerDock slot="dock" lang="en" />}
</PoemPage>
