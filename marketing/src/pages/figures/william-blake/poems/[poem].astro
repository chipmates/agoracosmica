---
// A page for each Blake poem the collection page hosts. The searcher who types
// a title lands on that poem and nothing else.

import PoemPage from '../../../../components/PoemPage.astro';
import { poemsByPoet } from '../../../../data/poems/index.mjs';

export function getStaticPaths() {
  return poemsByPoet('blake').map((poem) => ({
    params: { poem: poem.slug },
    props: { poem },
  }));
}

const { poem } = Astro.props;
---
<PoemPage poem={poem} />
