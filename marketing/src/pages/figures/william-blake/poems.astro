---
// William Blake: twelve poems from Songs of Innocence and of Experience, in
// two contrary halves, each with a one-breath introduction. The poem texts are
// public domain (Blake died in 1827) and are inserted verbatim, by script,
// from Poems of William Blake, Project Gutenberg ebook 574, a late-19th-century
// text that keeps the famous Tyger spelling while smoothing some others
// (London reads wandered/chartered there). Punctuation follows that edition,
// including its occasional ASCII double-hyphen dashes: quoted primary source,
// not house style. Titles are shown in their conventional form.
// English single page without a DE twin: hreflang points at itself (the
// validate-seo allowlist is a shared file this build does not touch).

import Public from '../../../layouts/Public.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import EssayStyles from '../../../components/EssayStyles.astro';
import EssayInvite from '../../../components/EssayInvite.astro';
import PoemDoor from '../../../components/PoemDoor.astro';
import { figureImage } from '../../../lib/figureImages';
import { breadcrumbSchema } from '../../../lib/schemas';
import { canonicalUrl, SITE_URL } from '../../../lib/urls';
import { blakePoems as POEMS, blakeGroups as GROUPS } from '../../../data/poems/blake.mjs';
import { poemsByPoet } from '../../../data/poems/index.mjs';

const lang = 'en' as const;
// Slot 4 of the app's ask contract is this page's own question: the door skips
// the mode choice and opens Free Talk about the poem the visitor just read.
const DOOR_HREF = '/app?figure=william-blake&lang=en&ask=f:blake:4';
const PAGE_PATH = '/figures/william-blake/poems';
const PAGE_URL = canonicalUrl(PAGE_PATH);

const metaTitle = "William Blake's Poems, from Innocence to Experience";
const metaDescription =
  'Twelve poems by William Blake from Songs of Innocence and of Experience, with short introductions: The Tyger, London, The Lamb, A Poison Tree, and more.';

// The texts and the two groups live in the data module, one copy shared with
// the page each poem has of its own, which is also where each poem's own URL
// comes from.
const OWN_PAGE: Record<string, string> = Object.fromEntries(
  poemsByPoet('blake').map((poem) => [poem.key, poem.path]),
);

const blake = {
  '@type': 'Person',
  '@id': `${PAGE_URL}#person`,
  name: 'William Blake',
  birthDate: '1757-11-28',
  deathDate: '1827-08-12',
  birthPlace: 'London',
  sameAs: ['https://en.wikipedia.org/wiki/William_Blake', 'https://www.wikidata.org/wiki/Q41513'],
};
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: metaTitle,
    url: PAGE_URL,
    about: blake,
    inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', name: 'Agora Cosmica', url: SITE_URL },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: GROUPS.flatMap(g => g.poems).map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: { '@type': 'CreativeWork', name: p.title, inLanguage: 'en', author: blake },
      })),
    },
  },
  breadcrumbSchema([
    { name: 'Home', url: `${SITE_URL}/` },
    { name: 'Figures', url: `${SITE_URL}/figures/` },
    { name: 'William Blake', url: `${SITE_URL}/figures/william-blake/` },
    { name: 'Poems', url: PAGE_URL },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What are Songs of Innocence and of Experience?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Two sets of poems William Blake engraved, printed, and colored himself: Songs of Innocence in 1789 and Songs of Experience in 1794, then bound as one book showing, in his phrase, the two contrary states of the human soul. Many poems in one half answer a poem in the other.',
        },
      },
      {
        '@type': 'Question',
        name: 'Why do The Lamb and The Tyger belong together?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'The Lamb, from Innocence, asks who made the gentlest of creatures and answers confidently. The Tyger, from Experience, asks whether the same maker framed the most fearsome one, and never answers. Read together they are one question about creation seen from its two sides.',
        },
      },
    ],
  },
];
---
<Public
  title={metaTitle}
  fullTitle={metaTitle}
  ogTitle={`${metaTitle} | Agora Cosmica`}
  description={metaDescription}
  canonicalPath={PAGE_PATH}
  lang={lang}
  ogType="article"
  ogImage={figureImage('blake', 'main', 1200)}
  ogImageAlt="AI-generated portrait: William Blake"
  noHreflang={true}
  stickyCta={false}
  schemas={schemas}
>
  <EssayStyles />
  <div class="pub-content esy">
    <Breadcrumbs
      lang={lang}
      items={[
        { label: 'Figures', path: '/figures' },
        { label: 'William Blake', path: '/figures/william-blake' },
        { label: 'Poems' },
      ]}
    />

    <header class="esy-hero">
      <p class="esy-hero__eyebrow">In his own words</p>
      <h1 class="esy-hero__title">William Blake</h1>
      <p class="esy-hero__lead">
        1757-1827 · London. Engraver, painter, and poet, ignored in his own
        lifetime and unlike anyone before or since. He wrote his poems, etched
        them into copper with his own illustrations, printed them, and colored
        them by hand, book by book. Here are twelve from his two contrary
        collections, the trusting songs of 1789 and the open-eyed ones of 1794,
        each with a line of introduction to hand you the door.
      </p>
    </header>

    <PoemDoor
      at="hero"
      href={DOOR_HREF}
      buttonLabel="Ask his Echo about it"
      figureId="blake"
      shapedBy="his real work"
    />

    {GROUPS.map((group, gi) => (
      <section class="esy-section" id={group.id}>
        <h2 class="esy-h2">{group.title}</h2>
        <p class="esy-p">{group.framing}</p>
        <div class="esy-poemlist">
          {group.poems.map((p, i) => (
            <Fragment>
              <details class="esy-poem" open={gi === 0 && i === 0}>
                <summary class="esy-poem__summary">{p.title}</summary>
                <p class="esy-poem__intro">{p.intro}</p>
                <div class="esy-poem__text">{POEMS[p.key].text.split('\n\n').map(stanza => (<div class="esy-poem__stanza">{stanza.split('\n').map(line => (<span class="esy-poem__line">{line}</span>))}</div>))}</div>
                <p class="esy-poem__own">
                  <a class="pub-textlink" href={OWN_PAGE[p.key]}>Open this poem on its own page</a>
                </p>
              </details>
              {gi === 0 && i === 0 && (
                <PoemDoor
                  at="after-first-poem"
                  href={DOOR_HREF}
                  buttonLabel="Ask his Echo about it"
                  figureId="blake"
                  shapedBy="his real work"
                />
              )}
            </Fragment>
          ))}
        </div>
      </section>
    ))}

    <EssayInvite
      lang={lang}
      line="You have just read Blake in his own words. On Agora Cosmica you can hear his life told in chapters, sit with the ideas behind the poems, and talk them through with his Echo, an AI voice grounded in his real work. An interpretation, never the man himself."
      href="/app?figure=william-blake&lang=en"
      buttonLabel="Learn from his Echo"
      figureId="blake"
      portraitAlt="AI-generated portrait of William Blake"
      moreLinks={[
        { label: 'William Blake, the figure', href: '/figures/william-blake/' },
        { label: 'Where do ideas come from?', href: '/themes/mind-creativity/' },
        { label: "Emily Dickinson's poems", href: '/figures/emily-dickinson/poems/' },
      ]}
    />

    <footer class="esy-sources">
      <p>
        The poems are in the public domain. The texts here follow Poems of
        William Blake, Project Gutenberg ebook 574, reproduced verbatim,
        punctuation included. That late 19th century text keeps the famous
        Tyger spelling while smoothing some others, so a few lines read
        slightly differently than in Blake's original etched plates. Songs of
        Innocence first appeared in 1789, Songs of Experience in 1794,
        combined by Blake into one book whose title page promises to show the
        two contrary states of the human soul. The introductions and
        groupings are ours.
      </p>
    </footer>
  </div>
</Public>

<style is:global>
  /* The one line this page adds to the shared poem layer: the way out to the
     poem's own page. */
  .esy-poem__own {
    margin: 1.25rem 0 0;
    font-size: var(--text-sm);
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
  }
</style>
