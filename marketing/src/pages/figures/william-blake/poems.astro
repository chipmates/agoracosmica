---
// William Blake: twelve poems from Songs of Innocence and of Experience, in
// two contrary halves, each with a one-breath introduction. The poem texts are
// public domain (Blake died in 1827) and are inserted verbatim, by script,
// from Poems of William Blake, Project Gutenberg ebook 574, a late-19th-century
// text that keeps the famous Tyger spelling while smoothing some others
// (London reads wandered/chartered there). Punctuation follows that edition,
// including its occasional ASCII double-hyphen dashes: quoted primary source,
// not house style. Titles are shown in their conventional form.
// English single page without a DE twin: hreflang points at itself (the
// validate-seo allowlist is a shared file this build does not touch).

import Public from '../../../layouts/Public.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import EssayStyles from '../../../components/EssayStyles.astro';
import EssayInvite from '../../../components/EssayInvite.astro';
import { figureImage } from '../../../lib/figureImages';
import { breadcrumbSchema } from '../../../lib/schemas';
import { canonicalUrl, SITE_URL } from '../../../lib/urls';

const lang = 'en' as const;
const PAGE_PATH = '/figures/william-blake/poems';
const PAGE_URL = canonicalUrl(PAGE_PATH);

const metaTitle = "William Blake's Poems, from Innocence to Experience";
const metaDescription =
  'Twelve poems by William Blake from Songs of Innocence and of Experience, with short introductions: The Tyger, London, The Lamb, A Poison Tree, and more.';

// Verbatim texts from Project Gutenberg ebook 574 (see header). Inserted by
// the extraction script, never retyped by hand.
const POEMS: Record<string, { text: string }> = {
  "introduction": {
    "text": "Piping down the valleys wild,\n  Piping songs of pleasant glee,\nOn a cloud I saw a child,\n  And he laughing said to me:\n\n\"Pipe a song about a Lamb!\"\n  So I piped with merry cheer.\n\"Piper, pipe that song again;\"\n  So I piped: he wept to hear.\n\n\"Drop thy pipe, thy happy pipe;\n  Sing thy songs of happy cheer!\"\nSo I sang the same again,\n  While he wept with joy to hear.\n\n\"Piper, sit thee down and write\n  In a book, that all may read.\"\nSo he vanish'd from my sight;\n  And I pluck'd a hollow reed,\n\nAnd I made a rural pen,\n  And I stain'd the water clear,\nAnd I wrote my happy songs\n  Every child may joy to hear."
  },
  "lamb": {
    "text": "  Little Lamb, who made thee\n  Dost thou know who made thee,\nGave thee life, and bid thee feed\nBy the stream and o'er the mead;\nGave thee clothing of delight,\nSoftest clothing, woolly, bright;\nGave thee such a tender voice,\nMaking all the vales rejoice?\n  Little Lamb, who made thee?\n  Dost thou know who made thee?\n\n  Little Lamb, I'll tell thee;\n  Little Lamb, I'll tell thee:\nHe is called by thy name,\nFor He calls Himself a Lamb\nHe is meek, and He is mild,\nHe became a little child.\nI a child, and thou a lamb,\nWe are called by His name.\n  Little Lamb, God bless thee!\n  Little Lamb, God bless thee!"
  },
  "chimneyi": {
    "text": "When my mother died I was very young,\nAnd my father sold me while yet my tongue\nCould scarcely cry \"Weep! weep! weep! weep!\"\nSo your chimneys I sweep, and in soot I sleep.\n\nThere's little Tom Dacre, who cried when his head,\nThat curled like a lamb's back, was shaved; so I said,\n\"Hush, Tom! never mind it, for, when your head's bare,\nYou know that the soot cannot spoil your white hair.\"\n\nAnd so he was quiet, and that very night,\nAs Tom was a-sleeping, he had such a sight!--\nThat thousands of sweepers, Dick, Joe, Ned, and Jack,\nWere all of them locked up in coffins of black.\n\nAnd by came an angel, who had a bright key,\nAnd he opened the coffins, and let them all free;\nThen down a green plain, leaping, laughing, they run,\nAnd wash in a river, and shine in the sun.\n\nThen naked and white, all their bags left behind,\nThey rise upon clouds, and sport in the wind;\nAnd the Angel told Tom, if he'd be a good boy,\nHe'd have God for his father, and never want joy.\n\nAnd so Tom awoke, and we rose in the dark,\nAnd got with our bags and our brushes to work.\nThough the morning was cold, Tom was happy and warm:\nSo, if all do their duty, they need not fear harm."
  },
  "divine": {
    "text": "To Mercy, Pity, Peace, and Love,\n  All pray in their distress,\nAnd to these virtues of delight\n  Return their thankfulness.\n\nFor Mercy, Pity, Peace, and Love,\n  Is God our Father dear;\nAnd Mercy, Pity, Peace, and Love,\n  Is man, his child and care.\n\nFor Mercy has a human heart\n  Pity, a human face;\nAnd Love, the human form divine;\n  And Peace, the human dress.\n\nThen every man, of every clime,\n  That prays in his distress,\nPrays to the human form divine:\n  Love, Mercy, Pity, Peace.\n\nAnd all must love the human form,\n  In heathen, Turk, or Jew.\nWhere Mercy, Love, and Pity dwell,\n  There God is dwelling too."
  },
  "infantjoy": {
    "text": "\"I have no name;\nI am but two days old.\"\nWhat shall I call thee?\n\"I happy am,\nJoy is my name.\"\nSweet joy befall thee!\n\nPretty joy!\nSweet joy, but two days old.\nSweet Joy I call thee:\nThou dost smile,\nI sing the while;\nSweet joy befall thee!"
  },
  "tyger": {
    "text": "Tyger, tyger, burning bright\nIn the forests of the night,\nWhat immortal hand or eye\nCould frame thy fearful symmetry?\n\nIn what distant deeps or skies\nBurnt the fire of thine eyes?\nOn what wings dare he aspire?\nWhat the hand dare seize the fire?\n\nAnd what shoulder and what art\nCould twist the sinews of thy heart?\nAnd, when thy heart began to beat,\nWhat dread hand and what dread feet?\n\nWhat the hammer?  what the chain?\nIn what furnace was thy brain?\nWhat the anvil? what dread grasp\nDare its deadly terrors clasp?\n\nWhen the stars threw down their spears,\nAnd watered heaven with their tears,\nDid he smile his work to see?\nDid he who made the lamb make thee?\n\nTyger, tyger, burning bright\nIn the forests of the night,\nWhat immortal hand or eye\nDare frame thy fearful symmetry?"
  },
  "london": {
    "text": "I wandered through each chartered street,\n  Near where the chartered Thames does flow,\nA mark in every face I meet,\n  Marks of weakness, marks of woe.\n\nIn every cry of every man,\n  In every infant's cry of fear,\nIn every voice, in every ban,\n  The mind-forged manacles I hear:\n\nHow the chimney-sweeper's cry\n  Every blackening church appalls,\nAnd the hapless soldier's sigh\n  Runs in blood down palace-walls.\n\nBut most, through midnight streets I hear\n  How the youthful harlot's curse\nBlasts the new-born infant's tear,\n  And blights with plagues the marriage-hearse."
  },
  "sickrose": {
    "text": "O rose, thou art sick!\n  The invisible worm,\nThat flies in the night,\n  In the howling storm,\n\nHas found out thy bed\n  Of crimson joy,\nAnd his dark secret love\n  Does thy life destroy."
  },
  "poisontree": {
    "text": "I was angry with my friend:\nI told my wrath, my wrath did end.\nI was angry with my foe:\nI told it not, my wrath did grow.\n\nAnd I watered it in fears\nNight and morning with my tears,\nAnd I sunned it with smiles\nAnd with soft deceitful wiles.\n\nAnd it grew both day and night,\nTill it bore an apple bright,\nAnd my foe beheld it shine,\nand he knew that it was mine,--\n\nAnd into my garden stole\nWhen the night had veiled the pole;\nIn the morning, glad, I see\nMy foe outstretched beneath the tree."
  },
  "clodpebble": {
    "text": "\"Love seeketh not itself to please,\n  Nor for itself hath any care,\nBut for another gives it ease,\n  And builds a heaven in hell's despair.\"\n\nSo sang a little clod of clay,\n  Trodden with the cattle's feet,\nBut a pebble of the brook\n  Warbled out these metres meet:\n\n\"Love seeketh only Self to please,\n  To bind another to its delight,\nJoys in another's loss of ease,\n  And builds a hell in heaven's despite.\""
  },
  "gardenlove": {
    "text": "I laid me down upon a bank,\n  Where Love lay sleeping;\nI heard among the rushes dank\n  Weeping, weeping.\n\nThen I went to the heath and the wild,\n  To the thistles and thorns of the waste;\nAnd they told me how they were beguiled,\n  Driven out, and compelled to the chaste.\n\nI went to the Garden of Love,\n  And saw what I never had seen;\nA Chapel was built in the midst,\n  Where I used to play on the green.\n\nAnd the gates of this Chapel were shut\n  And \"Thou shalt not,\" writ over the door;\nSo I turned to the Garden of Love\n  That so many sweet flowers bore.\n\nAnd I saw it was filled with graves,\n  And tombstones where flowers should be;\nAnd priests in black gowns were walking their rounds,\n  And binding with briars my joys and desires."
  },
  "chimneye": {
    "text": "A little black thing in the snow,\nCrying \"weep! weep!\" in notes of woe!\n\"Where are thy father and mother? Say!\"--\n\"They are both gone up to the church to pray.\n\n\"Because I was happy upon the heath,\nAnd smiled among the winter's snow,\nThey clothed me in the clothes of death,\nAnd taught me to sing the notes of woe.\n\n\"And because I am happy and dance and sing,\nThey think they have done me no injury,\nAnd are gone to praise God and his priest and king,\nWho make up a heaven of our misery.\""
  }
};

const GROUPS = [
  {
    id: 'innocence',
    title: 'From Songs of Innocence (1789)',
    framing:
      'Blake engraved, printed, and hand-colored these poems himself in 1789. They speak in and about the voices of children: pastoral, trusting, sung. The innocence is real. So is the world waiting around its edges.',
    poems: [
      {
        key: 'introduction',
        title: 'Introduction',
        intro:
          'The book opens with a piper meeting a child on a cloud. The child asks for a song, then asks for it to be written down. All of Innocence presents itself as songs a child asked for.',
      },
      {
        key: 'lamb',
        title: 'The Lamb',
        intro:
          'A child asks a lamb who made it, then answers the question. The counter-question lives in Experience, in The Tyger below.',
      },
      {
        key: 'chimneyi',
        title: 'The Chimney Sweeper',
        intro:
          "Boys of five and six were sold to climb London's chimneys. Blake gives one of them a dream of release that has to survive the next cold morning.",
      },
      {
        key: 'divine',
        title: 'The Divine Image',
        intro:
          'A hymn to Mercy, Pity, Peace, and Love, and to where they actually live. Blake finds the divine nowhere but in the human form.',
      },
      {
        key: 'infantjoy',
        title: 'Infant Joy',
        intro:
          'A two-day-old child names itself Joy. Twelve lines, and one of the gentlest poems in the language.',
      },
    ],
  },
  {
    id: 'experience',
    title: 'From Songs of Experience (1794)',
    framing:
      'Five years later Blake bound Innocence together with its contrary: the same world seen with open eyes. The combined book carries his own subtitle, shewing the two contrary states of the human soul. Several poems answer an Innocence poem by name.',
    poems: [
      {
        key: 'tyger',
        title: 'The Tyger',
        intro:
          'The most famous question in English poetry: what kind of maker makes both the lamb and this? Blake asks it fourteen ways and never answers.',
      },
      {
        key: 'london',
        title: 'London',
        intro:
          'A walk through the city, reading marks of weakness and woe in every face. The church, the palace, and the marriage hearse each take a wound.',
      },
      {
        key: 'sickrose',
        title: 'The Sick Rose',
        intro:
          'Eight lines, one image, no explanation. Whatever the invisible worm is in your life, the poem already knows about it.',
      },
      {
        key: 'poisontree',
        title: 'A Poison Tree',
        intro:
          'What happens to anger you do not speak. It gets watered, it grows, it bears bright fruit, and somebody eats it.',
      },
      {
        key: 'clodpebble',
        title: 'The Clod and the Pebble',
        intro:
          'Two definitions of love, from a trodden clod of clay and a hard little pebble. Blake lets both stand and takes no side.',
      },
      {
        key: 'gardenlove',
        title: 'The Garden of Love',
        intro:
          'The speaker returns to the green where he used to play and finds a chapel built on it, with a prohibition written over the door. This edition opens the poem with two stanzas Blake left in his notebook.',
      },
      {
        key: 'chimneye',
        title: 'The Chimney Sweeper',
        intro:
          'The Innocence poem of the same name, seen without the dream. The parents are at church, praising a God the child says is made of their misery.',
      },
    ],
  },
];

const blake = {
  '@type': 'Person',
  '@id': `${PAGE_URL}#person`,
  name: 'William Blake',
  birthDate: '1757-11-28',
  deathDate: '1827-08-12',
  birthPlace: 'London',
  sameAs: ['https://en.wikipedia.org/wiki/William_Blake', 'https://www.wikidata.org/wiki/Q41513'],
};
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: metaTitle,
    url: PAGE_URL,
    about: blake,
    inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', name: 'Agora Cosmica', url: SITE_URL },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: GROUPS.flatMap(g => g.poems).map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: { '@type': 'CreativeWork', name: p.title, inLanguage: 'en', author: blake },
      })),
    },
  },
  breadcrumbSchema([
    { name: 'Home', url: `${SITE_URL}/` },
    { name: 'Figures', url: `${SITE_URL}/figures/` },
    { name: 'William Blake', url: `${SITE_URL}/figures/william-blake/` },
    { name: 'Poems', url: PAGE_URL },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What are Songs of Innocence and of Experience?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Two sets of poems William Blake engraved, printed, and colored himself: Songs of Innocence in 1789 and Songs of Experience in 1794, then bound as one book showing, in his phrase, the two contrary states of the human soul. Many poems in one half answer a poem in the other.',
        },
      },
      {
        '@type': 'Question',
        name: 'Why do The Lamb and The Tyger belong together?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'The Lamb, from Innocence, asks who made the gentlest of creatures and answers confidently. The Tyger, from Experience, asks whether the same maker framed the most fearsome one, and never answers. Read together they are one question about creation seen from its two sides.',
        },
      },
    ],
  },
];
---
<Public
  title={metaTitle}
  fullTitle={metaTitle}
  ogTitle={`${metaTitle} | Agora Cosmica`}
  description={metaDescription}
  canonicalPath={PAGE_PATH}
  lang={lang}
  ogType="article"
  ogImage={figureImage('blake', 'main', 1200)}
  ogImageAlt="AI-generated portrait: William Blake"
  noHreflang={true}
  stickyCta={false}
  schemas={schemas}
>
  <EssayStyles />
  <div class="pub-content esy">
    <Breadcrumbs
      lang={lang}
      items={[
        { label: 'Figures', path: '/figures' },
        { label: 'William Blake', path: '/figures/william-blake' },
        { label: 'Poems' },
      ]}
    />

    <header class="esy-hero">
      <p class="esy-hero__eyebrow">In his own words</p>
      <h1 class="esy-hero__title">William Blake</h1>
      <p class="esy-hero__lead">
        1757-1827 · London. Engraver, painter, and poet, ignored in his own
        lifetime and unlike anyone before or since. He wrote his poems, etched
        them into copper with his own illustrations, printed them, and colored
        them by hand, book by book. Here are twelve from his two contrary
        collections, the trusting songs of 1789 and the open-eyed ones of 1794,
        each with a line of introduction to hand you the door.
      </p>
    </header>

    {GROUPS.map((group, gi) => (
      <section class="esy-section" id={group.id}>
        <h2 class="esy-h2">{group.title}</h2>
        <p class="esy-p">{group.framing}</p>
        <div class="esy-poemlist">
          {group.poems.map((p, i) => (
            <details class="esy-poem" open={gi === 0 && i === 0}>
              <summary class="esy-poem__summary">{p.title}</summary>
              <p class="esy-poem__intro">{p.intro}</p>
              <div class="esy-poem__text">{POEMS[p.key].text.split('\n\n').map(stanza => (<div class="esy-poem__stanza">{stanza.split('\n').map(line => (<span class="esy-poem__line">{line}</span>))}</div>))}</div>
            </details>
          ))}
        </div>
      </section>
    ))}

    <EssayInvite
      lang={lang}
      line="You have just read Blake in his own words. On Agora Cosmica you can hear his life told in chapters, sit with the ideas behind the poems, and talk them through with his Echo, an AI voice grounded in his real work. An interpretation, never the man himself."
      href="/app?figure=william-blake&lang=en"
      buttonLabel="Learn from his Echo"
      figureId="blake"
      portraitAlt="AI-generated portrait of William Blake"
      moreLinks={[
        { label: 'William Blake, the figure', href: '/figures/william-blake/' },
        { label: 'Where do ideas come from?', href: '/themes/mind-creativity/' },
        { label: "Emily Dickinson's poems", href: '/figures/emily-dickinson/poems/' },
      ]}
    />

    <footer class="esy-sources">
      <p>
        The poems are in the public domain. The texts here follow Poems of
        William Blake, Project Gutenberg ebook 574, reproduced verbatim,
        punctuation included. That late 19th century text keeps the famous
        Tyger spelling while smoothing some others, so a few lines read
        slightly differently than in Blake's original etched plates. Songs of
        Innocence first appeared in 1789, Songs of Experience in 1794,
        combined by Blake into one book whose title page promises to show the
        two contrary states of the human soul. The introductions and
        groupings are ours.
      </p>
    </footer>
  </div>
</Public>
