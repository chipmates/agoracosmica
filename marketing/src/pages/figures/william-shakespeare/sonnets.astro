---
// Shakespeare: eight sonnets, each with a one-breath introduction. The texts
// are public domain and are inserted verbatim, by script, from Shakespeare's
// Sonnets, Project Gutenberg ebook 1041 (modern-spelling text of the 1609
// Quarto, contractions like ow'st kept). Quoted primary source: original
// punctuation stands.
// English single page without a DE twin: hreflang points at itself (the
// validate-seo allowlist is a shared file this build does not touch).

import Public from '../../../layouts/Public.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import EssayStyles from '../../../components/EssayStyles.astro';
import EssayInvite from '../../../components/EssayInvite.astro';
import { figureImage } from '../../../lib/figureImages';
import { breadcrumbSchema } from '../../../lib/schemas';
import { canonicalUrl, SITE_URL } from '../../../lib/urls';
import { shakespearePoems as POEMS, shakespeareSonnets as SONNETS } from '../../../data/poems/shakespeare.mjs';
import { poemsByPoet } from '../../../data/poems/index.mjs';

const lang = 'en' as const;
const PAGE_PATH = '/figures/william-shakespeare/sonnets';
const PAGE_URL = canonicalUrl(PAGE_PATH);

const metaTitle = "Shakespeare's Sonnets: Eight Worth Knowing by Heart";
const metaDescription =
  "Eight of Shakespeare's sonnets with short introductions: 18, 29, 30, 60, 65, 73, 116, 130. What each one says, and why they still land after 400 years.";

// The texts and the eight sonnets' own data live in the data module, one copy
// shared with the page each sonnet has of its own, which is also where each
// sonnet's own URL comes from.
const OWN_PAGE: Record<string, string> = Object.fromEntries(
  poemsByPoet('shakespeare').map((poem) => [poem.key, poem.path]),
);

const shakespeare = {
  '@type': 'Person',
  '@id': `${PAGE_URL}#person`,
  name: 'William Shakespeare',
  birthDate: '1564-04',
  deathDate: '1616-04-23',
  birthPlace: 'Stratford-upon-Avon',
  sameAs: [
    'https://en.wikipedia.org/wiki/William_Shakespeare',
    'https://www.wikidata.org/wiki/Q692',
  ],
};
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: metaTitle,
    url: PAGE_URL,
    about: shakespeare,
    inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', name: 'Agora Cosmica', url: SITE_URL },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: SONNETS.map((s, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'CreativeWork',
          name: `Sonnet ${s.num}: ${s.firstLine}`,
          inLanguage: 'en',
          author: shakespeare,
        },
      })),
    },
  },
  breadcrumbSchema([
    { name: 'Home', url: `${SITE_URL}/` },
    { name: 'Figures', url: `${SITE_URL}/figures/` },
    { name: 'William Shakespeare', url: `${SITE_URL}/figures/william-shakespeare/` },
    { name: 'Sonnets', url: PAGE_URL },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'How many sonnets did Shakespeare write?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'The 1609 Quarto prints 154. Most of the first 126 address a young man, most of the rest a dark-haired woman. Who either of them was, nobody knows, and four centuries of guessing have not settled it.',
        },
      },
      {
        '@type': 'Question',
        name: 'What form is a Shakespearean sonnet?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Fourteen lines of iambic pentameter: three quatrains rhymed abab cdcd efef, then a closing couplet rhymed gg. The couplet typically turns, answers, or undercuts everything before it.',
        },
      },
    ],
  },
];
---
<Public
  title={metaTitle}
  fullTitle={metaTitle}
  ogTitle={`${metaTitle} | Agora Cosmica`}
  description={metaDescription}
  canonicalPath={PAGE_PATH}
  lang={lang}
  ogType="article"
  ogImage={figureImage('shakespeare', 'main', 1200)}
  ogImageAlt="AI-generated portrait: William Shakespeare"
  noHreflang={true}
  stickyCta={false}
  schemas={schemas}
>
  <EssayStyles />
  <div class="pub-content esy">
    <Breadcrumbs
      lang={lang}
      items={[
        { label: 'Figures', path: '/figures' },
        { label: 'William Shakespeare', path: '/figures/william-shakespeare' },
        { label: 'Sonnets' },
      ]}
    />

    <header class="esy-hero">
      <p class="esy-hero__eyebrow">In his own words</p>
      <h1 class="esy-hero__title">William Shakespeare</h1>
      <p class="esy-hero__lead">
        1564-1616 · Stratford and London. Alongside the plays, Shakespeare
        wrote 154 sonnets, first printed together in 1609: fourteen lines
        each, three quatrains and a closing couplet that turns the whole poem.
        Most address a young man he loves, many of the rest a dark-haired
        woman, and nobody knows who either was. Here are eight worth carrying
        around, each with a line of introduction to hand you the door.
      </p>
    </header>

    <section class="esy-section">
      <h2 class="esy-h2">Eight sonnets, read closely</h2>
      <p class="esy-p">
        The running argument of the sequence is a fight with time: it ruins
        summers, faces, and empires, and verse is the only weapon that has ever
        won a round. These eight give you that fight, two low moments and their
        recoveries, and the two most quoted definitions of love in English.
      </p>
      <div class="esy-poemlist">
        {SONNETS.map((s, i) => (
          <details class="esy-poem" open={i === 0}>
            <summary class="esy-poem__summary">{s.num} · {s.firstLine}</summary>
            <p class="esy-poem__intro">{s.intro}</p>
            <div class="esy-poem__text">{POEMS[s.key].text.split('\n\n').map(stanza => (<div class="esy-poem__stanza">{stanza.split('\n').map(line => (<span class="esy-poem__line">{line}</span>))}</div>))}</div>
            <p class="esy-poem__own">
              <a class="pub-textlink" href={OWN_PAGE[s.key]}>Open this sonnet on its own page</a>
            </p>
          </details>
        ))}
      </div>
    </section>

    <EssayInvite
      lang={lang}
      line="You have just read Shakespeare in his own words. On Agora Cosmica you can hear his life told in chapters, sit with the ideas under the sonnets, and talk them through with his Echo, an AI voice grounded in his real work. An interpretation, never the man himself."
      href="/app?figure=william-shakespeare&lang=en"
      buttonLabel="Learn from his Echo"
      figureId="shakespeare"
      portraitAlt="AI-generated portrait of William Shakespeare"
      moreLinks={[
        { label: 'William Shakespeare, the figure', href: '/figures/william-shakespeare/' },
        { label: 'What is love, really?', href: '/themes/love-connection/' },
        { label: "William Blake's poems", href: '/figures/william-blake/poems/' },
      ]}
    />

    <footer class="esy-sources">
      <p>
        The sonnets are in the public domain. The texts here follow
        Shakespeare's Sonnets, Project Gutenberg ebook 1041, a modern-spelling
        text of the 1609 Quarto, reproduced verbatim including its punctuation
        and contractions. The numbering is the Quarto's. The introductions are
        ours.
      </p>
    </footer>
  </div>
</Public>

<style is:global>
  /* The one line this page adds to the shared poem layer: the way out to the
     sonnet's own page. */
  .esy-poem__own {
    margin: 1.25rem 0 0;
    font-size: var(--text-sm);
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
  }
</style>
