# Security headers for Cloudflare Pages
#
# The script-src sha256 list is derived, not authored. Astro generates it into
# each page's meta CSP from the scripts it inlined; this header CSP AND-enforces
# with that meta tag, so both lists have to carry every hash. Regenerate with
# `node scripts/check-csp.mjs --write` from client/ instead of editing by hand.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(self), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-BF0290pkb3jxQsE7z00xR8Imp8X34FLC88L0lkMnrGw=' 'sha256-QzWFZi+FLIx23tnm9SBU4aEgx4x8DsuASP07mfqol/c=' 'sha256-0chmwFk0zaA528yFfGV7J9ppIpdfTPPULncDF3WG7Zs=' 'sha256-eIXWvAmxkr251LJZkjniEK5LcPF3NkapbJepohwYRIc=' 'sha256-Q2BPg90ZMplYY+FSdApNErhpWafg2hcRRbndmvxuL/Q=' 'sha256-SHXg3YtOAVshUMT3f+eElYDgbV0kaujWj8DSaXSS4Vs=' 'sha256-Ya0pUYrC7nM5Cn/056TyVuEiz6dFGrzmkWzgON0pF0U=' 'sha256-WWc8Xxb9H86EKQZKEMaHKe7eUqx466dVQn9vylcPh4s=' https://challenges.cloudflare.com 'sha256-i/ofomzmMjJLegES6OLDsJfA4wJAI3UQ8UCNyC3zlcY=' 'sha256-A8NUHhsua1tqctjSRQ8Dm0bH3kI2fxxxBOPUfC7yDCM='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.agoracosmica.org; font-src 'self'; connect-src 'self' blob: https://openrouter.ai https://*.agoracosmica.org wss://*.agoracosmica.org http://localhost:* http://127.0.0.1:*; media-src 'self' blob: https://*.agoracosmica.org http://localhost:* http://127.0.0.1:*; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

# Immutable cache for hashed assets (Vite adds content hash to filenames)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Keep the React app (served from the SPA shell at /app) out of search indexes.
# The marketing landing at / and all static Astro pages stay indexable. The /*
# security headers above still apply to these paths (CF Pages merges matching
# rules), so CSP/HSTS are unaffected. Robots.txt stays free of a /app Disallow
# so crawlers can still fetch /app and see this noindex directive.
/app
  X-Robots-Tag: noindex, follow

/app/*
  X-Robots-Tag: noindex, follow
