{
  "schema_version": "1.0",
  "provenance": {
    "scope": "A name for every part of every machine, so a tap on the model names the part it lands on and not only a part a step speaks of. Keyed by machine slug and by the part id the machine's own record gives it.",
    "rule": "Each name is the plain word for the part as the machine's record describes it: its material and role in the dossier, the part notes, the mechanism section and the steps. Repeated parts share one name. A body built outside its record keeps these ids, and the vitrine maps them onto its own node names.",
    "prepared": "2026-09-17"
  },
